{
  "name": "seo-intelligence-platform",
  "version": "1.0.0",
  "description": "SEO Intelligence Platform powered by Trigger.dev for automated content analysis and optimization",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "npm run clean && tsc",
    "clean": "rm -rf dist",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "trigger:dev": "npx trigger.dev@latest dev",
    "trigger:deploy": "npx trigger.dev@latest deploy",
    "trigger:whoami": "npx trigger.dev@latest whoami",
    "scrape:test": "tsx scripts/test-scraping.ts",
    "content:generate": "tsx scripts/generate-content.ts",
    "seo:audit": "tsx scripts/seo-audit.ts",
    "metrics:collect": "tsx scripts/collect-metrics.ts"
  },
  "keywords": [
    "seo",
    "content-intelligence",
    "automation",
    "trigger.dev",
    "scraping",
    "analytics"
  ],
  "author": "SEO Platform Team",
  "license": "MIT",
  "dependencies": {
    "@trigger.dev/sdk": "^3.3.4",
    "@anthropic-ai/sdk": "^0.67.0",
    "@types/node": "^20.10.0",
    "axios": "^1.6.0",
    "cheerio": "^1.0.0-rc.12",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "firecrawl-js": "^0.2.5",
    "ioredis": "^5.3.2",
    "lodash": "^4.17.21",
    "openai": "^4.20.1",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cheerio": "^0.22.35",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/lodash": "^4.14.202",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "tsx": "^4.6.0",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "trigger.dev": {
    "endpoint": "ws://localhost:8889",
    "packageManager": "npm"
  }
}
