#!/bin/bash
# Linux Native Build Configuration
# High-performance Docker builds using Linux native storage

# Source paths (auto-detect current directory or use default)
if [[ -n "${WINDOWS_PATH:-}" ]]; then
    # Use provided WINDOWS_PATH (if explicitly set)
    :
elif [[ "$(pwd)" =~ ^/mnt/c ]]; then
    # Running from Windows mount - use current directory
    WINDOWS_PATH="$(pwd)"
else
    # Running from Linux native - use current directory
    WINDOWS_PATH="$(pwd)"
fi

# Target paths (Linux native storage - fast I/O)
LINUX_PATH="/tmp/cfn-build"

# Docker image configuration
# Support TAG format from docker-build skill (name:tag) or separate NAME/TAG
if [[ -n "${TAG:-}" ]]; then
    # TAG format: "image-name:tag"
    IMAGE_NAME="${TAG%%:*}"
    IMAGE_TAG="${TAG##*:}"
    # If no colon, default tag to latest
    if [[ "$IMAGE_NAME" == "$IMAGE_TAG" ]]; then
        IMAGE_TAG="latest"
    fi
else
    IMAGE_NAME="${IMAGE_NAME:-claude-flow-novice-agent}"
    IMAGE_TAG="${IMAGE_TAG:-latest}"
fi

DOCKERFILE="${DOCKERFILE:-Dockerfile.agent}"

# Rsync configuration
# Exclude patterns matching .dockerignore + build artifacts
RSYNC_EXCLUDES=(
    # Version control
    ".git"
    ".github"

    # IDE files
    ".vscode"
    ".idea"
    "*.swp"
    "*.swo"
    "*~"

    # Node artifacts
    "node_modules"
    "npm-debug.log"
    "yarn-error.log"
    "*.tsbuildinfo"

    # Test files (not needed in production)
    "tests"
    "*.test.ts"
    "*.test.js"
    "*.spec.ts"
    "*.spec.js"
    "__tests__"

    # Build artifacts (will be synced if present)
    # "dist" - KEEP: Using prebuilt dist/ for production

    # Documentation (not needed for build)
    "docs"

    # Environment files (sensitive)
    ".env"
    ".env.local"
    ".env.*.local"

    # Logs
    "logs"
    "*.log"
    ".logs"

    # Temporary files
    "tmp"
    "temp"
    "*.tmp"
    ".artifacts"
    ".backups"
    ".screenshots"

    # CI/CD
    ".circleci"
    ".travis.yml"

    # OS files
    ".DS_Store"
    "Thumbs.db"

    # Coverage
    "coverage"
    ".nyc_output"

    # Misc
    ".swarm"
    ".playwright-mcp"

    # Docker context (recursive build)
    "*.tar"
    "*.tar.gz"
    "*.tgz"
    "*.xz"

    # Project-specific exclusions
    "legacy"          # Old code (313MB)
    "planning"        # Planning docs (13MB)
    "packages"        # Package archives (7.9MB)
    "shellcheck-v0.8.0"  # External tools (6.5MB)
    "readme"          # README assets (not needed for build)
)

# Build options
BUILD_NO_CACHE=false
BUILD_QUIET=false
BUILD_PROGRESS="auto"  # Options: auto, plain, tty

# Performance tuning
RSYNC_THREADS=4
DOCKER_BUILDKIT=1
