{
  "compilerOptions": {
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "module": "commonjs",
    "target": "es2020"
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "legacy",
    "packages",
    "examples",
    "tests",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/__tests__",
    "**/__mocks__"
  ]
}