#!/usr/bin/env node
/**
 * ace-query - Query bullets from adaptive context
 * Usage: ace-query [--category=CATEGORY] [--tags=tag1,tag2] [--min-confidence=0.7] [--limit=15]
 */

const { ACESystem } = require('../src/ace');
const path = require('path');

async function main() {
  const args = process.argv.slice(2);

  const options = {
    category: null,
    tags: null,
    minConfidence: 0.7,
    limit: 15
  };

  args.forEach(arg => {
    if (arg.startsWith('--category=')) {
      options.category = arg.split('=')[1];
    } else if (arg.startsWith('--tags=')) {
      options.tags = arg.split('=')[1].split(',');
    } else if (arg.startsWith('--min-confidence=')) {
      options.minConfidence = parseFloat(arg.split('=')[1]);
    } else if (arg.startsWith('--limit=')) {
      options.limit = parseInt(arg.split('=')[1]);
    }
  });

  const ace = new ACESystem({
    dbPath: path.join(process.cwd(), '.artifacts/database/swarm-memory.db')
  });
  await ace.initialize();

  try {
    console.log(`🔍 Querying adaptive context...`);

    const bullets = await ace.query(options);

    console.log(`\n✅ Found ${bullets.length} bullets:\n`);

    bullets.forEach((bullet, i) => {
      const confidence = (bullet.confidence_score * 100).toFixed(0);
      const helpful = bullet.helpful_count || 0;
      const harmful = bullet.harmful_count || 0;

      console.log(`${i + 1}. [${bullet.category}] ${confidence}% confidence`);
      console.log(`   ${bullet.content}`);
      console.log(`   📊 Helpful: ${helpful} | Harmful: ${harmful} | Priority: ${bullet.priority}`);

      if (bullet.tags) {
        const tags = JSON.parse(bullet.tags);
        console.log(`   🏷️  Tags: ${tags.join(', ')}`);
      }
      console.log('');
    });

    if (bullets.length === 0) {
      console.log('No bullets found matching criteria.');
      console.log('Try adjusting --category, --tags, or --min-confidence');
    }
  } catch (error) {
    console.error('❌ Error:', error.message);
    process.exit(1);
  } finally {
    await ace.close();
  }
}

main();
