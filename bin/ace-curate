#!/usr/bin/env node
/**
 * ace-curate - Merge reflections into adaptive context
 * Usage: ace-curate --reflection-id=ID [--similarity=0.85]
 */

const { ACESystem } = require('../src/ace');
const path = require('path');

async function main() {
  const args = process.argv.slice(2);

  const options = {
    reflectionId: null,
    similarityThreshold: 0.85
  };

  args.forEach(arg => {
    if (arg.startsWith('--reflection-id=')) {
      options.reflectionId = arg.split('=')[1];
    } else if (arg.startsWith('--similarity=')) {
      options.similarityThreshold = parseFloat(arg.split('=')[1]);
    }
  });

  if (!options.reflectionId) {
    console.error('Error: --reflection-id is required');
    console.log('Usage: ace-curate --reflection-id=ID [--similarity=0.85]');
    process.exit(1);
  }

  const ace = new ACESystem({
    dbPath: path.join(process.cwd(), '.artifacts/database/swarm-memory.db')
  });
  await ace.initialize();

  try {
    console.log(`🔄 Curating reflection: ${options.reflectionId}`);
    console.log(`📊 Similarity threshold: ${options.similarityThreshold}`);

    const result = await ace.curate({
      reflectionId: options.reflectionId,
      similarityThreshold: options.similarityThreshold
    });

    console.log(`\n✅ Curation complete:`);
    console.log(`   New bullets: ${result.newBullets}`);
    console.log(`   Incremented: ${result.incrementedBullets}`);
    console.log(`   Total merged: ${result.mergedBullets}`);

    console.log(`\n📋 Decisions:`);
    result.decisions.forEach((decision, i) => {
      console.log(`${i + 1}. ${decision.action.toUpperCase()} - ${decision.bulletId}`);
      console.log(`   Similarity: ${decision.similarity.toFixed(2)}`);
      console.log(`   Rationale: ${decision.rationale}`);
    });
  } catch (error) {
    console.error('❌ Error:', error.message);
    process.exit(1);
  } finally {
    await ace.close();
  }
}

main();
