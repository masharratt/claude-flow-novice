# Docker Agent POC - Environment Variables Example
# Copy this file to .env.poc and fill in your actual values
# NEVER commit the actual .env.poc file with real credentials

# Z.ai API Key (required for agent execution)
# Get your key from Z.ai dashboard
# This provides 95-98% cost savings vs Anthropic API
ZAI_API_KEY=your-zai-api-key-here

# Z.ai Base URL (Anthropic-compatible endpoint)
ZAI_BASE_URL=https://api.z.ai/api/anthropic

# API Provider (set to "zai" for Z.ai routing)
CLAUDE_API_PROVIDER=zai

# Redis Configuration (default: host Redis)
REDIS_HOST=localhost
REDIS_PORT=6379

# Node Environment
NODE_ENV=production

# Optional: Custom routing configuration (already using Z.ai)
# Note: Z.ai routing is enabled by default in this POC
USE_CUSTOM_ROUTING=true

# Optional: Agent execution timeout (seconds)
AGENT_TIMEOUT=120

# Optional: Log level (debug, info, warn, error)
LOG_LEVEL=info

# Docker-specific settings
DOCKER_IMAGE_NAME=cfn-agent-poc
DOCKER_IMAGE_TAG=latest
DOCKER_CONTAINER_NAME_PREFIX=cfn-agent-test

# Test configuration
TEST_TASK_ID_PREFIX=docker-test
TEST_AGENT_TYPE=test-docker-agent
