#!/usr/bin/env node
/**
 * ace-inject - Inject context bullets into agent instructions
 * Usage: ace-inject --agent-type=coder [--phase=auth] [--limit=15]
 */

const { ACESystem } = require('../src/ace');
const path = require('path');

async function main() {
  const args = process.argv.slice(2);

  const options = {
    agentType: 'coder',
    phase: null,
    limit: 15
  };

  args.forEach(arg => {
    if (arg.startsWith('--agent-type=')) {
      options.agentType = arg.split('=')[1];
    } else if (arg.startsWith('--phase=')) {
      options.phase = arg.split('=')[1];
    } else if (arg.startsWith('--limit=')) {
      options.limit = parseInt(arg.split('=')[1]);
    }
  });

  const ace = new ACESystem({
    dbPath: path.join(process.cwd(), '.artifacts/database/swarm-memory.db')
  });
  await ace.initialize();

  try {
    console.log(`💉 Injecting context for agent type: ${options.agentType}`);
    if (options.phase) {
      console.log(`📍 Phase: ${options.phase}`);
    }

    const context = await ace.inject(options);

    console.log(`\n${context}`);
  } catch (error) {
    console.error('❌ Error:', error.message);
    process.exit(1);
  } finally {
    await ace.close();
  }
}

main();
