# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Redis Sentinel Configuration (optional)
# REDIS_SENTINELS=sentinel1:26379,sentinel2:26379,sentinel3:26379
# REDIS_SENTINEL_PASSWORD=
# REDIS_SENTINEL_NAME=mymaster

# Redis Cluster Configuration (optional)
# REDIS_CLUSTER_NODES=node1:6379,node2:6379,node3:6379

# Performance Settings
PERFORMANCE_RETENTION_DAYS=30
ALERT_RESPONSE_TIME=1000
ALERT_ERROR_RATE=0.05
ALERT_MEMORY_USAGE=0.8
ALERT_CONFIDENCE=0.3

# Batch Processing
PERFORMANCE_BATCH_SIZE=1000
PERFORMANCE_BATCH_INTERVAL=5000

# Metrics Collection
COLLECT_DETAILED_METRICS=true
COLLECT_COLLABORATION_METRICS=true
COLLECT_SYSTEM_METRICS=true

# Anomaly Detection
ANOMALY_DETECTION_ENABLED=true
ANOMALY_Z_SCORE_THRESHOLD=2.0
ANOMALY_MIN_DATA_POINTS=10
ANOMALY_ML_ENABLED=false
ANOMALY_ALERT_COOLDOWN=300000
ANOMALY_MAX_ALERTS_PER_HOUR=10

# Dashboard Configuration
DASHBOARD_ENABLED=true
DASHBOARD_REFRESH_INTERVAL=30000
DASHBOARD_MAX_DATA_POINTS=1000
DASHBOARD_MAX_AGENTS=50
MAX_EXPORT_RECORDS=10000

# API Configuration
API_RATE_WINDOW=900000
API_RATE_MAX=100
API_CORS_ORIGIN=*
API_CORS_CREDENTIALS=false
API_DEFAULT_PAGE_SIZE=50
API_MAX_PAGE_SIZE=1000

# Monitoring
MONITORING_ENABLED=true
HEALTH_CHECK_INTERVAL=60000
COLLECT_REDIS_METRICS=true
PERFORMANCE_LOG_LEVEL=info
LOG_SLOW_QUERIES=false
SLOW_QUERY_THRESHOLD=1000

# Security
PERFORMANCE_AUTH_REQUIRED=false
PERFORMANCE_AUTH_SECRET=your-secret-key-here
PERFORMANCE_API_KEY_REQUIRED=false
PERFORMANCE_API_KEYS=key1,key2,key3
PERFORMANCE_IP_WHITELIST=127.0.0.1,::1

# Feature Flags
FEATURE_REAL_TIME_ALERTS=true
FEATURE_PREDICTIVE_ANALYTICS=false
FEATURE_COLLABORATION_TRACKING=true
FEATURE_PERFORMANCE_SCORING=true
FEATURE_AUTOMATED_REPORTS=false
FEATURE_ML_ANOMALY_DETECTION=false
FEATURE_PERFORMANCE_FORECASTING=false

# Development Settings
DEBUG_QUERIES=false
USE_MOCK_PERFORMANCE_DATA=false
TEST_REDIS_DB=15

# Optimization
ENABLE_PERFORMANCE_CACHE=true
PERFORMANCE_CACHE_TTL=300
REDIS_POOL_SIZE=10
COMPRESS_PERFORMANCE_DATA=false
COMPRESSION_THRESHOLD=1024

# Integrations
# Prometheus
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090
PROMETHEUS_ENDPOINT=/metrics

# ELK Stack
ELK_ENABLED=false
ELK_HOST=localhost
ELK_PORT=9200
ELK_INDEX=performance-metrics

# Slack Notifications
SLACK_ENABLED=false
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
SLACK_CHANNEL=#performance-alerts

# Email Notifications
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@yourcompany.com
EMAIL_TO=admin@yourcompany.com,ops@yourcompany.com