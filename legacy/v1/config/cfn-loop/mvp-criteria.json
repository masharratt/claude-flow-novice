{
  "name": "MVP Mode Criteria",
  "description": "Speed-focused quality criteria for MVP development",
  "mode": "mvp",
  "thresholds": {
    "gateThreshold": 0.70,
    "consensusThreshold": 0.80,
    "testCoverage": 0.70
  },
  "qualityCriteria": {
    "codeQuality": {
      "required": [
        "Core functionality works",
        "Basic error handling",
        "Critical bugs fixed"
      ],
      "optional": [
        "Comprehensive error handling",
        "Refactored architecture",
        "Optimized performance"
      ],
      "deferred": [
        "Complete inline documentation",
        "Architectural refactoring",
        "Performance optimization"
      ]
    },
    "testing": {
      "required": [
        "Core paths tested (>70% coverage)",
        "Critical edge cases covered",
        "Integration tests for main flows"
      ],
      "optional": [
        "90% test coverage",
        "Comprehensive edge case testing",
        "Property-based testing"
      ],
      "deferred": [
        "100% test coverage",
        "Load testing",
        "Chaos engineering tests"
      ]
    },
    "security": {
      "required": [
        "Basic input validation",
        "Authentication implemented",
        "Critical vulnerabilities fixed"
      ],
      "optional": [
        "Comprehensive input sanitization",
        "Rate limiting",
        "CSRF protection"
      ],
      "deferred": [
        "Security audit",
        "Penetration testing",
        "Compliance certification"
      ]
    },
    "documentation": {
      "required": [
        "README with setup instructions",
        "Basic API documentation",
        "Known limitations documented"
      ],
      "optional": [
        "Comprehensive API docs",
        "Architecture diagrams",
        "Runbook for operations"
      ],
      "deferred": [
        "Complete user guide",
        "Video tutorials",
        "Interactive documentation"
      ]
    },
    "performance": {
      "required": [
        "Basic functionality works",
        "No critical performance bugs"
      ],
      "optional": [
        "Performance benchmarks",
        "Optimized hot paths"
      ],
      "deferred": [
        "Load testing",
        "Performance SLAs",
        "Scalability testing"
      ]
    },
    "accessibility": {
      "required": [],
      "optional": [
        "Basic keyboard navigation",
        "Screen reader compatible"
      ],
      "deferred": [
        "WCAG 2.1 AA compliance",
        "Full accessibility audit",
        "Assistive technology testing"
      ]
    }
  },
  "skipValidations": [
    "accessibility",
    "performance-benchmarks",
    "comprehensive-docs",
    "load-testing",
    "security-audit"
  ],
  "tradeoffs": {
    "acceptable": [
      "Technical debt for speed",
      "Basic architecture over perfect design",
      "Single-instance deployment",
      "Manual operations workflows"
    ],
    "notAcceptable": [
      "Critical security vulnerabilities",
      "Data loss or corruption",
      "Complete lack of tests",
      "Broken core functionality"
    ]
  },
  "decisionGuidelines": {
    "PROCEED": "Core functionality works, basic tests pass, critical bugs fixed. Ready to ship MVP.",
    "DEFER": "Core functionality works but minor issues exist. Ship now, improve later. Technical debt acceptable.",
    "ESCALATE": "Core functionality broken or critical security issues. Not ready for MVP release."
  }
}
