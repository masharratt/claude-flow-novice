{
    "pre_edit_backup": {
        "enabled": true,
        "default_ttl": 86400,
        "retention_strategy": "oldest_first",
        "ignore_patterns": [
            "*.log",
            "*.tmp",
            ".backups/*"
        ]
    },
    "post_edit_validation": {
        "enabled": true,
        "checks": [
            "file_integrity",
            "pre_edit_backup_created"
        ]
    },
    "logging": {
        "enabled": true,
        "log_path": ".claude/logs/file_edit_hooks.log"
    }
}
