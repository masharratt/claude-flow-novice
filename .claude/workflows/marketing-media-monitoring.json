{
  "name": "Media Monitoring Workflow",
  "nodes": [
    {
      "parameters": {},
      "name": "Webhook",
      "type": "webhook",
      "position": [100, 300],
      "webhookId": "media-monitoring-trigger"
    },
    {
      "parameters": {
        "method": "POST",
        "path": "validate-request"
      },
      "name": "Request Validation",
      "type": "function",
      "position": [250, 300]
    },
    {
      "parameters": {
        "conditions": {
          "routing": [
            {
              "value": "SEARCH_MENTIONS",
              "output": "Search Brand Mentions"
            },
            {
              "value": "SENTIMENT_ANALYSIS",
              "output": "Sentiment Analysis"
            },
            {
              "value": "CREATE_CRISIS_ALERT",
              "output": "Create Crisis Alert"
            },
            {
              "value": "EXPORT_REPORT",
              "output": "Export Daily Report"
            }
          ]
        }
      },
      "name": "Monitoring Router",
      "type": "switch",
      "position": [400, 300]
    },
    {
      "parameters": {
        "url": "https://api.meltwater.com/v1/mentions/search",
        "method": "GET",
        "authentication": "predefinedCredentialType",
        "credentialsType": "meltwaterApi"
      },
      "name": "Search Brand Mentions",
      "type": "httpRequest",
      "position": [550, 200]
    },
    {
      "parameters": {
        "url": "https://api.brandwatch.com/v1/sentiment/analyze",
        "method": "POST",
        "authentication": "predefinedCredentialType",
        "credentialsType": "brandwatchApi"
      },
      "name": "Sentiment Analysis",
      "type": "httpRequest",
      "position": [550, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "path": "analyze-crisis-risk"
      },
      "name": "Create Crisis Alert",
      "type": "function",
      "position": [550, 400],
      "parameters": {
        "code": `
const CRISIS_THRESHOLD = 0.3; // 30% positive threshold
const NEGATIVE_THRESHOLD = 0.5; // 50% negative threshold

if (sentimentScore.positive < CRISIS_THRESHOLD || sentimentScore.negative > NEGATIVE_THRESHOLD) {
  // Trigger crisis alert
  return {
    severity: 'critical',
    latency: '15 minutes',
    responseSLA: '2 hours',
    triggerTime: new Date().toISOString()
  };
}
        `
      }
    },
    {
      "parameters": {
        "url": "https://api.mention.net/v1/reports/export",
        "method": "GET",
        "authentication": "predefinedCredentialType",
        "credentialsType": "mentionApi"
      },
      "name": "Export Daily Report",
      "type": "httpRequest",
      "position": [550, 500]
    },
    {
      "parameters": {
        "url": "https://news.google.com/rss/search",
        "method": "GET"
      },
      "name": "Google News API",
      "type": "httpRequest",
      "position": [700, 300]
    },
    {
      "parameters": {},
      "name": "Error Handling",
      "type": "errorTrigger",
      "position": [900, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Request Validation",
            "type": "main",
            "output": 0
          }
        ]
      ]
    },
    "Request Validation": {
      "main": [
        [
          {
            "node": "Monitoring Router",
            "type": "main",
            "output": 0
          }
        ]
      ]
    },
    "Monitoring Router": {
      "main": [
        [
          {
            "node": "Search Brand Mentions",
            "type": "main",
            "output": "SEARCH_MENTIONS"
          },
          {
            "node": "Sentiment Analysis",
            "type": "main",
            "output": "SENTIMENT_ANALYSIS"
          },
          {
            "node": "Create Crisis Alert",
            "type": "main",
            "output": "CREATE_CRISIS_ALERT"
          },
          {
            "node": "Export Daily Report",
            "type": "main",
            "output": "EXPORT_REPORT"
          }
        ]
      ]
    },
    "Search Brand Mentions": {
      "main": [
        [
          {
            "node": "Sentiment Analysis",
            "type": "main",
            "output": 0
          }
        ]
      ]
    },
    "Sentiment Analysis": {
      "main": [
        [
          {
            "node": "Create Crisis Alert",
            "type": "main",
            "output": 0
          }
        ]
      ]
    },
    "Create Crisis Alert": {
      "main": [
        [
          {
            "node": "Google News API",
            "type": "main",
            "output": 0
          }
        ]
      ]
    },
    "Google News API": {
      "main": [
        [
          {
            "node": "Export Daily Report",
            "type": "main",
            "output": 0
          }
        ]
      ]
    },
    "Export Daily Report": {
      "main": [
        [
          {
            "node": "Error Handling",
            "type": "main",
            "output": 1
          }
        ]
      ]
    },
    "Error Handling": {
      "main": [
        []
      ]
    }
  },
  "settings": {
    "errorWorkflow": "Error Handling",
    "saveManualExecutions": true,
    "webhookTimeout": 300
  }
}