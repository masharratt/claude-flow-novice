{
    "skill_name": "hybrid-routing",
    "version": "1.0.0",
    "routing_strategies": {
        "primary": {
            "type": "redis-pubsub",
            "priority": 1,
            "latency_threshold_ms": 50
        },
        "secondary": {
            "type": "websocket",
            "priority": 2,
            "latency_threshold_ms": 100
        }
    },
    "performance_targets": {
        "routing_accuracy": 0.85,
        "channel_transition_time_ms": 50,
        "packet_loss_percentage": 0.01
    },
    "security_configuration": {
        "encryption": "TLS_1_3",
        "authentication_method": "JWT",
        "rate_limit_per_second": 1000
    }
}