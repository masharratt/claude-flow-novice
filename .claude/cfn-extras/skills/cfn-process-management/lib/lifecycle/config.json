{
  "processTypes": {
    "EVENT_BUS": {
      "dependencies": [],
      "restartPolicy": "always",
      "description": "Manages event-driven communication"
    },
    "MEMORY_MANAGER": {
      "dependencies": ["EVENT_BUS"],
      "restartPolicy": "on-failure",
      "description": "Handles memory allocation and tracking"
    },
    "COORDINATOR": {
      "dependencies": ["EVENT_BUS", "MEMORY_MANAGER"],
      "restartPolicy": "always",
      "description": "System-wide coordination and orchestration"
    },
    "TERMINAL_POOL": {
      "dependencies": ["COORDINATOR"],
      "restartPolicy": "on-failure",
      "description": "Manages terminal session pools"
    },
    "MCP_SERVER": {
      "dependencies": ["COORDINATOR", "TERMINAL_POOL"],
      "restartPolicy": "always",
      "description": "Main control program server"
    },
    "ORCHESTRATOR": {
      "dependencies": ["EVENT_BUS", "MEMORY_MANAGER", "COORDINATOR"],
      "restartPolicy": "always",
      "description": "High-level workflow and task management"
    }
  },
  "monitoringConfig": {
    "pollingInterval": 30,
    "healthCheckTimeout": 10,
    "metricCollectionEnabled": true
  }
}
