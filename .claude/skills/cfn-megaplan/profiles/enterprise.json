    "data":        { "directive": "full", "condition": "db", "level": 4, "agent": "database-architect", "model": "opus", "extras": ["lifecycle", "concurrency", "multi_tenancy", "compliance", "retention"] },
    "arch":        { "directive": "full", "level": 5, "agent": "system-architect", "model": "opus", "extras": ["error_taxonomy"] },
    "ux":          { "directive": "full", "condition": "frontend", "level": 5, "agent": "ui-designer", "model": "opus" },
    "design":      { "directive": "full", "condition": "frontend", "level": 6, "agent": "ui-designer", "model": "opus", "extras": ["i18n", "a11y_full"] },
    "test_plan":   { "directive": "full", "level": 6, "agent": "tester", "model": "opus", "extras": ["integration", "contract", "mocking_strategy", "load", "soak", "nonfunctional", "concurrency", "adversarial_data", "viewport_matrix", "obs_verification", "migration_rehearsal"] },
