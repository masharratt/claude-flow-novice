    "test_plan":   { "directive": "light", "level": 6, "agent": "tester", "model": "sonnet", "drops": ["integration", "contract", "load", "soak", "mocking_strategy", "concurrency", "adversarial_data", "viewport_matrix", "obs_verification", "migration_rehearsal"] },
