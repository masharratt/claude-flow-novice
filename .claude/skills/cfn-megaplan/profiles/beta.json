{
  "tier": "beta",
  "version": "1.2.0",
  "description": "Alpha-ready: real users behind a feature flag, no on-call paging, no data loss. Adds observability, rollout, success metrics, full tests, concurrency, privacy.",
  "bars": { "verifiable_done": "full", "haiku_executable": "full" },
  "floor": ["rls", "auth_boundaries", "secrets_handling", "no_unscoped_delete", "pii_if_present"],
  "phases": {
    "research":    { "directive": "full", "condition": "unknowns", "level": 1, "agent": "researcher" },
    "spec":        { "directive": "full", "level": 2, "agent": "specification-agent" },
    "decide":      { "directive": "full", "level": 3, "agent": "general-purpose" },
    "pseudo":      { "directive": "full", "level": 3, "agent": "pseudocode" },
    "data":        { "directive": "full", "condition": "db", "level": 4, "agent": "database-architect", "extras": ["lifecycle", "concurrency"], "drops": ["multi_tenancy"] },
    "arch":        { "directive": "full", "level": 5, "agent": "system-architect", "extras": ["error_taxonomy"] },
    "ux":          { "directive": "full", "condition": "frontend", "level": 5, "agent": "ui-designer" },
    "design":      { "directive": "full", "condition": "frontend", "level": 6, "agent": "ui-designer", "drops": ["i18n"] },
    "test_plan":   { "directive": "full", "level": 6, "agent": "tester", "extras": ["integration", "contract", "mocking_strategy", "concurrency", "adversarial_data", "viewport_matrix", "obs_verification", "migration_rehearsal"], "drops": ["load", "soak"] },
    "ops":         { "directive": "full", "level": 6, "agent": "devops-engineer", "extras": ["observability", "rollout", "metrics", "rollback_rehearsal"], "drops": ["threat_full", "capacity_full", "runbook_full"] },
    "write_plan":  { "directive": "full", "level": 7, "extras": ["estimation_light", "risk_register_light"] },
    "plan_review": { "directive": "full", "level": 8, "extras": ["full_alpha_readiness"], "drops": ["plan_judge", "compliance"] }
  }
}
