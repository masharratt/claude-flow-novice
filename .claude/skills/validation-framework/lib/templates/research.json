{
  "domain": "research",
  "validation_criteria": {
    "critical": [
      "Research question clearly stated",
      "Methodology described and appropriate",
      "Sources cited with proper attribution",
      "Findings supported by evidence",
      "No fabricated or falsified data"
    ],
    "important": [
      "Sample size adequate for conclusions",
      "Statistical methods appropriate and correct",
      "Limitations acknowledged",
      "Reproducible methodology",
      "Peer-reviewed sources prioritized",
      "Bias assessed and addressed",
      "Ethical considerations addressed"
    ],
    "nice_to_have": [
      "Novel insights or contributions",
      "Comprehensive literature review",
      "Data visualizations clear and effective",
      "Future research directions suggested",
      "Practical implications discussed"
    ]
  },
  "success_metrics": {
    "gate_threshold": 0.75,
    "consensus_threshold": 0.90
  },
  "deliverable_requirements": [
    "Research report or paper",
    "Bibliography with cited sources",
    "Data analysis artifacts (if applicable)",
    "Methodology documentation"
  ]
}