;; ═══════════════════════════════════════════════════════════════════════════
;; AISP State Machine Contract Template v5.1
;; Usage: Define UI states, transitions, and navigation flows
;; ═══════════════════════════════════════════════════════════════════════════

𝔸5.1.epic-states@{{DATE}}
γ≔{{EPIC_ID}}.state.machine
ρ≔⟨states,transitions,guards,actions,evidence⟩
⊢ND∧Ambig<0.02

;; ─── Σ: STATE TYPES ───

⟦Σ:States⟧{
  ;; ┌─────────────────────────────────────────────────────────────┐
  ;; │ VIEW STATES                                                  │
  ;; │ All possible screens/views in the application                │
  ;; └─────────────────────────────────────────────────────────────┘

  ViewState≜⟨
    ;; Auth states
    Login|
    Register|
    ForgotPassword|
    ResetPassword|

    ;; Main states
    Dashboard|

    ;; Family states
    FamilyCreate|
    FamilyShowInvite|
    FamilyList|
    FamilyDetail|
    FamilySettings|
    FamilyJoin|
    FamilyMembers|

    ;; Story states
    StoryCreate|
    StoryView|
    StoryEdit|
    StoryList|

    ;; Settings states
    Settings|
    Profile|

    ;; Error states
    NotFound|
    ServerError|
    Maintenance
  ⟩

  ;; ┌─────────────────────────────────────────────────────────────┐
  ;; │ LOADING STATES                                               │
  ;; │ Async operation states for each view                         │
  ;; └─────────────────────────────────────────────────────────────┘

  LoadingState≜⟨
    idle|           ;; No operation in progress
    loading|        ;; Operation started, waiting for response
    success|        ;; Operation completed successfully
    error           ;; Operation failed
  ⟩

  ;; ┌─────────────────────────────────────────────────────────────┐
  ;; │ FORM STATES                                                  │
  ;; │ States for form-based views                                  │
  ;; └─────────────────────────────────────────────────────────────┘

  FormState≜⟨
    pristine|       ;; Form untouched
    dirty|          ;; Form has changes
    submitting|     ;; Form being submitted
    submitted|      ;; Form successfully submitted
    invalid         ;; Form has validation errors
  ⟩

  ;; ┌─────────────────────────────────────────────────────────────┐
  ;; │ AUTH STATE                                                   │
  ;; │ Current authentication status                                │
  ;; └─────────────────────────────────────────────────────────────┘

  AuthState≜⟨
    unknown|        ;; Initial state, checking auth
    authenticated|  ;; User is logged in
    unauthenticated ;; User is not logged in
  ⟩
}

;; ─── Σ: EVENT TYPES ───

⟦Σ:Events⟧{
  ;; ┌─────────────────────────────────────────────────────────────┐
  ;; │ USER EVENTS                                                  │
  ;; │ Actions triggered by user interaction                        │
  ;; └─────────────────────────────────────────────────────────────┘

  UserEvent≜⟨
    ;; Navigation events
    onClick(target:𝕊)|
    onNavigate(path:𝕊)|
    onBack|

    ;; Form events
    onSubmit|
    onChange(field:𝕊,value:Any)|
    onBlur(field:𝕊)|
    onReset|

    ;; Auth events
    onLogin|
    onLogout|
    onRegister|

    ;; Family events
    onCreateFamily|
    onJoinFamily(code:InviteCode)|
    onLeaveFamily|
    onInviteMember|
    onRemoveMember(userId:UUID)|

    ;; Story events
    onCreateStory|
    onEditStory|
    onDeleteStory|
    onShareStory
  ⟩

  ;; ┌─────────────────────────────────────────────────────────────┐
  ;; │ SYSTEM EVENTS                                                │
  ;; │ Events triggered by system/API responses                     │
  ;; └─────────────────────────────────────────────────────────────┘

  SystemEvent≜⟨
    onSuccess(data:Any)|
    onError(error:Error)|
    onTimeout|
    onAuthExpired|
    onNetworkOffline|
    onNetworkOnline
  ⟩
}

;; ─── Γ: TRANSITIONS ───

⟦Γ:Transitions⟧{
  ;; ┌─────────────────────────────────────────────────────────────┐
  ;; │ NAVIGATION FLOW: FAMILY CREATION                             │
  ;; │ Dashboard → Create → ShowInvite → List                       │
  ;; └─────────────────────────────────────────────────────────────┘

  ;; Start family creation from dashboard
  Dashboard→FamilyCreate:onClick("Create Family")

  ;; Successful creation shows invite code
  FamilyCreate→FamilyShowInvite:onSuccess(createFamily)

  ;; Validation error stays on create page
  FamilyCreate→FamilyCreate:onError(validation)

  ;; Done viewing invite goes to list
  FamilyShowInvite→FamilyList:onClick("Done")

  ;; Can copy and continue
  FamilyShowInvite→FamilyShowInvite:onClick("Copy Code")

  ;; ┌─────────────────────────────────────────────────────────────┐
  ;; │ NAVIGATION FLOW: FAMILY JOIN                                 │
  ;; │ Dashboard → Join → Success → Detail                          │
  ;; └─────────────────────────────────────────────────────────────┘

  Dashboard→FamilyJoin:onClick("Join Family")
  FamilyJoin→FamilyDetail:onSuccess(joinFamily)
  FamilyJoin→FamilyJoin:onError(INVALID_INVITE_CODE)

  ;; ┌─────────────────────────────────────────────────────────────┐
  ;; │ NAVIGATION FLOW: FAMILY MANAGEMENT                           │
  ;; └─────────────────────────────────────────────────────────────┘

  FamilyList→FamilyDetail:onClick(familyCard)
  FamilyDetail→FamilyMembers:onClick("View Members")
  FamilyDetail→FamilySettings:onClick("Settings")
  FamilySettings→FamilyList:onSuccess(deleteFamily)
  FamilyMembers→FamilyDetail:onBack

  ;; ┌─────────────────────────────────────────────────────────────┐
  ;; │ NAVIGATION FLOW: AUTHENTICATION                              │
  ;; └─────────────────────────────────────────────────────────────┘

  Login→Dashboard:onSuccess(login)
  Login→Login:onError(authentication)
  Login→Register:onClick("Sign Up")
  Login→ForgotPassword:onClick("Forgot Password")

  Register→Login:onSuccess(register)
  Register→Register:onError(validation)

  ForgotPassword→Login:onSuccess(sendResetEmail)
  ResetPassword→Login:onSuccess(resetPassword)

  ;; ┌─────────────────────────────────────────────────────────────┐
  ;; │ AUTH-TRIGGERED TRANSITIONS                                   │
  ;; └─────────────────────────────────────────────────────────────┘

  ;; Session expired anywhere → Login
  ∀s:ViewState:s→Login:onAuthExpired

  ;; Logout from anywhere → Login
  ∀s:ViewState:s→Login:onLogout

  ;; ┌─────────────────────────────────────────────────────────────┐
  ;; │ ERROR TRANSITIONS                                            │
  ;; └─────────────────────────────────────────────────────────────┘

  ∀s:ViewState:s→NotFound:onError(NOT_FOUND)
  ∀s:ViewState:s→ServerError:onError(INTERNAL_ERROR)
  ∀s:ViewState:s→Maintenance:onError(SERVICE_UNAVAILABLE)
}

;; ─── Γ: GUARDS ───

⟦Γ:Guards⟧{
  ;; ┌─────────────────────────────────────────────────────────────┐
  ;; │ AUTHENTICATION GUARDS                                        │
  ;; │ Conditions that must be true for transition                  │
  ;; └─────────────────────────────────────────────────────────────┘

  ;; Protected routes require authentication
  ProtectedRoutes≜{Dashboard,FamilyCreate,FamilyList,FamilyDetail,
                    FamilySettings,FamilyMembers,StoryCreate,StoryView,
                    StoryEdit,StoryList,Settings,Profile}

  ∀r∈ProtectedRoutes:
    canEnter(r)⇔AuthState≡authenticated

  ;; Public routes accessible without auth
  PublicRoutes≜{Login,Register,ForgotPassword,ResetPassword,FamilyJoin}

  ∀r∈PublicRoutes:
    canEnter(r)⇔⊤

  ;; ┌─────────────────────────────────────────────────────────────┐
  ;; │ AUTHORIZATION GUARDS                                         │
  ;; │ Role-based access control                                    │
  ;; └─────────────────────────────────────────────────────────────┘

  ;; Only family owner can access settings
  canEnter(FamilySettings)⇔
    AuthState≡authenticated∧
    ∃m:family_members:m.user_id≡currentUser.id∧m.role≡'owner'

  ;; Only members can view family details
  canEnter(FamilyDetail(familyId))⇔
    AuthState≡authenticated∧
    ∃m:family_members:m.family_id≡familyId∧m.user_id≡currentUser.id

  ;; ┌─────────────────────────────────────────────────────────────┐
  ;; │ FORM GUARDS                                                  │
  ;; │ Prevent navigation with unsaved changes                      │
  ;; └─────────────────────────────────────────────────────────────┘

  ;; Warn before leaving dirty form
  canLeave(FamilyCreate)⇔
    FormState≡pristine∨FormState≡submitted∨confirm("Discard changes?")

  canLeave(StoryEdit)⇔
    FormState≡pristine∨FormState≡submitted∨confirm("Discard changes?")
}

;; ─── Γ: INVARIANTS ───

⟦Γ:Invariants⟧{
  ;; ┌─────────────────────────────────────────────────────────────┐
  ;; │ NAVIGATION CONSTRAINTS                                       │
  ;; │ Invalid transitions that must never occur                    │
  ;; └─────────────────────────────────────────────────────────────┘

  ;; Cannot skip family creation to see invite
  ¬(Dashboard→FamilyShowInvite)

  ;; Cannot access family detail without going through list or join
  ¬(Dashboard→FamilyDetail)
  ¬(Login→FamilyDetail)

  ;; Cannot edit story without viewing it first
  ¬(Dashboard→StoryEdit)
  ¬(StoryList→StoryEdit)  ;; Must go through StoryView

  ;; ┌─────────────────────────────────────────────────────────────┐
  ;; │ STATE CONSISTENCY                                            │
  ;; └─────────────────────────────────────────────────────────────┘

  ;; Only one view state active at a time
  ∀t:∃!s:ViewState:active(s,t)

  ;; Loading state must be idle before navigation
  canNavigate⇔LoadingState∈{idle,success,error}

  ;; Submitting form blocks navigation
  FormState≡submitting⇒¬canNavigate
}

;; ─── Λ: ACTIONS ───

⟦Λ:Actions⟧{
  ;; ┌─────────────────────────────────────────────────────────────┐
  ;; │ TRANSITION SIDE EFFECTS                                      │
  ;; │ Actions executed on state transitions                        │
  ;; └─────────────────────────────────────────────────────────────┘

  ;; On entering Dashboard
  onEnter(Dashboard)≜[
    fetchFamilies(),
    fetchRecentStories(),
    analytics.track("view_dashboard")
  ]

  ;; On entering FamilyCreate
  onEnter(FamilyCreate)≜[
    resetForm(),
    analytics.track("start_family_creation")
  ]

  ;; On leaving with success
  onExit(FamilyCreate,success)≜[
    analytics.track("family_created",{familyId}),
    toast.success("Family created!")
  ]

  ;; On entering FamilyShowInvite
  onEnter(FamilyShowInvite)≜[
    analytics.track("view_invite_code"),
    confetti.fire()  ;; Celebration!
  ]

  ;; On entering FamilyJoin
  onEnter(FamilyJoin)≜[
    resetForm(),
    focusInput("inviteCode")
  ]

  ;; On successful join
  onExit(FamilyJoin,success)≜[
    analytics.track("family_joined",{familyId}),
    toast.success("Welcome to the family!")
  ]

  ;; ┌─────────────────────────────────────────────────────────────┐
  ;; │ ERROR ACTIONS                                                │
  ;; └─────────────────────────────────────────────────────────────┘

  onError(validation)≜[
    scrollToFirstError(),
    focusFirstInvalidField()
  ]

  onError(authentication)≜[
    clearAuthToken(),
    redirect(Login)
  ]

  onError(network)≜[
    toast.error("Connection lost. Please check your internet.")
  ]
}

;; ─── Λ: ROUTES ───

⟦Λ:Routes⟧{
  ;; ┌─────────────────────────────────────────────────────────────┐
  ;; │ URL ↔ STATE MAPPING                                          │
  ;; └─────────────────────────────────────────────────────────────┘

  route:𝕊→ViewState
  route≜λpath.case[
    "/"                    → Dashboard,
    "/login"               → Login,
    "/register"            → Register,
    "/forgot-password"     → ForgotPassword,
    "/reset-password/:token" → ResetPassword,
    "/family/create"       → FamilyCreate,
    "/family/join"         → FamilyJoin,
    "/family/join/:code"   → FamilyJoin,
    "/family/:id"          → FamilyDetail,
    "/family/:id/invite"   → FamilyShowInvite,
    "/family/:id/members"  → FamilyMembers,
    "/family/:id/settings" → FamilySettings,
    "/families"            → FamilyList,
    "/story/create"        → StoryCreate,
    "/story/:id"           → StoryView,
    "/story/:id/edit"      → StoryEdit,
    "/stories"             → StoryList,
    "/settings"            → Settings,
    "/profile"             → Profile,
    _                      → NotFound
  ]

  path:ViewState→𝕊
  path≜λstate.case[
    Dashboard              → "/",
    Login                  → "/login",
    FamilyCreate           → "/family/create",
    FamilyDetail(id)       → "/family/"⧺id,
    FamilyShowInvite(id)   → "/family/"⧺id⧺"/invite",
    FamilyList             → "/families",
    _                      → "/404"
  ]
}

;; ─── Ε: EVIDENCE ───

⟦Ε⟧⟨
  δ≜0.86
  φ≜100
  τ≜◊⁺⁺
  ⊢States:{{STATE_COUNT}}/{{STATE_COUNT}}
  ⊢Transitions:{{TRANSITION_COUNT}}
  ⊢Guards:{{GUARD_COUNT}}
  ⊢Routes:{{ROUTE_COUNT}}
  ⊢Invariants:verified
  ⊢Ambig(D)<0.02
⟩

;; ═══════════════════════════════════════════════════════════════════════════
