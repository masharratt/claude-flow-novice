;; ═══════════════════════════════════════════════════════════════════════════
;; AISP Config & Feature Flags Contract Template v5.1
;; Usage: Define feature toggles, environment configs, and rollout rules
;; ═══════════════════════════════════════════════════════════════════════════

𝔸5.1.epic-config@{{DATE}}
γ≔{{EPIC_ID}}.config.flags
ρ≔⟨flags,environments,rollout,dependencies,evidence⟩
⊢ND∧Ambig<0.02

;; ─── Σ: ENVIRONMENT TYPES ───

⟦Σ:Environments⟧{
  ;; ┌─────────────────────────────────────────────────────────────────┐
  ;; │ DEPLOYMENT ENVIRONMENTS                                         │
  ;; └─────────────────────────────────────────────────────────────────┘

  Environment≜⟨development|staging|production⟩

  ;; ┌─────────────────────────────────────────────────────────────────┐
  ;; │ FEATURE FLAG TYPES                                              │
  ;; └─────────────────────────────────────────────────────────────────┘

  FlagType≜⟨
    boolean|         ;; Simple on/off
    percentage|      ;; Gradual rollout (0-100)
    userSegment|     ;; Target specific users
    dateRange|       ;; Time-bounded features
    experiment       ;; A/B testing variant
  ⟩

  ;; ┌─────────────────────────────────────────────────────────────────┐
  ;; │ ROLLOUT STAGES                                                  │
  ;; └─────────────────────────────────────────────────────────────────┘

  RolloutStage≜⟨
    disabled|        ;; Feature completely off
    internal|        ;; Team/internal users only
    beta|            ;; Opt-in beta testers
    gradual|         ;; Percentage-based rollout
    enabled          ;; Feature fully enabled
  ⟩
}

;; ─── Σ: FLAG DEFINITIONS ───

⟦Σ:Flags⟧{
  ;; ┌─────────────────────────────────────────────────────────────────┐
  ;; │ FEATURE FLAG SCHEMA                                             │
  ;; │ Each flag defines: key, type, default, environments, deps       │
  ;; └─────────────────────────────────────────────────────────────────┘

  FeatureFlag≜⟨
    key:𝕊,
    description:𝕊,
    type:FlagType,
    default:𝔹,
    environments:Map(Environment→FlagValue),
    dependencies:List(FlagKey),
    owner:𝕊,
    created:ISO8601,
    sunset:ISO8601?               ;; Optional expiry date
  ⟩

  FlagValue≜⟨
    enabled:𝔹|
    percentage:ℕ:0≤n≤100|
    segments:List(UserSegment)|
    variant:𝕊
  ⟩

  UserSegment≜⟨
    Internal|         ;; @company.com emails
    BetaTesters|      ;; Users with beta flag
    PremiumUsers|     ;; Paid tier
    NewUsers|         ;; Account <30 days
    AllUsers          ;; Everyone
  ⟩

  ;; ┌─────────────────────────────────────────────────────────────────┐
  ;; │ EXAMPLE: FAMILY MANAGEMENT FLAGS                                │
  ;; └─────────────────────────────────────────────────────────────────┘

  ;; flag_family_creation≜⟨
  ;;   key:"ENABLE_FAMILY_CREATION",
  ;;   description:"Allow users to create family groups",
  ;;   type:boolean,
  ;;   default:false,
  ;;   environments:{
  ;;     development → enabled:true,
  ;;     staging → enabled:true,
  ;;     production → enabled:false
  ;;   },
  ;;   dependencies:[],
  ;;   owner:"family-team",
  ;;   created:"2024-01-15"
  ;; ⟩

  ;; flag_family_invites≜⟨
  ;;   key:"ENABLE_FAMILY_INVITES",
  ;;   description:"Allow sending invite codes to join families",
  ;;   type:boolean,
  ;;   default:false,
  ;;   environments:{
  ;;     development → enabled:true,
  ;;     staging → enabled:true,
  ;;     production → percentage:25  ;; Gradual rollout
  ;;   },
  ;;   dependencies:["ENABLE_FAMILY_CREATION"],  ;; Must enable creation first
  ;;   owner:"family-team",
  ;;   created:"2024-01-20"
  ;; ⟩

  ;; flag_story_sharing≜⟨
  ;;   key:"ENABLE_STORY_SHARING",
  ;;   description:"Allow sharing stories with family members",
  ;;   type:userSegment,
  ;;   default:false,
  ;;   environments:{
  ;;     development → enabled:true,
  ;;     staging → segments:[Internal,BetaTesters],
  ;;     production → segments:[Internal]
  ;;   },
  ;;   dependencies:["ENABLE_FAMILY_CREATION"],
  ;;   owner:"stories-team",
  ;;   created:"2024-02-01",
  ;;   sunset:"2024-06-01"  ;; Remove after full launch
  ;; ⟩
}

;; ─── Σ: CONFIG SCHEMA ───

⟦Σ:Config⟧{
  ;; ┌─────────────────────────────────────────────────────────────────┐
  ;; │ ENVIRONMENT CONFIGURATION                                       │
  ;; │ Non-feature settings that vary by environment                   │
  ;; └─────────────────────────────────────────────────────────────────┘

  EnvConfig≜⟨
    api_url:URL,
    database_url:URL:secret,
    redis_url:URL:secret,
    log_level:LogLevel,
    rate_limits:RateLimits,
    timeouts:Timeouts
  ⟩

  LogLevel≜⟨debug|info|warn|error⟩

  RateLimits≜⟨
    requests_per_minute:ℕ,
    requests_per_hour:ℕ,
    burst_limit:ℕ
  ⟩

  Timeouts≜⟨
    api_timeout_ms:ℕ,
    db_timeout_ms:ℕ,
    cache_ttl_seconds:ℕ
  ⟩

  ;; ┌─────────────────────────────────────────────────────────────────┐
  ;; │ ENVIRONMENT-SPECIFIC VALUES                                     │
  ;; └─────────────────────────────────────────────────────────────────┘

  ;; config_development≜⟨
  ;;   api_url:"http://localhost:3000",
  ;;   database_url:"postgresql://localhost:5432/dev",
  ;;   log_level:debug,
  ;;   rate_limits:{requests_per_minute:1000, requests_per_hour:50000, burst_limit:100},
  ;;   timeouts:{api_timeout_ms:30000, db_timeout_ms:10000, cache_ttl_seconds:60}
  ;; ⟩

  ;; config_production≜⟨
  ;;   api_url:"https://api.example.com",
  ;;   database_url:"[REDACTED]",
  ;;   log_level:warn,
  ;;   rate_limits:{requests_per_minute:100, requests_per_hour:5000, burst_limit:20},
  ;;   timeouts:{api_timeout_ms:10000, db_timeout_ms:5000, cache_ttl_seconds:300}
  ;; ⟩
}

;; ─── Γ: FLAG RULES ───

⟦Γ:Rules⟧{
  ;; ┌─────────────────────────────────────────────────────────────────┐
  ;; │ DEPENDENCY RULES                                                │
  ;; │ Flags with dependencies require parent flags enabled            │
  ;; └─────────────────────────────────────────────────────────────────┘

  ;; If flag has dependencies, all must be enabled
  ∀f:FeatureFlag:
    f.dependencies≠[]⇒
      enabled(f)⇔∀d∈f.dependencies:enabled(d)

  ;; Cannot enable child before parent
  ∀f:FeatureFlag,env:Environment:
    setEnabled(f,env)⇒
      ∀d∈f.dependencies:isEnabled(d,env)

  ;; ┌─────────────────────────────────────────────────────────────────┐
  ;; │ ROLLOUT PROGRESSION                                             │
  ;; │ Features must progress through stages                           │
  ;; └─────────────────────────────────────────────────────────────────┘

  ;; Must be enabled in dev before staging
  ∀f:FeatureFlag:
    isEnabled(f,staging)⇒isEnabled(f,development)

  ;; Must be enabled in staging before production
  ∀f:FeatureFlag:
    isEnabled(f,production)⇒isEnabled(f,staging)

  ;; Gradual rollout must start at ≤10%
  ∀f:FeatureFlag:
    f.type≡percentage∧firstEnable(f,production)⇒
      f.environments[production].percentage≤10

  ;; ┌─────────────────────────────────────────────────────────────────┐
  ;; │ SUNSET RULES                                                    │
  ;; │ Flags with sunset dates must be cleaned up                      │
  ;; └─────────────────────────────────────────────────────────────────┘

  ;; Sunset flags should be fully enabled or removed
  ∀f:FeatureFlag:
    f.sunset≠∅∧now()>f.sunset⇒
      (∀env:isEnabled(f,env))∨removed(f)

  ;; Warn 30 days before sunset
  ∀f:FeatureFlag:
    f.sunset≠∅∧now()>f.sunset-30days⇒
      warn("Flag approaching sunset",f.key)

  ;; ┌─────────────────────────────────────────────────────────────────┐
  ;; │ SEGMENT RULES                                                   │
  ;; │ User segment constraints                                        │
  ;; └─────────────────────────────────────────────────────────────────┘

  ;; Internal users always have access to internal segment
  ∀u:User:isInternal(u)⇒hasAccess(u,Internal)

  ;; AllUsers segment grants access to everyone
  ∀f:FeatureFlag,env:Environment:
    AllUsers∈f.environments[env].segments⇒
      ∀u:User:hasAccess(u,f,env)
}

;; ─── Λ: FLAG FUNCTIONS ───

⟦Λ:Functions⟧{
  ;; ┌─────────────────────────────────────────────────────────────────┐
  ;; │ FLAG EVALUATION                                                 │
  ;; └─────────────────────────────────────────────────────────────────┘

  ;; Check if flag enabled for user in environment
  isEnabled:(FlagKey,User,Environment)→𝔹
  isEnabled≜λ(key,user,env).
    let flag≔getFlag(key) in
    let value≔flag.environments[env] in
    case value[
      enabled:b      → b,
      percentage:p   → hash(user.id,key)%100<p,
      segments:segs  → ∃s∈segs:inSegment(user,s),
      variant:v      → v≠"control"
    ]

  ;; Get flag value with fallback
  getFlag:(FlagKey)→FeatureFlag
  getFlag≜λkey.
    flags[key]?flags[key]:error(FLAG_NOT_FOUND,key)

  ;; ┌─────────────────────────────────────────────────────────────────┐
  ;; │ SEGMENT MEMBERSHIP                                              │
  ;; └─────────────────────────────────────────────────────────────────┘

  inSegment:(User,UserSegment)→𝔹
  inSegment≜λ(user,segment).case segment[
    Internal     → endsWith(user.email,"@company.com"),
    BetaTesters  → user.beta_enrolled≡true,
    PremiumUsers → user.tier∈{premium,enterprise},
    NewUsers     → daysSince(user.created_at)<30,
    AllUsers     → true
  ]

  ;; ┌─────────────────────────────────────────────────────────────────┐
  ;; │ FLAG MANAGEMENT                                                 │
  ;; └─────────────────────────────────────────────────────────────────┘

  ;; Enable flag for environment (validates dependencies)
  enableFlag:(FlagKey,Environment)→Result(Unit,Error)
  enableFlag≜λ(key,env).
    let flag≔getFlag(key) in
    ∀d∈flag.dependencies:isEnabled(d,env)?
      Ok(setFlag(key,env,enabled:true)):
      Err(DEPENDENCY_NOT_ENABLED,d)

  ;; Gradual rollout increase
  increaseRollout:(FlagKey,ℕ)→Result(Unit,Error)
  increaseRollout≜λ(key,increment).
    let flag≔getFlag(key) in
    flag.type≡percentage?
      let current≔flag.environments[production].percentage in
      let next≔min(current+increment,100) in
      Ok(setFlag(key,production,percentage:next)):
      Err(FLAG_NOT_PERCENTAGE_TYPE)
}

;; ─── Λ: CONFIG ACCESS ───

⟦Λ:ConfigAccess⟧{
  ;; ┌─────────────────────────────────────────────────────────────────┐
  ;; │ ENVIRONMENT CONFIG ACCESS                                       │
  ;; └─────────────────────────────────────────────────────────────────┘

  getConfig:(Environment)→EnvConfig
  getConfig≜λenv.configs[env]

  ;; Type-safe config value access
  getApiUrl:(Environment)→URL
  getApiUrl≜λenv.getConfig(env).api_url

  getRateLimit:(Environment)→ℕ
  getRateLimit≜λenv.getConfig(env).rate_limits.requests_per_minute

  ;; ┌─────────────────────────────────────────────────────────────────┐
  ;; │ CONFIG VALIDATION                                               │
  ;; └─────────────────────────────────────────────────────────────────┘

  ;; All required configs must be set
  validateConfig:(Environment)→Result(Unit,List(Error))
  validateConfig≜λenv.
    let config≔getConfig(env) in
    let errors≔[] in
    config.api_url≡∅?errors.push(MISSING_CONFIG,"api_url"):∅;
    config.database_url≡∅?errors.push(MISSING_CONFIG,"database_url"):∅;
    len(errors)>0?Err(errors):Ok(())
}

;; ─── Χ: CONFIG ERRORS ───

⟦Χ:Errors⟧{
  ;; ┌─────────────────────────────────────────────────────────────────┐
  ;; │ FLAG ERRORS                                                     │
  ;; └─────────────────────────────────────────────────────────────────┘

  FLAG_NOT_FOUND≜⟨
    code:4001,
    message:λkey."Feature flag not found: "⧺key,
    recovery:useDefault
  ⟩

  DEPENDENCY_NOT_ENABLED≜⟨
    code:4002,
    message:λdep."Cannot enable: dependency "⧺dep⧺" not enabled",
    recovery:reject
  ⟩

  FLAG_NOT_PERCENTAGE_TYPE≜⟨
    code:4003,
    message:"Flag is not percentage type, cannot adjust rollout",
    recovery:reject
  ⟩

  INVALID_PERCENTAGE≜⟨
    code:4004,
    message:"Percentage must be between 0 and 100",
    recovery:reject
  ⟩

  FLAG_SUNSET_EXPIRED≜⟨
    code:4005,
    message:λkey."Flag "⧺key⧺" has passed sunset date",
    recovery:warn∧useDefault
  ⟩

  ;; ┌─────────────────────────────────────────────────────────────────┐
  ;; │ CONFIG ERRORS                                                   │
  ;; └─────────────────────────────────────────────────────────────────┘

  MISSING_CONFIG≜⟨
    code:4101,
    message:λfield."Missing required config: "⧺field,
    recovery:crash  ;; Cannot start without required config
  ⟩

  INVALID_CONFIG_VALUE≜⟨
    code:4102,
    message:λ(field,value)."Invalid value for "⧺field⧺": "⧺value,
    recovery:reject
  ⟩
}

;; ─── Ε: EVIDENCE ───

⟦Ε⟧⟨
  δ≜0.82
  φ≜100
  τ≜◊⁺⁺
  ⊢Flags:{{FLAG_COUNT}}/{{FLAG_COUNT}}
  ⊢Environments:{{ENV_COUNT}}
  ⊢DependencyChains:validated
  ⊢RolloutRules:{{RULE_COUNT}}
  ⊢Ambig(D)<0.02
⟩

