;; EXECUTION ORDER VISUALIZATION
;; ═══════════════════════════════════════════════════════════════════════════
;;
;; Dependency Graph for Family Management Epic:
;;
;;   ┌───────────────────┐
;;   │ 001_create_enums  │  Phase 1: Types
;;   └─────────┬─────────┘
;;             │
;;   ┌─────────▼─────────┐
;;   │ 002_create_families│  Phase 2: Tables
;;   └─────────┬─────────┘
;;             │
;;   ┌─────────▼─────────┐
;;   │ 003_create_members │  Phase 2: Tables
;;   └────┬────┬────┬────┘
;;        │    │    │
;;   ┌────▼──┐ │ ┌──▼────┐
;;   │004_idx│ │ │005_rls│  Phase 3: Indexes & RLS (parallel)
;;   └───────┘ │ └───────┘
;;             │
;;   ┌─────────▼─────────┐
;;   │ 006_create_triggers│  Phase 4: Functions
;;   └─────────┬─────────┘
;;             │
;;   ┌─────────▼─────────┐
;;   │ 007_seed_data     │  Phase 5: Seed (dev only)
;;   └───────────────────┘
;;
;; Rollback Order (reverse):
;;   007 → 006 → 005 → 004 → 003 → 002 → 001
;;
