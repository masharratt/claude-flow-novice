;; ═══════════════════════════════════════════════════════════════════════════
;; AISP Migration Ordering Contract Template v5.1
;; Usage: Define migration dependencies, execution order, and rollback chains
;; ═══════════════════════════════════════════════════════════════════════════

𝔸5.1.epic-migrations@{{DATE}}
γ≔{{EPIC_ID}}.migration.order
ρ≔⟨migrations,dependencies,execution,rollback,evidence⟩
⊢ND∧Ambig<0.02

;; ─── Σ: MIGRATION TYPES ───

⟦Σ:Types⟧{
  ;; ┌─────────────────────────────────────────────────────────────────┐
  ;; │ MIGRATION CATEGORIES                                            │
  ;; └─────────────────────────────────────────────────────────────────┘

  MigrationCategory≜⟨
    schema|          ;; Database DDL (CREATE, ALTER, DROP)
    data|            ;; Data transformations (UPDATE, INSERT)
    index|           ;; Index creation/modification
    constraint|      ;; Foreign keys, checks
    rls|             ;; Row-level security policies
    function|        ;; Stored procedures, triggers
    seed             ;; Initial data population
  ⟩

  ;; ┌─────────────────────────────────────────────────────────────────┐
  ;; │ MIGRATION STATES                                                │
  ;; └─────────────────────────────────────────────────────────────────┘

  MigrationState≜⟨
    pending|         ;; Not yet executed
    running|         ;; Currently executing
    completed|       ;; Successfully finished
    failed|          ;; Execution error
    rolledback       ;; Reverted after failure
  ⟩

  ;; ┌─────────────────────────────────────────────────────────────────┐
  ;; │ EXECUTION MODES                                                 │
  ;; └─────────────────────────────────────────────────────────────────┘

  ExecutionMode≜⟨
    sequential|      ;; One at a time, in order
    parallel|        ;; Independent migrations together
    transactional    ;; All-or-nothing within transaction
  ⟩

  ;; ┌─────────────────────────────────────────────────────────────────┐
  ;; │ ROLLBACK STRATEGY                                               │
  ;; └─────────────────────────────────────────────────────────────────┘

  RollbackStrategy≜⟨
    auto|            ;; Generated inverse operation
    manual|          ;; Explicit down migration
    none             ;; Irreversible (data destruction)
  ⟩
}

;; ─── Σ: MIGRATION SCHEMA ───

⟦Σ:Migrations⟧{
  ;; ┌─────────────────────────────────────────────────────────────────┐
  ;; │ MIGRATION DEFINITION                                            │
  ;; └─────────────────────────────────────────────────────────────────┘

  Migration≜⟨
    id:MigrationId,              ;; Unique identifier (timestamp-based)
    name:𝕊,                      ;; Human-readable name
    category:MigrationCategory,
    description:𝕊,
    up:SQL,                      ;; Forward migration
    down:SQL?,                   ;; Rollback (if reversible)
    dependencies:List(MigrationId),
    rollback:RollbackStrategy,
    estimated_duration:Duration,
    locks:List(TableName),       ;; Tables that will be locked
    breaking:𝔹                   ;; Requires application downtime
  ⟩

  MigrationId≜𝕊:pattern("YYYYMMDD_HHMMSS_name")

  ;; ┌─────────────────────────────────────────────────────────────────┐
  ;; │ EXAMPLE: FAMILY MANAGEMENT MIGRATIONS                           │
  ;; └─────────────────────────────────────────────────────────────────┘

  ;; Phase 1: Enums (no dependencies)
  m_001_enums≜⟨
    id:"20240115_001_create_enums",
    name:"Create family type enums",
    category:schema,
    up:"CREATE TYPE family_type AS ENUM ('core','extended','chosen');
        CREATE TYPE privacy_type AS ENUM ('public','private');
        CREATE TYPE member_role AS ENUM ('owner','member','editor');",
    down:"DROP TYPE member_role; DROP TYPE privacy_type; DROP TYPE family_type;",
    dependencies:[],
    rollback:auto,
    estimated_duration:1s,
    locks:[],
    breaking:false
  ⟩

  ;; Phase 2: Tables (depends on enums)
  m_002_families≜⟨
    id:"20240115_002_create_families",
    name:"Create families table",
    category:schema,
    up:"CREATE TABLE families (
          id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
          name VARCHAR(100) NOT NULL,
          type family_type NOT NULL DEFAULT 'core',
          privacy privacy_type NOT NULL DEFAULT 'private',
          invite_code VARCHAR(6) UNIQUE NOT NULL,
          created_by UUID NOT NULL REFERENCES auth.users(id),
          created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
          updated_at TIMESTAMPTZ NOT NULL DEFAULT now()
        );",
    down:"DROP TABLE families;",
    dependencies:["20240115_001_create_enums"],
    rollback:auto,
    estimated_duration:2s,
    locks:[],
    breaking:false
  ⟩

  m_003_members≜⟨
    id:"20240115_003_create_members",
    name:"Create family_members table",
    category:schema,
    up:"CREATE TABLE family_members (
          id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
          family_id UUID NOT NULL REFERENCES families(id) ON DELETE CASCADE,
          user_id UUID NOT NULL REFERENCES auth.users(id) ON DELETE CASCADE,
          role member_role NOT NULL DEFAULT 'member',
          joined_at TIMESTAMPTZ NOT NULL DEFAULT now(),
          UNIQUE(family_id, user_id)
        );",
    down:"DROP TABLE family_members;",
    dependencies:["20240115_002_create_families"],
    rollback:auto,
    estimated_duration:2s,
    locks:[],
    breaking:false
  ⟩

  ;; Phase 3: Indexes (depends on tables)
  m_004_indexes≜⟨
    id:"20240115_004_create_indexes",
    name:"Create performance indexes",
    category:index,
    up:"CREATE INDEX idx_members_family ON family_members(family_id);
        CREATE INDEX idx_members_user ON family_members(user_id);
        CREATE INDEX idx_families_creator ON families(created_by);
        CREATE INDEX idx_families_invite ON families(invite_code);",
    down:"DROP INDEX idx_families_invite;
          DROP INDEX idx_families_creator;
          DROP INDEX idx_members_user;
          DROP INDEX idx_members_family;",
    dependencies:["20240115_003_create_members"],
    rollback:auto,
    estimated_duration:5s,
    locks:[families,family_members],
    breaking:false
  ⟩

  ;; Phase 4: RLS (depends on tables)
  m_005_rls≜⟨
    id:"20240115_005_enable_rls",
    name:"Enable row-level security",
    category:rls,
    up:"ALTER TABLE families ENABLE ROW LEVEL SECURITY;
        ALTER TABLE family_members ENABLE ROW LEVEL SECURITY;

        CREATE POLICY families_select ON families FOR SELECT
          USING (EXISTS (SELECT 1 FROM family_members
                         WHERE family_id = families.id
                         AND user_id = auth.uid()));

        CREATE POLICY families_insert ON families FOR INSERT
          WITH CHECK (created_by = auth.uid());

        CREATE POLICY members_select ON family_members FOR SELECT
          USING (EXISTS (SELECT 1 FROM family_members m
                         WHERE m.family_id = family_members.family_id
                         AND m.user_id = auth.uid()));",
    down:"DROP POLICY members_select ON family_members;
          DROP POLICY families_insert ON families;
          DROP POLICY families_select ON families;
          ALTER TABLE family_members DISABLE ROW LEVEL SECURITY;
          ALTER TABLE families DISABLE ROW LEVEL SECURITY;",
    dependencies:["20240115_003_create_members"],
    rollback:manual,
    estimated_duration:3s,
    locks:[families,family_members],
    breaking:false
  ⟩

  ;; Phase 5: Functions (depends on tables)
  m_006_triggers≜⟨
    id:"20240115_006_create_triggers",
    name:"Create auto-update triggers",
    category:function,
    up:"CREATE OR REPLACE FUNCTION update_updated_at()
        RETURNS TRIGGER AS $$
        BEGIN
          NEW.updated_at = now();
          RETURN NEW;
        END;
        $$ LANGUAGE plpgsql;

        CREATE TRIGGER families_updated_at
          BEFORE UPDATE ON families
          FOR EACH ROW EXECUTE FUNCTION update_updated_at();

        CREATE OR REPLACE FUNCTION add_owner_on_create()
        RETURNS TRIGGER AS $$
        BEGIN
          INSERT INTO family_members(family_id, user_id, role)
          VALUES (NEW.id, NEW.created_by, 'owner');
          RETURN NEW;
        END;
        $$ LANGUAGE plpgsql;

        CREATE TRIGGER families_add_owner
          AFTER INSERT ON families
          FOR EACH ROW EXECUTE FUNCTION add_owner_on_create();",
    down:"DROP TRIGGER families_add_owner ON families;
          DROP FUNCTION add_owner_on_create();
          DROP TRIGGER families_updated_at ON families;
          DROP FUNCTION update_updated_at();",
    dependencies:["20240115_003_create_members"],
    rollback:manual,
    estimated_duration:2s,
    locks:[],
    breaking:false
  ⟩

  ;; Phase 6: Seed data (depends on everything)
  m_007_seed≜⟨
    id:"20240115_007_seed_data",
    name:"Insert seed data for development",
    category:seed,
    up:"INSERT INTO families(name, type, invite_code, created_by)
        SELECT 'Test Family', 'core', 'ABC123', id
        FROM auth.users WHERE email = 'test@example.com';",
    down:"DELETE FROM families WHERE invite_code = 'ABC123';",
    dependencies:["20240115_006_create_triggers"],
    rollback:auto,
    estimated_duration:1s,
    locks:[],
    breaking:false
  ⟩
}

;; ─── Γ: ORDERING RULES ───

⟦Γ:Rules⟧{
  ;; ┌─────────────────────────────────────────────────────────────────┐
  ;; │ DEPENDENCY ORDERING                                             │
  ;; │ Migrations must run after their dependencies                    │
  ;; └─────────────────────────────────────────────────────────────────┘

  ;; All dependencies must complete before migration starts
  ∀m:Migration:
    canExecute(m)⇔∀d∈m.dependencies:state(d)≡completed

  ;; No circular dependencies
  ∀m1,m2:Migration:
    m1∈dependencies(m2)⇒m2∉dependencies(m1)

  ;; Transitive dependency resolution
  ∀m:Migration:
    effectiveDeps(m)≡m.dependencies∪
      ⋃{effectiveDeps(d)|d∈m.dependencies}

  ;; ┌─────────────────────────────────────────────────────────────────┐
  ;; │ CATEGORY ORDERING                                               │
  ;; │ Certain categories must precede others                          │
  ;; └─────────────────────────────────────────────────────────────────┘

  ;; Enums before tables (types must exist)
  ∀m:Migration:m.category≡schema∧usesEnum(m)⇒
    ∃d∈m.dependencies:d.category≡schema∧createsEnum(d)

  ;; Tables before indexes
  ∀m:Migration:m.category≡index⇒
    ∀t∈tablesIndexed(m):∃d∈m.dependencies:creates(d,t)

  ;; Tables before RLS
  ∀m:Migration:m.category≡rls⇒
    ∀t∈tablesSecured(m):∃d∈m.dependencies:creates(d,t)

  ;; Tables before constraints
  ∀m:Migration:m.category≡constraint⇒
    ∀t∈tablesConstrained(m):∃d∈m.dependencies:creates(d,t)

  ;; Everything before seed
  ∀m:Migration:m.category≡seed⇒
    ∀t∈tablesSeeded(m):
      ∃d∈effectiveDeps(m):creates(d,t)∧state(d)≡completed

  ;; ┌─────────────────────────────────────────────────────────────────┐
  ;; │ ROLLBACK ORDERING                                               │
  ;; │ Rollbacks execute in reverse dependency order                   │
  ;; └─────────────────────────────────────────────────────────────────┘

  ;; Can only rollback if no dependent migrations completed
  ∀m:Migration:
    canRollback(m)⇔∀d:Migration:
      m∈d.dependencies⇒state(d)∈{pending,rolledback}

  ;; Rollback chain: must rollback dependents first
  ∀m:Migration:
    rollbackChain(m)≡sort(
      {d|d:Migration∧m∈effectiveDeps(d)∧state(d)≡completed},
      byDependencyDepth,descending
    )⧺[m]

  ;; ┌─────────────────────────────────────────────────────────────────┐
  ;; │ SAFETY RULES                                                    │
  ;; └─────────────────────────────────────────────────────────────────┘

  ;; Breaking migrations require maintenance window
  ∀m:Migration:m.breaking≡true⇒
    requiresApproval(m)∧duringMaintenanceWindow()

  ;; Long-running migrations need timeout
  ∀m:Migration:m.estimated_duration>30s⇒
    hasTimeout(m)

  ;; Irreversible migrations need confirmation
  ∀m:Migration:m.rollback≡none⇒
    requiresExplicitConfirmation(m)
}

;; ─── Λ: EXECUTION FUNCTIONS ───

⟦Λ:Functions⟧{
  ;; ┌─────────────────────────────────────────────────────────────────┐
  ;; │ DEPENDENCY GRAPH                                                │
  ;; └─────────────────────────────────────────────────────────────────┘

  ;; Build execution order from dependencies
  executionOrder:(List(Migration))→List(Migration)
  executionOrder≜λms.
    topologicalSort(ms,λm.m.dependencies)

  ;; Get all migrations that can run now
  readyMigrations:(List(Migration))→List(Migration)
  readyMigrations≜λms.
    filter(ms,λm.state(m)≡pending∧canExecute(m))

  ;; ┌─────────────────────────────────────────────────────────────────┐
  ;; │ EXECUTION                                                       │
  ;; └─────────────────────────────────────────────────────────────────┘

  ;; Execute single migration
  execute:(Migration)→Result(Unit,Error)
  execute≜λm.
    canExecute(m)?
      (setState(m,running);
       runSQL(m.up);
       setState(m,completed);
       Ok(())):
      Err(DEPENDENCIES_NOT_MET,m.id)

  ;; Execute all pending migrations
  migrateUp:(List(Migration))→Result(Unit,Error)
  migrateUp≜λms.
    let ordered≔executionOrder(ms) in
    let pending≔filter(ordered,λm.state(m)≡pending) in
    ∀m∈pending:execute(m)?
      Ok(()):
      Err(MIGRATION_FAILED,m.id)

  ;; ┌─────────────────────────────────────────────────────────────────┐
  ;; │ ROLLBACK                                                        │
  ;; └─────────────────────────────────────────────────────────────────┘

  ;; Rollback single migration
  rollback:(Migration)→Result(Unit,Error)
  rollback≜λm.
    canRollback(m)?
      case m.rollback[
        auto   → (runSQL(m.down);setState(m,rolledback);Ok(())),
        manual → (runSQL(m.down);setState(m,rolledback);Ok(())),
        none   → Err(IRREVERSIBLE_MIGRATION,m.id)
      ]:
      Err(DEPENDENTS_STILL_APPLIED,m.id)

  ;; Rollback to specific migration
  rollbackTo:(MigrationId)→Result(Unit,Error)
  rollbackTo≜λtargetId.
    let target≔getMigration(targetId) in
    let chain≔rollbackChain(target) in
    ∀m∈chain:rollback(m)?
      Ok(()):
      Err(ROLLBACK_FAILED,m.id)

  ;; ┌─────────────────────────────────────────────────────────────────┐
  ;; │ VALIDATION                                                      │
  ;; └─────────────────────────────────────────────────────────────────┘

  ;; Validate migration graph has no cycles
  validateGraph:(List(Migration))→Result(Unit,Error)
  validateGraph≜λms.
    hasCycle(buildGraph(ms))?
      Err(CIRCULAR_DEPENDENCY):
      Ok(())

  ;; Validate all dependencies exist
  validateDependencies:(List(Migration))→Result(Unit,List(Error))
  validateDependencies≜λms.
    let ids≔map(ms,λm.m.id) in
    let missing≔flatten(map(ms,λm.
      filter(m.dependencies,λd.d∉ids))) in
    len(missing)>0?
      Err(map(missing,λd.MISSING_DEPENDENCY(d))):
      Ok(())
}

;; ─── Χ: MIGRATION ERRORS ───

⟦Χ:Errors⟧{
  DEPENDENCIES_NOT_MET≜⟨
    code:5001,
    message:λid."Cannot execute "⧺id⧺": dependencies not completed",
    recovery:wait
  ⟩

  MIGRATION_FAILED≜⟨
    code:5002,
    message:λid."Migration "⧺id⧺" failed",
    recovery:rollback
  ⟩

  IRREVERSIBLE_MIGRATION≜⟨
    code:5003,
    message:λid."Migration "⧺id⧺" cannot be rolled back",
    recovery:reject
  ⟩

  DEPENDENTS_STILL_APPLIED≜⟨
    code:5004,
    message:λid."Cannot rollback "⧺id⧺": dependent migrations still applied",
    recovery:rollbackDependentsFirst
  ⟩

  CIRCULAR_DEPENDENCY≜⟨
    code:5005,
    message:"Migration graph contains circular dependency",
    recovery:reject
  ⟩

  MISSING_DEPENDENCY≜⟨
    code:5006,
    message:λdep."Dependency not found: "⧺dep,
    recovery:reject
  ⟩

  ROLLBACK_FAILED≜⟨
    code:5007,
    message:λid."Rollback failed for "⧺id,
    recovery:manualIntervention
  ⟩
}

;; ─── Ε: EVIDENCE ───

⟦Ε⟧⟨
  δ≜0.88
  φ≜100
  τ≜◊⁺⁺
  ⊢Migrations:{{MIGRATION_COUNT}}/{{MIGRATION_COUNT}}
  ⊢DependencyGraph:acyclic
  ⊢RollbackChains:{{ROLLBACK_COUNT}}_verified
  ⊢ExecutionOrder:topological
  ⊢Ambig(D)<0.02
⟩

