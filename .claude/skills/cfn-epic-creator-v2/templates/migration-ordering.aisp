;; SUPABASE CLI INTEGRATION
;; ═══════════════════════════════════════════════════════════════════════════
;;
;; Generated migration files:
;;   supabase/migrations/20240115001_create_enums.sql
;;   supabase/migrations/20240115002_create_families.sql
;;   supabase/migrations/20240115003_create_members.sql
;;   supabase/migrations/20240115004_create_indexes.sql
;;   supabase/migrations/20240115005_enable_rls.sql
;;   supabase/migrations/20240115006_create_triggers.sql
;;   supabase/migrations/20240115007_seed_data.sql
;;
;; Commands:
;;   supabase db push        # Apply pending migrations
;;   supabase db reset       # Rollback and reapply all
;;   supabase migration list # Show migration status
