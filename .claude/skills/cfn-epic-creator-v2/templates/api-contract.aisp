;; ═══════════════════════════════════════════════════════════════════════════
;; AISP API Contract Template v5.1
;; Usage: Copy and customize for your epic's API contracts
;; ═══════════════════════════════════════════════════════════════════════════

𝔸5.1.epic-api@{{DATE}}
γ≔{{EPIC_ID}}.api.contracts
ρ≔⟨types,validation,endpoints,evidence⟩
⊢ND∧Ambig<0.02

;; ─── Σ: TYPE DEFINITIONS ───
;; Define all domain types here. Use enums for constrained values.
;; Every type used in requests/responses MUST be defined here.

⟦Σ:Types⟧{
  ;; ┌─────────────────────────────────────────────────────────────┐
  ;; │ PRIMITIVE CONSTRAINTS                                        │
  ;; │ Define constrained string/number types                       │
  ;; └─────────────────────────────────────────────────────────────┘

  UUID≜𝕊:len(36)                          ;; Standard UUID format
  ISO8601≜𝕊:regex("^\d{4}-\d{2}-\d{2}")   ;; Date format
  Email≜𝕊:contains("@")∧len(n)∧5≤n≤255    ;; Email with constraints

  ;; ┌─────────────────────────────────────────────────────────────┐
  ;; │ DOMAIN ENUMS                                                 │
  ;; │ Replace string types with explicit variants                  │
  ;; └─────────────────────────────────────────────────────────────┘

  ;; Example: Instead of `status: string`, use:
  ;; Status≜⟨pending|active|completed|cancelled⟩

  {{ENUM_NAME}}≜⟨{{VARIANT_1}}|{{VARIANT_2}}|{{VARIANT_3}}⟩

  ;; ┌─────────────────────────────────────────────────────────────┐
  ;; │ DOMAIN ENTITIES                                              │
  ;; │ Core business objects                                        │
  ;; └─────────────────────────────────────────────────────────────┘

  ;; Example entity:
  ;; User≜⟨
  ;;   id:UUID,
  ;;   email:Email,
  ;;   name:𝕊:len(n)∧1≤n≤100,
  ;;   role:UserRole,
  ;;   createdAt:ISO8601
  ;; ⟩

  {{ENTITY_NAME}}≜⟨
    id:UUID,
    {{FIELD_1}}:{{TYPE_1}},
    {{FIELD_2}}:{{TYPE_2}},
    createdAt:ISO8601
  ⟩

  ;; ┌─────────────────────────────────────────────────────────────┐
  ;; │ REQUEST/RESPONSE PAIRS                                       │
  ;; │ Define matching pairs for each API endpoint                  │
  ;; └─────────────────────────────────────────────────────────────┘

  ;; CREATE operation
  Create{{Entity}}Request≜⟨
    {{FIELD_1}}:{{TYPE_1}},
    {{FIELD_2}}:{{TYPE_2}}
  ⟩

  Create{{Entity}}Response≜⟨
    id:UUID,
    {{FIELD_1}}:{{TYPE_1}},    ;; SAME type as request - no drift
    {{FIELD_2}}:{{TYPE_2}},    ;; SAME type as request - no drift
    createdAt:ISO8601
  ⟩

  ;; LIST operation
  List{{Entity}}Response≜⟨
    items:List⟨{{Entity}}⟩,
    total:ℕ,
    page:ℕ,
    pageSize:ℕ
  ⟩

  ;; GET operation
  Get{{Entity}}Response≜{{Entity}}

  ;; UPDATE operation
  Update{{Entity}}Request≜⟨
    {{FIELD_1}}:Option⟨{{TYPE_1}}⟩,
    {{FIELD_2}}:Option⟨{{TYPE_2}}⟩
  ⟩

  ;; DELETE operation (typically no body)
  Delete{{Entity}}Response≜⟨success:𝔹⟩

  ;; ┌─────────────────────────────────────────────────────────────┐
  ;; │ ERROR TYPES                                                  │
  ;; │ Standardized error responses                                 │
  ;; └─────────────────────────────────────────────────────────────┘

  ErrorCode≜⟨
    VALIDATION_ERROR|
    NOT_FOUND|
    UNAUTHORIZED|
    FORBIDDEN|
    CONFLICT|
    INTERNAL_ERROR
  ⟩

  APIError≜⟨
    code:ErrorCode,
    message:𝕊,
    details:Option⟨List⟨𝕊⟩⟩
  ⟩
}

;; ─── Γ: VALIDATION RULES ───
;; Define constraints that must hold for all instances

⟦Γ:Rules⟧{
  ;; ┌─────────────────────────────────────────────────────────────┐
  ;; │ FIELD VALIDATION                                             │
  ;; └─────────────────────────────────────────────────────────────┘

  ;; Example: Name must be 3-50 characters
  ;; ∀req:CreateFamilyRequest:
  ;;   len(req.name)≥3∧len(req.name)≤50

  ∀req:Create{{Entity}}Request:
    {{VALIDATION_PREDICATE}}

  ;; ┌─────────────────────────────────────────────────────────────┐
  ;; │ RESPONSE GUARANTEES                                          │
  ;; │ What the API promises to return                              │
  ;; └─────────────────────────────────────────────────────────────┘

  ;; Response types match request types (no drift)
  ∀res:Create{{Entity}}Response:
    res.{{ENUM_FIELD}}∈{{ENUM_TYPE}}

  ;; List responses have valid pagination
  ∀res:List{{Entity}}Response:
    res.page≥0∧res.pageSize>0∧res.pageSize≤100

  ;; ┌─────────────────────────────────────────────────────────────┐
  ;; │ INVARIANTS                                                   │
  ;; │ Properties that always hold                                  │
  ;; └─────────────────────────────────────────────────────────────┘

  ;; IDs are unique
  ∀e1,e2:{{Entity}}:e1.id≡e2.id⇒e1≡e2

  ;; Created timestamp is immutable
  ∀e:{{Entity}}:∂e⇏∂e.createdAt
}

;; ─── Λ: API ENDPOINTS ───
;; Define all endpoints with method, path, auth, and types

⟦Λ:Funcs⟧{
  ;; ┌─────────────────────────────────────────────────────────────┐
  ;; │ CRUD ENDPOINTS                                               │
  ;; └─────────────────────────────────────────────────────────────┘

  ;; CREATE
  create{{Entity}}:Create{{Entity}}Request→Create{{Entity}}Response
  POST /api/{{entity}}
  auth:JWT
  errors:⟨VALIDATION_ERROR,UNAUTHORIZED,CONFLICT⟩

  ;; LIST
  list{{Entity}}s:⟨page:ℕ,pageSize:ℕ⟩→List{{Entity}}Response
  GET /api/{{entity}}s
  auth:JWT
  errors:⟨UNAUTHORIZED⟩

  ;; GET
  get{{Entity}}:UUID→Get{{Entity}}Response
  GET /api/{{entity}}/:id
  auth:JWT
  errors:⟨NOT_FOUND,UNAUTHORIZED,FORBIDDEN⟩

  ;; UPDATE
  update{{Entity}}:⟨id:UUID,body:Update{{Entity}}Request⟩→{{Entity}}
  PATCH /api/{{entity}}/:id
  auth:JWT
  errors:⟨NOT_FOUND,VALIDATION_ERROR,UNAUTHORIZED,FORBIDDEN⟩

  ;; DELETE
  delete{{Entity}}:UUID→Delete{{Entity}}Response
  DELETE /api/{{entity}}/:id
  auth:JWT
  errors:⟨NOT_FOUND,UNAUTHORIZED,FORBIDDEN⟩

  ;; ┌─────────────────────────────────────────────────────────────┐
  ;; │ CUSTOM ENDPOINTS                                             │
  ;; │ Add domain-specific operations                               │
  ;; └─────────────────────────────────────────────────────────────┘

  ;; Example: Search endpoint
  ;; search{{Entity}}s:⟨query:𝕊,filters:SearchFilters⟩→List{{Entity}}Response
  ;; POST /api/{{entity}}s/search
  ;; auth:JWT
}

;; ─── Χ: ERROR HANDLING ───
;; Define error conditions and recovery

⟦Χ:Errors⟧{
  ;; Validation errors return 400
  ε_validation≜⟨¬valid(req),⟨400,VALIDATION_ERROR,details⟩⟩

  ;; Not found returns 404
  ε_notfound≜⟨¬exists(id),⟨404,NOT_FOUND,"Resource not found"⟩⟩

  ;; Unauthorized returns 401
  ε_unauth≜⟨¬authenticated,⟨401,UNAUTHORIZED,"Authentication required"⟩⟩

  ;; Forbidden returns 403
  ε_forbidden≜⟨¬authorized(user,resource),⟨403,FORBIDDEN,"Access denied"⟩⟩

  ;; Conflict returns 409
  ε_conflict≜⟨duplicate(field),⟨409,CONFLICT,"Resource already exists"⟩⟩
}

;; ─── Ε: EVIDENCE ───
;; Validation metrics for this contract

⟦Ε⟧⟨
  δ≜{{DENSITY_SCORE}}        ;; Target: ≥0.75 for ◊⁺⁺
  φ≜{{COMPLETENESS}}         ;; Target: ≥95
  τ≜{{QUALITY_TIER}}         ;; ◊⁺⁺, ◊⁺, ◊, ◊⁻, or ⊘
  ⊢Ambig(D)<0.02             ;; Ambiguity invariant
  ⊢Types:{{TYPE_COUNT}}/{{TYPE_COUNT}}
  ⊢Funcs:{{FUNC_COUNT}}/{{FUNC_COUNT}}
  ⊢Rules:{{RULE_COUNT}}
⟩

;; ═══════════════════════════════════════════════════════════════════════════
;; END OF CONTRACT
;; ═══════════════════════════════════════════════════════════════════════════
