;; ═══════════════════════════════════════════════════════════════════════════
;; AISP Acceptance Criteria Contract Template v5.1
;; Usage: Define formal acceptance predicates that can generate tests
;; ═══════════════════════════════════════════════════════════════════════════

𝔸5.1.epic-acceptance@{{DATE}}
γ≔{{EPIC_ID}}.acceptance.criteria
ρ≔⟨predicates,test-generation,coverage,evidence⟩
⊢ND∧Ambig<0.02

;; ─── Σ: ACCEPTANCE TYPES ───

⟦Σ:Types⟧{
  ;; ┌─────────────────────────────────────────────────────────────┐
  ;; │ ACCEPTANCE RESULT                                            │
  ;; └─────────────────────────────────────────────────────────────┘

  AcceptanceResult≜⟨passed|failed|skipped|blocked⟩

  ;; ┌─────────────────────────────────────────────────────────────┐
  ;; │ ACCEPTANCE CRITERION                                         │
  ;; └─────────────────────────────────────────────────────────────┘

  Criterion≜⟨
    id:𝕊,
    task:TaskId,
    predicate:Predicate,
    priority:⟨P0|P1|P2|P3⟩,     ;; P0=blocker, P3=nice-to-have
    automated:𝔹,
    test_type:⟨unit|integration|e2e|manual⟩
  ⟩

  ;; ┌─────────────────────────────────────────────────────────────┐
  ;; │ PREDICATE PRIMITIVES                                         │
  ;; └─────────────────────────────────────────────────────────────┘

  Predicate≜
    FileExists(path:𝕊)|
    FileContains(path:𝕊,content:𝕊)|
    CommandSucceeds(cmd:𝕊)|
    CommandOutput(cmd:𝕊,expected:𝕊)|
    HTTPStatus(method:𝕊,path:𝕊,status:ℕ)|
    HTTPResponse(method:𝕊,path:𝕊,body:JSON)|
    UIElement(selector:𝕊,state:ElementState)|
    DatabaseQuery(sql:𝕊,expected:Rows)|
    And(p1:Predicate,p2:Predicate)|
    Or(p1:Predicate,p2:Predicate)|
    Not(p:Predicate)

  ElementState≜⟨visible|hidden|enabled|disabled|checked|unchecked⟩
}

;; ─── Γ: TASK ACCEPTANCE CRITERIA ───

⟦Γ:TaskCriteria⟧{
  ;; ┌─────────────────────────────────────────────────────────────┐
  ;; │ DATABASE MIGRATION TASKS                                     │
  ;; │ task-1.1.1: Create families table migration                  │
  ;; └─────────────────────────────────────────────────────────────┘

  AC_1_1_1≜⟨
    task:"task-1.1.1",
    criteria:[
      ⟨id:"AC-1.1.1-A",
       predicate:FileExists("migrations/036_families_enhanced.sql"),
       priority:P0,automated:⊤,test_type:unit⟩,

      ⟨id:"AC-1.1.1-B",
       predicate:FileContains("migrations/036_families_enhanced.sql",
                              "CREATE TABLE families"),
       priority:P0,automated:⊤,test_type:unit⟩,

      ⟨id:"AC-1.1.1-C",
       predicate:FileContains("migrations/036_families_enhanced.sql",
                              "ENABLE ROW LEVEL SECURITY"),
       priority:P0,automated:⊤,test_type:unit⟩,

      ⟨id:"AC-1.1.1-D",
       predicate:CommandSucceeds("sqlx migrate run"),
       priority:P0,automated:⊤,test_type:integration⟩,

      ⟨id:"AC-1.1.1-E",
       predicate:DatabaseQuery(
         "SELECT column_name FROM information_schema.columns WHERE table_name='families'",
         ["id","name","type","privacy","invite_code","created_by","created_at"]
       ),
       priority:P1,automated:⊤,test_type:integration⟩
    ]
  ⟩

  ;; Task complete iff all P0 criteria pass
  complete(task-1.1.1)⇔∀c∈AC_1_1_1.criteria:c.priority≡P0⇒c.result≡passed

  ;; ┌─────────────────────────────────────────────────────────────┐
  ;; │ API ENDPOINT TASKS                                           │
  ;; │ task-1.2.1: Create family handler                            │
  ;; └─────────────────────────────────────────────────────────────┘

  AC_1_2_1≜⟨
    task:"task-1.2.1",
    criteria:[
      ⟨id:"AC-1.2.1-A",
       predicate:FileExists("src/handlers/family.rs"),
       priority:P0,automated:⊤,test_type:unit⟩,

      ⟨id:"AC-1.2.1-B",
       predicate:FileContains("src/handlers/family.rs","pub async fn create_family"),
       priority:P0,automated:⊤,test_type:unit⟩,

      ⟨id:"AC-1.2.1-C",
       predicate:HTTPStatus(POST,"/api/family",201),
       given:⟨auth:valid_jwt,body:valid_create_request⟩,
       priority:P0,automated:⊤,test_type:integration⟩,

      ⟨id:"AC-1.2.1-D",
       predicate:HTTPStatus(POST,"/api/family",400),
       given:⟨auth:valid_jwt,body:⟨name:""⟩⟩,  ;; Empty name
       priority:P0,automated:⊤,test_type:integration⟩,

      ⟨id:"AC-1.2.1-E",
       predicate:HTTPStatus(POST,"/api/family",401),
       given:⟨auth:none⟩,
       priority:P0,automated:⊤,test_type:integration⟩,

      ⟨id:"AC-1.2.1-F",
       predicate:HTTPResponse(POST,"/api/family",
         ⟨id:UUID,name:𝕊,type:FamilyType,inviteCode:InviteCode⟩),
       given:⟨auth:valid_jwt,body:valid_create_request⟩,
       priority:P1,automated:⊤,test_type:integration⟩
    ]
  ⟩

  ;; ┌─────────────────────────────────────────────────────────────┐
  ;; │ FRONTEND UI TASKS                                            │
  ;; │ task-1.3.1: Family create form                               │
  ;; └─────────────────────────────────────────────────────────────┘

  AC_1_3_1≜⟨
    task:"task-1.3.1",
    criteria:[
      ⟨id:"AC-1.3.1-A",
       predicate:FileExists("src/pages/FamilyCreatePage.tsx"),
       priority:P0,automated:⊤,test_type:unit⟩,

      ⟨id:"AC-1.3.1-B",
       predicate:UIElement("[data-testid='family-name-input']",visible),
       given:⟨route:"/family/create",auth:authenticated⟩,
       priority:P0,automated:⊤,test_type:e2e⟩,

      ⟨id:"AC-1.3.1-C",
       predicate:UIElement("[data-testid='family-type-select']",visible),
       given:⟨route:"/family/create",auth:authenticated⟩,
       priority:P0,automated:⊤,test_type:e2e⟩,

      ⟨id:"AC-1.3.1-D",
       predicate:UIElement("[data-testid='submit-button']",enabled),
       given:⟨route:"/family/create",auth:authenticated,
              form:⟨name:"Test Family",type:"Core"⟩⟩,
       priority:P0,automated:⊤,test_type:e2e⟩,

      ⟨id:"AC-1.3.1-E",
       predicate:UIElement("[data-testid='submit-button']",disabled),
       given:⟨route:"/family/create",auth:authenticated,
              form:⟨name:"",type:""⟩⟩,
       priority:P1,automated:⊤,test_type:e2e⟩,

      ⟨id:"AC-1.3.1-F",
       predicate:And(
         UIElement("[data-testid='error-message']",visible),
         UIElement("[data-testid='error-message']",contains:"at least 3")
       ),
       given:⟨route:"/family/create",auth:authenticated,
              form:⟨name:"AB"⟩,action:submit⟩,
       priority:P0,automated:⊤,test_type:e2e⟩,

      ;; Senior-friendly: button size >= 44x44
      ⟨id:"AC-1.3.1-G",
       predicate:UIElement("[data-testid='submit-button']",
                          minWidth:44,minHeight:44),
       priority:P1,automated:⊤,test_type:e2e⟩
    ]
  ⟩

  ;; ┌─────────────────────────────────────────────────────────────┐
  ;; │ E2E FLOW TASKS                                               │
  ;; │ task-1.4.1: Complete family creation flow                    │
  ;; └─────────────────────────────────────────────────────────────┘

  AC_1_4_1≜⟨
    task:"task-1.4.1",
    criteria:[
      ⟨id:"AC-1.4.1-A",
       predicate:Sequence([
         Navigate("/"),
         Click("Create Family"),
         Fill("family-name-input","Smith Family"),
         Select("family-type-select","Core"),
         Click("submit-button"),
         WaitFor(UIElement("[data-testid='invite-code']",visible)),
         Assert(URLContains("/invite"))
       ]),
       priority:P0,automated:⊤,test_type:e2e⟩,

      ;; Complete flow in < 3 clicks
      ⟨id:"AC-1.4.1-B",
       predicate:ClickCount("dashboard→invite_code_visible")≤3,
       priority:P0,automated:⊤,test_type:e2e⟩,

      ;; Senior can complete in < 5 minutes
      ⟨id:"AC-1.4.1-C",
       predicate:FlowDuration("family_creation")≤300000,  ;; 5 min in ms
       priority:P1,automated:⊥,test_type:manual⟩
    ]
  ⟩
}

;; ─── Γ: SPRINT ACCEPTANCE ───

⟦Γ:SprintCriteria⟧{
  ;; ┌─────────────────────────────────────────────────────────────┐
  ;; │ SPRINT 1.1: Database Schema                                  │
  ;; └─────────────────────────────────────────────────────────────┘

  sprint_1_1_complete⇔
    complete(task-1.1.1)∧
    complete(task-1.1.2)∧
    complete(task-1.1.3)∧
    complete(task-1.1.4)

  ;; ┌─────────────────────────────────────────────────────────────┐
  ;; │ SPRINT 1.2: Backend API                                      │
  ;; └─────────────────────────────────────────────────────────────┘

  sprint_1_2_complete⇔
    complete(task-1.2.1)∧
    complete(task-1.2.2)∧
    complete(task-1.2.3)∧
    complete(task-1.2.4)

  ;; ┌─────────────────────────────────────────────────────────────┐
  ;; │ PHASE 1: Family Creation Page                                │
  ;; └─────────────────────────────────────────────────────────────┘

  phase_1_complete⇔
    sprint_1_1_complete∧
    sprint_1_2_complete∧
    sprint_1_3_complete∧
    sprint_1_4_complete
}

;; ─── Λ: TEST GENERATION ───

⟦Λ:TestGeneration⟧{
  ;; ┌─────────────────────────────────────────────────────────────┐
  ;; │ PREDICATE → VITEST CODE                                      │
  ;; └─────────────────────────────────────────────────────────────┘

  toVitest:Criterion→𝕊
  toVitest≜λc.case[
    FileExists(path) →
      "it('"⧺c.id⧺"', () => { expect(fs.existsSync('"⧺path⧺"')).toBe(true); })",

    FileContains(path,content) →
      "it('"⧺c.id⧺"', () => { const f = fs.readFileSync('"⧺path⧺"','utf8'); expect(f).toContain('"⧺content⧺"'); })",

    CommandSucceeds(cmd) →
      "it('"⧺c.id⧺"', async () => { const r = await exec('"⧺cmd⧺"'); expect(r.exitCode).toBe(0); })",

    HTTPStatus(method,path,status) →
      "it('"⧺c.id⧺"', async () => { const r = await api."⧺method⧺"('"⧺path⧺"'); expect(r.status).toBe("⧺status⧺"); })"
  ]

  ;; ┌─────────────────────────────────────────────────────────────┐
  ;; │ PREDICATE → PLAYWRIGHT CODE                                  │
  ;; └─────────────────────────────────────────────────────────────┘

  toPlaywright:Criterion→𝕊
  toPlaywright≜λc.case[
    UIElement(selector,visible) →
      "test('"⧺c.id⧺"', async ({ page }) => { await expect(page.locator('"⧺selector⧺"')).toBeVisible(); })",

    UIElement(selector,disabled) →
      "test('"⧺c.id⧺"', async ({ page }) => { await expect(page.locator('"⧺selector⧺"')).toBeDisabled(); })",

    Sequence(steps) →
      "test('"⧺c.id⧺"', async ({ page }) => {\n"⧺
      join("\n",map(toStep,steps))⧺
      "\n});"
  ]

  toStep:Step→𝕊
  toStep≜λs.case[
    Navigate(url)          → "  await page.goto('"⧺url⧺"');",
    Click(target)          → "  await page.click('[data-testid=\""⧺target⧺"\"]');",
    Fill(field,value)      → "  await page.fill('[data-testid=\""⧺field⧺"\"]', '"⧺value⧺"');",
    Select(field,option)   → "  await page.selectOption('[data-testid=\""⧺field⧺"\"]', '"⧺option⧺"');",
    WaitFor(pred)          → "  await expect(page.locator('"⧺pred.selector⧺"')).toBeVisible();",
    Assert(URLContains(s)) → "  expect(page.url()).toContain('"⧺s⧺"');"
  ]
}

;; ─── Γ: COVERAGE REQUIREMENTS ───

⟦Γ:Coverage⟧{
  ;; Every task must have at least one P0 criterion
  ∀t:Task:∃c:Criterion:c.task≡t∧c.priority≡P0

  ;; All P0 criteria must be automated
  ∀c:Criterion:c.priority≡P0⇒c.automated≡⊤

  ;; E2E tests must cover happy path
  ∀phase:Phase:∃c:Criterion:c.test_type≡e2e∧c.predicate∈Sequence

  ;; Senior-friendly criteria for UI tasks
  ∀t:Task:t.type≡frontend⇒
    ∃c:Criterion:c.task≡t∧c.predicate.minWidth≥44
}

;; ─── Ε: EVIDENCE ───

⟦Ε⟧⟨
  δ≜0.84
  φ≜100
  τ≜◊⁺⁺
  ⊢Tasks:{{TASK_COUNT}}/{{TASK_COUNT}}
  ⊢Criteria:{{CRITERIA_COUNT}}
  ⊢P0_automated:100%
  ⊢Coverage:all_tasks_covered
  ⊢Ambig(D)<0.02
⟩

;; ═══════════════════════════════════════════════════════════════════════════
;; USAGE
