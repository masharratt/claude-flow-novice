{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Claude Flow Novice Configuration",
    "type": "object",
    "properties": {
        "redis": {
            "type": "object",
            "properties": {
                "host": {"type": "string", "default": "localhost"},
                "port": {"type": "number", "default": 6379},
                "password": {"type": "string"}
            },
            "required": ["host", "port"]
        },
        "agent": {
            "type": "object",
            "properties": {
                "default_strategy": {"type": "string", "default": "development"},
                "max_concurrent_agents": {"type": "number", "default": 5},
                "log_level": {"type": "string", "enum": ["debug", "info", "warn", "error"], "default": "info"}
            }
        },
        "security": {
            "type": "object",
            "properties": {
                "enabled": {"type": "boolean", "default": true},
                "max_retry_attempts": {"type": "number", "default": 3}
            }
        }
    },
    "required": ["redis", "agent"]
}