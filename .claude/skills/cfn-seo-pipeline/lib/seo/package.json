{
  "name": "@cfn/seo-research-service",
  "version": "1.0.0",
  "description": "SEO Intelligence ResearchService - Phase 1 Sprint 1",
  "main": "dist/lib/index.js",
  "types": "dist/lib/index.d.ts",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "build:watch": "tsc --project tsconfig.json --watch",
    "build:incremental": "tsc --project tsconfig.json --incremental",
    "check-types": "tsc --noEmit --project tsconfig.json",
    "dev": "tsc --watch",
    "example": "ts-node lib/example-usage.ts",
    "pipeline": "ts-node scripts/run-pipeline.ts",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "jest",
    "test:unit": "jest --testPathPattern=lib/__tests__",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "tsc --noEmit",
    "verify": "npm run check-types && npm run test"
  },
  "keywords": [
    "seo",
    "research",
    "serp",
    "content-analysis",
    "rate-limiting",
    "caching"
  ],
  "author": "CFN SEO Team",
  "license": "MIT",
  "dependencies": {
    "cheerio": "^1.0.0-rc.12",
    "ioredis": "^5.3.2",
    "js-yaml": "^4.1.1"
  },
  "devDependencies": {
    "@types/cheerio": "^0.22.35",
    "@types/jest": "^29.5.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
