{
  "tier": "fast",
  "version": "1.1.2",
  "description": "Single fixed profile for cfn-megaplan-fast. Not a tier: caps + agents + models are canonical constants read by check-size.sh and the orchestrator. Program mode: shared phases once, per-part only test_plan + write_plan + bars.",
  "bars": { "verifiable_done": "full", "haiku_executable": "static" },
  "floor": ["rls", "auth_boundaries", "secrets_handling", "no_unscoped_delete", "pii_if_present"],
  "caps": {
    "SPEC": 24576, "DECISIONS": 8192, "DATA": 40960, "ARCH": 49152, "UX": 32768,
    "REVIEW": 16384, "TEST": 24576, "PLAN": 40960, "VERIFY": 40960,
    "PSEUDO": 16384, "DESIGN": 16384, "OPS": 16384, "RESEARCH": 16384, "MEGAPLANFAST": 16384, "PARTSPEC": 16384
  },
  "part_specs": { "mode": "auto", "auto_min_parts": 3, "auto_min_extract_bytes": 3072, "_note": "auto = on when parts >= auto_min_parts OR any part's SPEC extract < auto_min_extract_bytes. on/off via --part-specs. One sonnet PARTSPEC per part, parallel, before L2." },
  "loop": { "bar_rounds": 1, "inline_patch_max_lines": 8, "repair_spawn_max": 1, "compress_spawn_max": 1 },
  "no_nested_spawns": true,
  "phases": {
    "spec":        { "scope": "program", "level": 1, "agent": "specification-agent", "model": "opus",   "folds": ["decide:blocking_only", "research:inline_if_unknowns", "floor_checklist", "part_ownership"] },
    "part_spec":   { "scope": "part",    "level": 1, "agent": "specification-agent", "model": "sonnet", "condition": "part_specs", "sublevel": "1b", "drops": ["build_flags", "part_ownership", "floor_checklist", "actor_inventory"] },
    "data":        { "scope": "program", "level": 2, "agent": "database-architect",  "model": "sonnet", "condition": "db", "drops": ["lifecycle", "multi_tenancy"] },
    "arch":        { "scope": "program", "level": 3, "agent": "system-architect",    "model": "opus",   "folds": ["pseudo"], "drops": ["error_taxonomy"] },
    "ux":          { "scope": "program", "level": 3, "agent": "ui-designer",         "model": "sonnet", "condition": "frontend", "folds": ["design"], "gate": "wireframe" },
    "plan_review": { "scope": "program", "level": 4, "agent": "general-purpose",     "model": "sonnet", "drops": ["plan_judge", "compliance", "full_alpha_readiness"] },
    "test_plan":   { "scope": "part",    "level": 5, "agent": "tester",              "model": "sonnet", "drops": ["load", "soak", "viewport_matrix", "migration_rehearsal"] },
    "write_plan":  { "scope": "part",    "level": 6, "agent": "general-purpose",     "model": "sonnet", "bar": "A", "drops": ["estimation", "risk_register"] },
    "bar_b":       { "scope": "part",    "level": 7, "agent": "none",                "model": "none",   "static_only": true }
  }
}
