{
  "name": "@cfn/error-logging",
  "version": "2.0.0",
  "description": "Comprehensive error logging and diagnostics system for CFN Loop",
  "main": "dist/error-logger.js",
  "types": "dist/types.d.ts",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "build:watch": "tsc --project tsconfig.json --watch",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --collectCoverageFrom='src/**/*.ts'",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "type-check": "tsc --noEmit --project tsconfig.json",
    "type-coverage": "type-coverage --at-least 90",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts'",
    "clean": "rm -rf dist coverage *.tsbuildinfo"
  },
  "keywords": [
    "cfn",
    "error-logging",
    "diagnostics",
    "error-handling",
    "logging"
  ],
  "author": "Claude Flow Team",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.40.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "ioredis": "^5.3.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
