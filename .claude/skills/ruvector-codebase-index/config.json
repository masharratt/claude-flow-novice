{
  "indexableExtensions": [
    ".ts",
    ".tsx",
    ".js",
    ".jsx",
    ".py",
    ".rs",
    ".go",
    ".java",
    ".c",
    ".cpp",
    ".h",
    ".hpp",
    ".cs",
    ".rb",
    ".php",
    ".swift",
    ".kt",
    ".sh",
    ".bash",
    ".md"
  ],
  "ignorePatterns": [
    "node_modules/**",
    "dist/**",
    "build/**",
    ".git/**",
    "coverage/**",
    ".next/**",
    ".artifacts/**",
    ".archive/**",
    ".backups/**",
    "legacy/**",
    "tmp/**",
    "temp/**",
    "tests/archive/**",
    "packages/*/node_modules/**",
    "*.min.js",
    "*.bundle.js",
    "*.map",
    ".env*",
    "package-lock.json",
    "yarn.lock",
    "pnpm-lock.yaml"
  ],
  "maxFileSize": 1048576,
  "embeddingModel": "text-embedding-3-small",
  "embeddingDimensions": 1536,
  "batchSize": 100,
  "ruvectorDbPath": "./docker/trigger-dev/data"
}
