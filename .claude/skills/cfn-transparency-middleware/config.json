{
  "transparency_level": "Detailed",
  "performance_monitoring": true,
  "context_filtering": true,
  "message_filtering": true,
  "max_overhead_percent": 5.0,
  "queue_size": 1000,
  "flush_interval_ms": 5000,
  "exclude_patterns": [
    "password",
    "token",
    "secret",
    "key",
    "api_key",
    "private_key"
  ],
  "include_patterns": [],
  "database_path": "./transparency-middleware.db",
  "export_formats": [
    "Json",
    "Csv"
  ]
}