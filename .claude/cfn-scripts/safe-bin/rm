#!/usr/bin/env bash
# safe-bin/rm: GNU rm wrapper that refuses catastrophic targets, for EVERY
# process that finds rm on PATH (scripts, tests, child processes), not just the
# command text the AI types (that is cfn-careful-guard.sh's job).
#
# Incident 2026-11-23 ~14:42Z (MDTWII): a test's mktemp failed, T was empty,
# cleanup ran rm -rf "$T/home" "$T/tmp" = rm -rf /home /tmp (~98 GB lost).
#
# Refuses (exit 1, one stderr line per bad operand, NOTHING deleted for any
# operand) when an operand, made absolute without following its last
# component (a symlink operand removes only the link; a trailing slash follows
# it), is:
#   - empty, /, any top-level dir (/home, /tmp, /usr, /mnt...), or /mnt/<x>
#   - a Windows home folder: /mnt/<x>/Users or /mnt/<x>/Users/<name>
#   - a home, an ancestor of one, or a direct child of one (~/.cache ...).
#     "Home" is BOTH the account's real home (getent passwd, so unsetting or
#     changing HOME does not switch the guard off) and $HOME when set.
#   - any git repo root (a dir holding a .git DIRECTORY), anywhere; a linked
#     worktree (.git FILE) stays deletable, cleanup tools remove those.
#     Also the .git of a repo directly under ~/projects.
#   - a path listed in <home>/.config/cfn-rm-protect.conf or the committed default
#     .claude/cfn-config/rm-protect.default (one absolute or ~/ path per line,
#     # comments), or an ancestor of one
# Otherwise execs the next rm on PATH after this wrapper's own dir (fallback
# /bin/rm) with the arguments unchanged. CFN_SAFE_RM_HOP is set before that
# exec; a wrapper that starts with it already set (a second copy of the
# wrapper further down PATH) still runs every check, then execs /bin/rm or
# /usr/bin/rm directly, so two copies cannot hand off to each other forever.
# The marker only picks which real rm runs; it never skips a check.
# Not handled: POSIXLY_CORRECT (GNU rm then stops option parsing at the first
# operand, so a later "-x" is an operand); this wrapper always treats a later
# "-x" as an option, which can only skip checking an odd file named like one.
#
# There is deliberately NO environment-variable escape hatch (an AI would set
# it). A human who really means it types /bin/rm by hand.
# Installed by: hooks/cfn-safe-rm-path.sh (Claude Code Bash tool, via
# CLAUDE_ENV_FILE) and cfn-tmux-agents spawn (pane PATH).
# The rules themselves live in ../lib/path-guard.sh (shared with cfn-test-box.sh).
# Absolute /bin/rm, find -delete, git clean, shutil.rmtree and other deleters
# bypass this wrapper; run builder tests inside cfn-test-box.sh (read-only
# home, private /tmp) to stop those too.
set -u

SELF="${BASH_SOURCE[0]}"
SELF_DIR=$(cd -P "$(dirname "$SELF")" 2>/dev/null && pwd -P) || SELF_DIR=""

die_refuse() { # args: path reason
    printf 'cfn-safe-rm: refused %q: %s. Nothing was deleted. (A person can run /bin/rm by hand.)\n' "$1" "$2" >&2
}

# --- collect operands (GNU rm permutes options; -- ends them) ---
ops=() dashdash=0
for a in "$@"; do
    if [ "$dashdash" = 1 ]; then ops+=("$a"); continue; fi
    case "$a" in
        --) dashdash=1 ;;
        -?*) ;;
        *) ops+=("$a") ;;
    esac
done

# The refusal rules live in lib/path-guard.sh (shared with cfn-test-box.sh).
# Missing lib: refuse every delete rather than run unguarded.
# shellcheck source=/dev/null
if [ -z "$SELF_DIR" ] || ! source "$SELF_DIR/../lib/path-guard.sh" 2>/dev/null; then
    echo "cfn-safe-rm: cannot load $SELF_DIR/../lib/path-guard.sh; refusing to delete anything. (A person can run /bin/rm by hand.)" >&2
    exit 1
fi

refuse=0
if [ "${#ops[@]}" -gt 0 ]; then
    # Absolute path of each operand: parent resolved (realpath -m), last
    # component kept, except ., .., and a trailing slash, which follow.
    abs=() parents=() idx=()
    for i in "${!ops[@]}"; do
        p="${ops[$i]}"
        if [ -z "$p" ]; then die_refuse "$p" "empty path (an unset variable?)"; refuse=1; abs+=(""); continue; fi
        case "$p" in /*) ;; *) p="$PWD/$p" ;; esac
        base="${p##*/}"
        case "$p" in
            */|*/.|*/..) abs+=("FOLLOW"); parents+=("$p"); idx+=("$i") ;;
            *) abs+=("BASE:$base"); parents+=("${p%/*}"); idx+=("$i") ;;
        esac
    done
    if [ "${#parents[@]}" -gt 0 ]; then
        mapfile -d '' -t resolved < <(realpath -m -z -- "${parents[@]}" 2>/dev/null)
        # realpath -m of "" (parent of /x) is an error: map empty parent to /
        if [ "${#resolved[@]}" -ne "${#parents[@]}" ]; then
            resolved=()
            for q in "${parents[@]}"; do
                if [ -z "$q" ]; then resolved+=("/"); else resolved+=("$(realpath -m -- "$q")"); fi
            done
        fi
        for k in "${!idx[@]}"; do
            i="${idx[$k]}"; r="${resolved[$k]}"
            case "${abs[$i]}" in
                FOLLOW) abs[i]="$r" ;;
                BASE:*) b="${abs[$i]#BASE:}"; if [ "$r" = / ]; then abs[i]="/$b"; else abs[i]="$r/$b"; fi ;;
            esac
        done
    fi

    for i in "${!ops[@]}"; do
        a="${abs[$i]}"
        [ -n "$a" ] || continue   # empty: already refused
        cfn_path_guard_check "$a" || { die_refuse "${ops[$i]}" "$CFN_PG_WHY"; refuse=1; }
    done
fi
[ "$refuse" = 0 ] || exit 1

# --- find the real rm: first 'rm' on PATH outside this wrapper's dir ---
if [ -n "${CFN_SAFE_RM_HOP:-}" ]; then
    # A wrapper already ran the checks and handed off to us: go straight to
    # the system rm so two wrapper copies on PATH cannot loop.
    for real in /bin/rm /usr/bin/rm; do [ -x "$real" ] && exec "$real" "$@"; done
    echo "cfn-safe-rm: no /bin/rm or /usr/bin/rm" >&2; exit 1
fi
export CFN_SAFE_RM_HOP=1
real=""
IFS=: read -r -a pdirs <<<"${PATH:-}"
for d in "${pdirs[@]}"; do
    [ -n "$d" ] || continue
    [ -x "$d/rm" ] && [ -f "$d/rm" ] || continue
    dr=$(cd -P "$d" 2>/dev/null && pwd -P) || continue
    [ "$dr" = "$SELF_DIR" ] && continue
    cand=$(realpath -- "$d/rm" 2>/dev/null) || continue
    [ "$cand" = "$SELF_DIR/rm" ] && continue
    real="$d/rm"; break
done
[ -n "$real" ] || real=/bin/rm
exec "$real" "$@"
