{
  "version": "4.0.0",
  "host": "localhost",
  "port": 6379,
  "db": 0,
  "retryPolicy": {
    "enabled": true,
    "maxRetries": 3,
    "retryDelay": 5000,
    "exponentialBackoff": true,
    "dlq": {
      "enabled": true,
      "ttl": 604800
    }
  },
  "waitingMode": {
    "defaultTimeout": 300000,
    "wakeChannelPattern": "task:{taskId}:agent:{agentId}:wake",
    "resultKeyPattern": "task:{taskId}:agent:{agentId}:result",
    "consensusThreshold": 0.90
  },
  "heartbeat": {
    "enabled": true,
    "ttl": 60,
    "checkInterval": 30,
    "missThreshold": 2,
    "agentMonitorKey": "swarm:agent:{agentId}:heartbeat",
    "fallbackStrategy": "quorum_recalculation"
  },
  "patterns": {
    "chain": { "enabled": true },
    "hierarchical": { "enabled": true },
    "mesh": { "enabled": true }
  },
  "metrics": {
    "enabled": true,
    "retention": 604800,
    "export_formats": ["json", "prometheus"]
  },
  "features": {
    "enableRetry": true,
    "enableQuorum": false,
    "enablePriorityWake": {
      "default": false,
      "description": "Enable priority-based wake mechanism",
      "stage": "experimental",
      "rollout_percentage": 10
    },
    "enableHeartbeat": true,
    "enableMetrics": true
  },
  "priorityWakeSettings": {
    "priorityMultiplier": 1000000,
    "priorityLevels": {
      "critical": {"range": [0, 10], "description": "Product Owner, System Coordinators"},
      "high": {"range": [11, 30], "description": "Loop 2 Validators"},
      "medium": {"range": [31, 60], "description": "Loop 3 Implementers"},
      "low": {"range": [61, 100], "description": "Background Tasks"}
    }
  }
}