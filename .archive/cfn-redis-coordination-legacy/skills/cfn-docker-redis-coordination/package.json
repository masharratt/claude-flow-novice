{
  "name": "@cfn/docker-redis-coordination",
  "version": "1.0.0",
  "description": "Type-safe Redis coordination for CFN Loop task and agent orchestration",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --coverageThreshold='{\"lines\": 90, \"functions\": 90, \"branches\": 85, \"statements\": 90}'",
    "lint": "eslint src tests --ext .ts",
    "clean": "rm -rf dist coverage"
  },
  "keywords": [
    "cfn-loop",
    "redis",
    "coordination",
    "task-orchestration",
    "agent-management"
  ],
  "author": "CFN Team",
  "license": "MIT",
  "dependencies": {
    "ioredis": "^5.3.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
