# CFN Orchestrator - Docker-Native Coordination
FROM node:18-alpine

# Install system dependencies
RUN apk add --no-cache \
    bash \
    curl \
    jq \
    redis-tools \
    && rm -rf /var/cache/apk

# Create non-root user
RUN addgroup -g 1001 -S cfn && \
    adduser -S cfn -u 1001 -G cfn

# Set working directory
WORKDIR /app

# Copy package files
COPY package*.json ./
RUN npm ci --only=production && npm cache clean --force

# Install CLI globally
RUN npm install -g .

# Create orchestrator entrypoint
RUN cat > /app/orchestrator-entrypoint.sh << 'EOF'
#!/bin/bash

# Source container mode detection
source /app/container-mode-detection.sh

# Set orchestrator-specific Node.js options
export NODE_OPTIONS="--max-old-space-size=8192"
export CFN_MODE=orchestrator
export CFN_DOCKER_CONTAINER=true

# Ensure Redis connectivity
echo "🔗 Checking Redis connection..."
if ! redis-cli -u "${CFN_REDIS_URL:-redis://redis:6379}" ping; then
    echo "❌ Redis connection failed"
    exit 1
fi

echo "✅ Redis connected successfully"

# Execute orchestrator
exec npx claude-flow-novice orchestrator "$@"
EOF

RUN chmod +x /app/orchestrator-entrypoint.sh

# Switch to non-root user
USER cfn

# Environment variables for orchestrator
ENV NODE_ENV=production
ENV CFN_DOCKER_CONTAINER=true
ENV CFN_MODE=orchestrator

# Use orchestrator entrypoint
ENTRYPOINT ["/app/orchestrator-entrypoint.sh"]

# Default command
CMD ["--help"]