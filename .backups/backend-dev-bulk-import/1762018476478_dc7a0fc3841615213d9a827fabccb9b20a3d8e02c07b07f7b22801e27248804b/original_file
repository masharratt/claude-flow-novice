#!/bin/bash
set -e

# cfn-changelog-management/bulk-import.sh
# Batch changelog imports with fuzzy deduplication and auto-squashing

# Default values
INPUT_FILE=""
AUTO_SQUASH=false
THRESHOLD=0.8
DRY_RUN=false

# Counters
PROCESSED=0
ADDED=0
SKIPPED=0
SQUASHED=0

# Temporary files for deduplication
ENTRIES_FILE="/tmp/bulk-import-entries-$$.txt"
SQUASH_GROUPS="/tmp/bulk-import-groups-$$.txt"

# Cleanup on exit
trap 'rm -f "$ENTRIES_FILE" "$SQUASH_GROUPS"' EXIT

# Parse arguments
while [[ $# -gt 0 ]]; do
  case $1 in
    --input)
      INPUT_FILE="$2"
      shift 2
      ;;
    --auto-squash)
      AUTO_SQUASH=true
      shift
      ;;
    --threshold)
      THRESHOLD="$2"
      shift 2
      ;;
    --dry-run)
      DRY_RUN=true
      shift
      ;;
    -h|--help)
      echo "Usage: bulk-import.sh --input FILE.csv [OPTIONS]"
      echo ""
      echo "Options:"
      echo "  --input FILE.csv       CSV file with changelog entries (required)"
      echo "  --auto-squash          Automatically squash similar entries (default: false)"
      echo "  --threshold 0.8        Similarity threshold 0.0-1.0 (default: 0.8)"
      echo "  --dry-run              Show what would be imported without making changes"
      echo ""
      echo "CSV Format:"
      echo "  date,type,summary,impact,files,issue,migration"
      echo ""
      echo "Example:"
      echo "  2025-10-15,bugfix,Fix typo in README,Improved documentation,README.md,,"
      exit 0
      ;;
    *)
      echo "Unknown argument: $1" >&2
      echo "Use --help for usage information" >&2
      exit 1
      ;;
  esac
done

# Validation
if [[ -z "$INPUT_FILE" ]]; then
  echo "Error: --input is required" >&2
  echo "Use --help for usage information" >&2
  exit 1
fi

if [[ ! -f "$INPUT_FILE" ]]; then
  echo "Error: Input file not found: $INPUT_FILE" >&2
  exit 1
fi

# Validate threshold
if ! [[ "$THRESHOLD" =~ ^0?\.[0-9]+$ ]] && ! [[ "$THRESHOLD" =~ ^1\.0$ ]]; then
  echo "Error: --threshold must be between 0.0 and 1.0 (got: $THRESHOLD)" >&2
  exit 1
fi

# Get total line count for progress reporting
TOTAL_LINES=$(wc -l < "$INPUT_FILE")
# Subtract header line
TOTAL_ENTRIES=$((TOTAL_LINES - 1))

if [[ $TOTAL_ENTRIES -le 0 ]]; then
  echo "Error: CSV file is empty or contains only header" >&2
  exit 1
fi

echo "Bulk Import: Processing $TOTAL_ENTRIES entries from $INPUT_FILE"
echo "Threshold: $THRESHOLD | Auto-squash: $AUTO_SQUASH | Dry-run: $DRY_RUN"
echo ""

# Word overlap similarity function
calculate_similarity() {
  local summary1="$1"
  local summary2="$2"

  # Convert to lowercase, split into words, sort
  local words1=$(echo "$summary1" | tr '[:upper:]' '[:lower:]' | tr -s '[:space:]' '\n' | sort -u)
  local words2=$(echo "$summary2" | tr '[:upper:]' '[:lower:]' | tr -s '[:space:]' '\n' | sort -u)

  # Count common words
  local common_count=$(comm -12 <(echo "$words1") <(echo "$words2") | wc -l)

  # Count total unique words
  local total_count=$(echo -e "$words1\n$words2" | sort -u | wc -l)

  # Avoid division by zero
  if [[ $total_count -eq 0 ]]; then
    echo "0.0"
    return
  fi

  # Calculate similarity (common / total)
  local similarity=$(awk -v common="$common_count" -v total="$total_count" 'BEGIN { printf "%.2f", common / total }')
  echo "$similarity"
}

# Check if entry already exists in CHANGELOG (exact match)
entry_exists() {
  local summary="$1"
  local changelog_file="readme/CHANGELOG.md"
  local project_root="/mnt/c/Users/masha/Documents/claude-flow-novice"

  grep -qF "$summary" "$project_root/$changelog_file"
}

# Find similar entries in current batch
find_similar_entries() {
  local summary="$1"
  local type="$2"
  local date="$3"
  local threshold="$4"

  # Search in entries file for similar summaries with same type
  if [[ ! -f "$ENTRIES_FILE" ]]; then
    return 0
  fi

  while IFS='|' read -r existing_date existing_type existing_summary existing_count; do
    # Only compare same type
    if [[ "$existing_type" != "$type" ]]; then
      continue
    fi

    # Calculate date proximity (within 7 days)
    local date1_epoch=$(date -d "$date" +%s 2>/dev/null || echo 0)
    local date2_epoch=$(date -d "$existing_date" +%s 2>/dev/null || echo 0)
    local date_diff=$(( (date1_epoch - date2_epoch) / 86400 ))
    date_diff=${date_diff#-}  # Absolute value

    if [[ $date_diff -le 7 ]]; then
      # Calculate similarity
      local similarity=$(calculate_similarity "$summary" "$existing_summary")

      # Check if above threshold
      if (( $(echo "$similarity >= $threshold" | bc -l) )); then
        # Return matching line
        echo "$existing_date|$existing_type|$existing_summary|$existing_count"
        return 0
      fi
    fi
  done < "$ENTRIES_FILE"

  return 1
}

# Initialize entries file
touch "$ENTRIES_FILE"

# Skip header line and process CSV (use process substitution to avoid subshell)
while IFS=',' read -r date type summary impact files issue migration; do
  PROCESSED=$((PROCESSED + 1))

  # Progress indicator (every 10%)
  if (( PROCESSED % (TOTAL_ENTRIES / 10 + 1) == 0 )); then
    echo "Progress: $PROCESSED / $TOTAL_ENTRIES entries processed..."
  fi

  # Validate required fields
  if [[ -z "$date" || -z "$type" || -z "$summary" || -z "$impact" ]]; then
    echo "⚠️  Skipping invalid entry (missing required fields): $summary"
    SKIPPED=$((SKIPPED + 1))
    continue
  fi

  # Check for exact duplicate in CHANGELOG
  if entry_exists "$summary"; then
    if [[ "$DRY_RUN" == true ]]; then
      echo "   [DRY-RUN] Would skip duplicate: $summary"
    fi
    SKIPPED=$((SKIPPED + 1))
    continue
  fi

  # Check for similar entries in current batch
  similar_entry=$(find_similar_entries "$summary" "$type" "$date" "$THRESHOLD")

  if [[ -n "$similar_entry" ]]; then
    # Extract existing count
    existing_count=$(echo "$similar_entry" | cut -d'|' -f4)
    existing_summary=$(echo "$similar_entry" | cut -d'|' -f3)

    if [[ "$AUTO_SQUASH" == true ]]; then
      # Auto-squash: increment count
      new_count=$((existing_count + 1))

      # Update entry in file
      sed -i "s|^.*|$existing_type|$existing_summary|.*$|$date|$type|$existing_summary|$new_count|" "$ENTRIES_FILE"

      if [[ "$DRY_RUN" == true ]]; then
        echo "   [DRY-RUN] Would squash similar entry: $summary (count: $new_count)"
      fi
      SQUASHED=$((SQUASHED + 1))
    else
      # Prompt user
      echo ""
      echo "Similar entry found:"
      echo "  Existing: $existing_summary"
      echo "  New:      $summary"
      echo "  Similarity: $(calculate_similarity "$summary" "$existing_summary")"
      echo ""
      read -p "Squash entries? [y/n]: " -n 1 -r
      echo ""

      if [[ $REPLY =~ ^[Yy]$ ]]; then
        new_count=$((existing_count + 1))
        sed -i "s|^.*|$existing_type|$existing_summary|.*$|$date|$type|$existing_summary|$new_count|" "$ENTRIES_FILE"
        SQUASHED=$((SQUASHED + 1))
      else
        # Add as separate entry
        echo "$date|$type|$summary|1" >> "$ENTRIES_FILE"
        ADDED=$((ADDED + 1))
      fi
    fi
  else
    # New unique entry
    echo "$date|$type|$summary|1" >> "$ENTRIES_FILE"
    ADDED=$((ADDED + 1))
  fi
done < <(tail -n +2 "$INPUT_FILE")

# Now process deduplicated entries and add to CHANGELOG
echo ""
echo "Importing deduplicated entries to CHANGELOG..."

while IFS='|' read -r date type summary count; do
  # Build final summary with count if squashed
  if [[ $count -gt 1 ]]; then
    final_summary="$summary ($count occurrences)"
  else
    final_summary="$summary"
  fi

  # Re-read original entry data for this summary
  original_entry=$(grep -F "$summary" "$INPUT_FILE" | head -1)
  IFS=',' read -r orig_date orig_type orig_summary orig_impact orig_files orig_issue orig_migration <<< "$original_entry"

  if [[ "$DRY_RUN" == true ]]; then
    echo "   [DRY-RUN] Would add: $final_summary ($date)"
  else
    # Call add-changelog-entry.sh
    args=(
      --type "$type"
      --summary "$final_summary"
      --impact "$orig_impact"
      --date "$date"
    )

    if [[ -n "$orig_files" ]]; then
      args+=(--files "$orig_files")
    fi

    if [[ -n "$orig_issue" ]]; then
      args+=(--issue "$orig_issue")
    fi

    if [[ -n "$orig_migration" ]]; then
      args+=(--migration "$orig_migration")
    fi

    # Execute add-changelog-entry.sh
    /mnt/c/Users/masha/Documents/claude-flow-novice/.claude/skills/cfn-changelog-management/add-changelog-entry.sh "${args[@]}" >/dev/null

    echo "✅ Added: $final_summary ($date)"
  fi
done < "$ENTRIES_FILE"

# Summary report
echo ""
echo "═══════════════════════════════════════════════════"
echo "Bulk Import Summary"
echo "═══════════════════════════════════════════════════"
echo "Processed:  $PROCESSED entries"
echo "Added:      $ADDED unique entries"
echo "Skipped:    $SKIPPED duplicates"
echo "Squashed:   $SQUASHED similar entries"
echo "═══════════════════════════════════════════════════"

if [[ "$DRY_RUN" == true ]]; then
  echo ""
  echo "ℹ️  DRY-RUN mode: No changes were made"
  echo "   Remove --dry-run flag to apply changes"
fi

exit 0
