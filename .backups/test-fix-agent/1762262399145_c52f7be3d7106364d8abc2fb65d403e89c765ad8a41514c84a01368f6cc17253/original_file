#!/bin/bash
# Comprehensive Test Suite for Rust Validators
# Tests rust-command-safety, rust-future-safety, and rust-dependency-checker validators

set -euo pipefail

# Test environment setup
VALIDATOR_DIR="/mnt/c/Users/masha/Documents/claude-flow-novice/.claude/skills/hook-pipeline"
TEST_DIR="/tmp/rust-validator-tests-$$"
PASSED=0
FAILED=0

# Color codes for output
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Setup test directory
setup_test_env() {
    mkdir -p "$TEST_DIR"
    echo "Test directory: $TEST_DIR"
}

# Cleanup test directory
cleanup() {
    rm -rf "$TEST_DIR"
}
trap cleanup EXIT

# Test result reporting
report_result() {
    local test_name="$1"
    local result="$2"
    local message="${3:-}"

    if [[ "$result" == "PASS" ]]; then
        echo -e "${GREEN}✓ PASSED${NC}: $test_name"
        PASSED=$((PASSED + 1))
    else
        echo -e "${RED}✗ FAILED${NC}: $test_name"
        if [[ -n "$message" ]]; then
            echo -e "  ${YELLOW}Reason: $message${NC}"
        fi
        FAILED=$((FAILED + 1))
    fi
}

# ============================================================================
# TEST 1: rust-command-safety detects Command::new without stderr
# ============================================================================
test_command_no_stderr() {
    local test_file="$TEST_DIR/command_no_stderr.rs"

    cat > "$test_file" <<'EOF'
use std::process::Command;

fn main() {
    // Command without stderr redirect
    let output = Command::new("ls")
        .arg("-la")
        .output()
        .expect("Failed to execute command");

    // Another Command without stderr handling
    let status = Command::new("cat")
        .arg("/tmp/file.txt")
        .status()
        .expect("Failed to run command");

    println!("Command executed");
}
EOF

    # Run validator
    local exit_code=0
    local output
    output=$("$VALIDATOR_DIR/rust-command-safety.sh" "$test_file" 2>&1) || exit_code=$?

    # Expected: Exit 2 (warning), output contains warning message
    if [[ $exit_code -eq 2 ]] && [[ "$output" =~ "Command" || "$output" =~ "stderr" ]]; then
        report_result "TEST 1: Command::new without stderr" "PASS"
    else
        report_result "TEST 1: Command::new without stderr" "FAIL" \
            "Expected exit 2 and warning, got exit $exit_code. Output: $output"
    fi
}

# ============================================================================
# TEST 2: rust-command-safety passes Command::new with stderr
# ============================================================================
test_command_with_stderr() {
    local test_file="$TEST_DIR/command_with_stderr.rs"

    cat > "$test_file" <<'EOF'
use std::process::{Command, Stdio};

fn main() {
    // Command with stderr redirect to pipe
    let output = Command::new("ls")
        .arg("-la")
        .stderr(Stdio::piped())
        .output()
        .expect("Failed to execute command");

    // Command with stderr redirect to null
    let status = Command::new("cat")
        .arg("/tmp/file.txt")
        .stderr(Stdio::null())
        .status()
        .expect("Failed to run command");

    // Command with stderr inherited
    let output2 = Command::new("pwd")
        .stderr(Stdio::inherit())
        .output()
        .expect("Failed to execute");

    println!("Commands executed safely");
}
EOF

    # Run validator
    local exit_code=0
    "$VALIDATOR_DIR/rust-command-safety.sh" "$test_file" 2>/dev/null || exit_code=$?

    # Expected: Exit 0 (pass)
    if [[ $exit_code -eq 0 ]]; then
        report_result "TEST 2: Command::new with stderr" "PASS"
    else
        report_result "TEST 2: Command::new with stderr" "FAIL" \
            "Expected exit 0, got exit $exit_code"
    fi
}

# ============================================================================
# TEST 3: rust-future-safety detects async fn call without .await
# ============================================================================
test_future_no_await() {
    local test_file="$TEST_DIR/future_no_await.rs"

    cat > "$test_file" <<'EOF'
use tokio::time::{sleep, Duration};

async fn fetch_data() -> String {
    sleep(Duration::from_secs(1)).await;
    "data".to_string()
}

async fn main_async() {
    // Async call without .await (creates future but doesn't poll)
    fetch_data();

    // Another async call without .await
    let _future = fetch_data();

    println!("Function executed");
}

#[tokio::main]
async fn main() {
    main_async().await;
}
EOF

    # Run validator
    local exit_code=0
    local output
    output=$("$VALIDATOR_DIR/rust-future-safety.sh" "$test_file" 2>&1) || exit_code=$?

    # Expected: Exit 2 (warning), output contains future/await warning
    if [[ $exit_code -eq 2 ]] && [[ "$output" =~ "async" || "$output" =~ "await" || "$output" =~ "future" ]]; then
        report_result "TEST 3: async fn without .await" "PASS"
    else
        report_result "TEST 3: async fn without .await" "FAIL" \
            "Expected exit 2 and warning, got exit $exit_code"
    fi
}

# ============================================================================
# TEST 4: rust-future-safety passes async fn call with .await
# ============================================================================
test_future_with_await() {
    local test_file="$TEST_DIR/future_with_await.rs"

    cat > "$test_file" <<'EOF'
use tokio::time::{sleep, Duration};

async fn fetch_data() -> String {
    sleep(Duration::from_secs(1)).await;
    "data".to_string()
}

async fn main_async() {
    // Properly awaited async call
    let data = fetch_data().await;
    println!("Data: {}", data);

    // Another properly awaited call
    let result = async {
        fetch_data().await
    }.await;

    // Using tokio::spawn (valid task spawn)
    let handle = tokio::spawn(async {
        fetch_data().await
    });

    handle.await.unwrap();
}

#[tokio::main]
async fn main() {
    main_async().await;
}
EOF

    # Run validator
    local exit_code=0
    "$VALIDATOR_DIR/rust-future-safety.sh" "$test_file" 2>/dev/null || exit_code=$?

    # Expected: Exit 0 (pass)
    if [[ $exit_code -eq 0 ]]; then
        report_result "TEST 4: async fn with .await" "PASS"
    else
        report_result "TEST 4: async fn with .await" "FAIL" \
            "Expected exit 0, got exit $exit_code"
    fi
}

# ============================================================================
# TEST 5: rust-dependency-checker catches missing crate
# ============================================================================
test_dependency_missing() {
    local test_file="$TEST_DIR/dependency_missing.rs"

    # Create test file WITHOUT Cargo.toml (simulates missing dependency)
    cat > "$test_file" <<'EOF'
// Using external crates without proper declaration

use serde::{Serialize, Deserialize};
use tokio::time::sleep;
use reqwest::Client;

#[derive(Serialize, Deserialize)]
struct Data {
    value: String,
}

async fn fetch() {
    let client = Client::new();
    let response = client.get("https://api.example.com").send().await;
}

fn main() {
    println!("Using external crates");
}
EOF

    # Run validator (no Cargo.toml to reference)
    local exit_code=0
    local output
    output=$("$VALIDATOR_DIR/rust-dependency-checker.sh" "$test_file" 2>&1) || exit_code=$?

    # Expected: Exit 2 (warning), output contains dependency warning
    if [[ $exit_code -eq 2 ]] && [[ "$output" =~ "dependency" || "$output" =~ "Cargo.toml" ]]; then
        report_result "TEST 5: missing crate dependency" "PASS"
    else
        report_result "TEST 5: missing crate dependency" "FAIL" \
            "Expected exit 2 and dependency warning, got exit $exit_code"
    fi
}

# ============================================================================
# TEST 6: rust-dependency-checker passes declared dependencies
# ============================================================================
test_dependency_valid() {
    local test_file="$TEST_DIR/dependency_valid.rs"
    local cargo_file="$TEST_DIR/Cargo.toml"

    # Create Cargo.toml with declared dependencies
    cat > "$cargo_file" <<'EOF'
[package]
name = "test-project"
version = "0.1.0"
edition = "2021"

[dependencies]
serde = { version = "1.0", features = ["derive"] }
tokio = { version = "1.0", features = ["full"] }
reqwest = { version = "0.11", features = ["json"] }
EOF

    # Create test file using declared dependencies
    cat > "$test_file" <<'EOF'
use serde::{Serialize, Deserialize};
use tokio::time::sleep;
use reqwest::Client;

#[derive(Serialize, Deserialize)]
struct Data {
    value: String,
}

async fn fetch() {
    let client = Client::new();
    let response = client.get("https://api.example.com").send().await;
}

fn main() {
    println!("Using declared dependencies");
}
EOF

    # Run validator
    local exit_code=0
    "$VALIDATOR_DIR/rust-dependency-checker.sh" "$test_file" 2>/dev/null || exit_code=$?

    # Expected: Exit 0 (pass)
    if [[ $exit_code -eq 0 ]]; then
        report_result "TEST 6: declared dependencies pass" "PASS"
    else
        report_result "TEST 6: declared dependencies pass" "FAIL" \
            "Expected exit 0, got exit $exit_code"
    fi
}

# ============================================================================
# Main Test Execution
# ============================================================================

echo "=========================================="
echo "Rust Validators Comprehensive Test Suite"
echo "=========================================="
echo ""

setup_test_env

echo "Running tests..."
echo ""

# Execute all tests
test_command_no_stderr
test_command_with_stderr
test_future_no_await
test_future_with_await
test_dependency_missing
test_dependency_valid

# Summary
echo ""
echo "=========================================="
echo "Test Summary"
echo "=========================================="
echo -e "${GREEN}Passed: $PASSED${NC}"
echo -e "${RED}Failed: $FAILED${NC}"
echo -e "Total:  $((PASSED + FAILED))"

# Exit with appropriate code
if [[ $FAILED -eq 0 ]]; then
    echo -e "\n${GREEN}All tests passed!${NC}"
    exit 0
else
    echo -e "\n${RED}Some tests failed!${NC}"
    exit 1
fi
