#!/bin/bash

##############################################################################
# Layer 8: Environment Sanitizer ulimit Validation
#
# Purpose: Test that environment sanitizer doesn't break fork with ulimit -u
#
# This test catches production bugs where:
# - Sanitizer sets ulimit -u to low values (like 50)
# - System has 200+ processes running (normal for multi-session environments)
# - Any fork attempt fails with "Resource temporarily unavailable"
#
# Test Scenario:
# 1. Save current ulimit settings
# 2. Source and run sanitizer in CLI mode
# 3. Verify ulimit -u was NOT reduced
# 4. Verify we can still fork processes
# 5. Test orchestrator invocation (real-world scenario)
##############################################################################

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

# Test configuration
TEST_NAME="Layer 8: ulimit Sanitizer Validation"
PASS_COUNT=0
FAIL_COUNT=0

echo "========================================="
echo "$TEST_NAME"
echo "========================================="
echo ""

##############################################################################
# Test Functions
##############################################################################

pass() {
    echo "✅ PASS: $1"
    ((PASS_COUNT++))
}

fail() {
    echo "❌ FAIL: $1"
    ((FAIL_COUNT++))
}

info() {
    echo "ℹ️  INFO: $1"
}

##############################################################################
# Test 1: Capture baseline ulimit
##############################################################################

echo "Test 1: Capture baseline ulimit settings"
echo "-----------------------------------------"

BASELINE_ULIMIT_U=$(ulimit -u)
BASELINE_PROCESS_COUNT=$(ps aux | wc -l)

info "Baseline ulimit -u: $BASELINE_ULIMIT_U"
info "Current process count: $BASELINE_PROCESS_COUNT"

if [[ "$BASELINE_ULIMIT_U" -gt 1000 ]]; then
    pass "Baseline ulimit is reasonable: $BASELINE_ULIMIT_U"
else
    fail "Baseline ulimit is too low: $BASELINE_ULIMIT_U (expected >1000)"
fi

echo ""

##############################################################################
# Test 2: Run sanitizer and verify ulimit not reduced
##############################################################################

echo "Test 2: Sanitizer preserves ulimit -u"
echo "--------------------------------------"

# Source sanitizer in a subshell to avoid trap/background process persistence
if [[ -f "$PROJECT_ROOT/.claude/skills/cfn-task-mode-sanitize/task-mode-env-sanitizer.sh" ]]; then
    AFTER_SANITIZE_ULIMIT_U=$(
        # Run sanitizer in subshell
        source "$PROJECT_ROOT/.claude/skills/cfn-task-mode-sanitize/task-mode-env-sanitizer.sh" 2>/dev/null || true
        sanitize_task_mode_environment cli 2>/dev/null || true

        # Kill background monitoring process (sleep spawned by sanitizer)
        pkill -P $$ sleep 2>/dev/null || true

        # Return ulimit value
        ulimit -u
    )

    info "After sanitizer ulimit -u: $AFTER_SANITIZE_ULIMIT_U"

    if [[ "$AFTER_SANITIZE_ULIMIT_U" -eq "$BASELINE_ULIMIT_U" ]]; then
        pass "Sanitizer preserved ulimit -u (unchanged)"
    elif [[ "$AFTER_SANITIZE_ULIMIT_U" -gt "$BASELINE_ULIMIT_U" ]]; then
        pass "Sanitizer increased ulimit -u (safe)"
    else
        fail "Sanitizer REDUCED ulimit -u from $BASELINE_ULIMIT_U to $AFTER_SANITIZE_ULIMIT_U (DANGEROUS)"
    fi
else
    fail "Sanitizer script not found"
fi

echo ""

##############################################################################
# Test 3: Verify fork still works after sanitizer
##############################################################################

echo "Test 3: Fork operations work after sanitizer"
echo "---------------------------------------------"

# Test multiple fork operations
FORK_SUCCESS=0
FORK_FAILURES=0

for i in {1..5}; do
    if pgrep -f "bash" >/dev/null 2>&1; then
        ((FORK_SUCCESS++))
    else
        ((FORK_FAILURES++))
    fi
done

info "Fork successes: $FORK_SUCCESS/5"
info "Fork failures: $FORK_FAILURES/5"

if [[ "$FORK_SUCCESS" -eq 5 ]]; then
    pass "All fork operations succeeded"
else
    fail "Fork operations failed ($FORK_FAILURES/5 failures)"
fi

echo ""

##############################################################################
# Test 4: Verify grep/pgrep/pkill work (common fork-heavy commands)
##############################################################################

echo "Test 4: Common fork-heavy commands work"
echo "----------------------------------------"

COMMAND_TESTS=0
COMMAND_PASSES=0

# Test grep
if echo "test" | grep "test" >/dev/null 2>&1; then
    ((COMMAND_PASSES++))
fi
((COMMAND_TESTS++))

# Test pgrep
if pgrep -f "bash" >/dev/null 2>&1; then
    ((COMMAND_PASSES++))
fi
((COMMAND_TESTS++))

# Test ps
if ps aux | head -1 >/dev/null 2>&1; then
    ((COMMAND_PASSES++))
fi
((COMMAND_TESTS++))

# Test find
if find /proc -maxdepth 1 -name "[0-9]*" 2>/dev/null | head -1 >/dev/null; then
    ((COMMAND_PASSES++))
fi
((COMMAND_TESTS++))

info "Command tests passed: $COMMAND_PASSES/$COMMAND_TESTS"

if [[ "$COMMAND_PASSES" -eq "$COMMAND_TESTS" ]]; then
    pass "All fork-heavy commands work"
else
    fail "Some fork-heavy commands failed ($((COMMAND_TESTS - COMMAND_PASSES))/$COMMAND_TESTS)"
fi

echo ""

##############################################################################
# Test 5: Realistic process chain fork (7 levels deep)
##############################################################################

echo "Test 5: Deep process chain fork test"
echo "-------------------------------------"

# Simulate realistic nested fork scenario (Main Chat → npx → node → agent → bash → script → pgrep)
DEEP_FORK_TEST=$(bash -c "bash -c \"bash -c \\\"bash -c 'bash -c \\\\\\\"bash -c \\\\\\\\\\\\\\\"pgrep -f bash >/dev/null 2>&1 && echo SUCCESS || echo FAIL\\\\\\\\\\\\\\\"\\\\\\\"'\\\"\"\"")

info "Deep fork result: $DEEP_FORK_TEST"

if [[ "$DEEP_FORK_TEST" == "SUCCESS" ]]; then
    pass "7-level deep fork chain succeeded"
else
    fail "7-level deep fork chain failed"
fi

echo ""

##############################################################################
# Test 6: Verify MAX_AGENT_PROCESSES not used for ulimit
##############################################################################

echo "Test 6: MAX_AGENT_PROCESSES not enforced via ulimit"
echo "----------------------------------------------------"

# Check if sanitizer script contains forbidden ulimit -u patterns
FORBIDDEN_PATTERNS=0

if grep -q "ulimit -u.*MAX_AGENT_PROCESSES" "$PROJECT_ROOT/.claude/skills/cfn-task-mode-sanitize/task-mode-env-sanitizer.sh" 2>/dev/null; then
    ((FORBIDDEN_PATTERNS++))
fi

if grep -q "ulimit -u \$MAX_AGENT_PROCESSES" "$PROJECT_ROOT/.claude/skills/cfn-task-mode-sanitize/task-mode-env-sanitizer.sh" 2>/dev/null; then
    ((FORBIDDEN_PATTERNS++))
fi

if [[ "$FORBIDDEN_PATTERNS" -eq 0 ]]; then
    pass "No forbidden ulimit -u MAX_AGENT_PROCESSES patterns found"
else
    fail "Found $FORBIDDEN_PATTERNS forbidden ulimit -u patterns"
fi

echo ""

##############################################################################
# Test 7: Process count tolerance (works even with many processes)
##############################################################################

echo "Test 7: Sanitizer works with high process counts"
echo "-------------------------------------------------"

CURRENT_PROCESS_COUNT=$(ps aux | wc -l)

info "Current process count: $CURRENT_PROCESS_COUNT"

# Sanitizer should work even with 200+ processes
if [[ "$CURRENT_PROCESS_COUNT" -gt 200 ]]; then
    info "High process count scenario (>200) - realistic test"

    # Try running sanitizer again in subshell
    if (source "$PROJECT_ROOT/.claude/skills/cfn-task-mode-sanitize/task-mode-env-sanitizer.sh" 2>/dev/null && sanitize_task_mode_environment cli 2>/dev/null); then
        pass "Sanitizer works with $CURRENT_PROCESS_COUNT processes"
        # Kill background monitoring from subshell
        pkill -P $$ sleep 2>/dev/null || true
    else
        fail "Sanitizer fails with high process count"
    fi
else
    info "Low process count scenario (<200) - may not catch production bugs"
    pass "Sanitizer works with $CURRENT_PROCESS_COUNT processes (warning: not realistic)"
fi

echo ""

##############################################################################
# Final Results
##############################################################################

echo "========================================="
echo "Test Results Summary"
echo "========================================="
echo "Total Passed: $PASS_COUNT"
echo "Total Failed: $FAIL_COUNT"
echo ""

if [[ "$FAIL_COUNT" -eq 0 ]]; then
    echo "✅ ALL TESTS PASSED"
    exit 0
else
    echo "❌ SOME TESTS FAILED"
    exit 1
fi
