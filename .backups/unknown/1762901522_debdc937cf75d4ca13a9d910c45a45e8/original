AGENT_CPU=$(docker stats --no-stream --format "{{.CPUPerc}}" "$CONTAINER_NAME")
AGENT_MEM_LIMIT=$(docker stats --no-stream --format "{{.MemUsage}}" "$CONTAINER_NAME" | cut -d'/' -f2)

echo "Agent Container Resource Usage:"
echo "Memory: $AGENT_MEMORY / $AGENT_MEM_LIMIT"
echo "CPU: $AGENT_CPU"

# Extract numeric value from memory (handle MiB/GiB units)
MEMORY_VALUE=$(echo "$AGENT_MEMORY" | sed 's/[^0-9.]//g')

# Cleanup
docker stop "$CONTAINER_NAME" >/dev/null 2>&1 || true
docker rm "$CONTAINER_NAME" >/dev/null 2>&1 || true

# Validate metrics are reasonable
if [[ "$AGENT_MEMORY" =~ ^[0-9] ]] && [[ "$AGENT_CPU" =~ ^[0-9] ]]; then
    # Check memory is reasonable (< 1GB for a sleep container)
    if [[ "$AGENT_MEMORY" =~ "MiB" ]] || [[ "$AGENT_MEMORY" =~ "KiB" ]]; then
        echo "Docker agent resource monitoring successful"
        exit 0
    elif [[ "$AGENT_MEMORY" =~ "GiB" ]]; then
        MEMORY_GB=$(echo "$MEMORY_VALUE" | cut -d'.' -f1)
        if [ "$MEMORY_GB" -lt 2 ]; then
            echo "Docker agent resource monitoring successful"
            exit 0
        fi
    fi
fi

echo "Docker agent resource monitoring failed - invalid or excessive metrics"
exit 1
EOF

