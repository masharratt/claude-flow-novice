#!/bin/bash
set -euo pipefail

# Test Docker agent resource monitoring
CONTAINER_NAME="cfn-test-agent-resource-$(date +%s)"

# Spawn agent container with some workload
docker run -d \
    --name "$CONTAINER_NAME" \
    --network cfn-loop-test-network \
