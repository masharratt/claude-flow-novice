sleep 2

# Publish message from publisher agent
PUBLISH_RESULT=$(docker exec "$PUBLISHER_NAME" redis-cli -h cfn-test-redis PUBLISH "$TEST_CHANNEL" "$TEST_MESSAGE" 2>&1)

# Wait for message delivery
sleep 2

# Check subscriber received message
SUBSCRIBER_LOG=$(docker exec "$SUBSCRIBER_NAME" cat /tmp/subscriber.log 2>/dev/null || echo "")

# Cleanup
docker stop "$SUBSCRIBER_NAME" "$PUBLISHER_NAME" >/dev/null 2>&1 || true
docker rm "$SUBSCRIBER_NAME" "$PUBLISHER_NAME" >/dev/null 2>&1 || true

if [[ "$SUBSCRIBER_LOG" =~ "$TEST_MESSAGE" ]] && [ "$PUBLISH_RESULT" -gt 0 ]; then
    echo "Docker agent broadcasting successful"
    exit 0
else
    echo "Docker agent broadcasting failed: PUBLISH_RESULT=$PUBLISH_RESULT"
    exit 1
fi
EOF

