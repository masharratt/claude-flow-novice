#!/bin/bash
# Docker Agent Initialization Script
# Handles Redis coordination data writing for containerized agents
set -euo pipefail

# Configuration from environment variables
REDIS_HOST="${REDIS_HOST:-redis}"
REDIS_PORT="${REDIS_PORT:-6379}"
TASK_ID="${TASK_ID:-unknown}"
AGENT_ID="${AGENT_ID:-docker-$(date +%s)-$$}"
AGENT_TYPE="${AGENT_TYPE:-unknown}"

# Coordination key patterns
SIGNAL_KEY="swarm:${TASK_ID}:${AGENT_ID}:signal"
COMPLETION_KEY="swarm:${TASK_ID}:${AGENT_ID}:done"

# Function to write signal key
write_signal() {
    local signal="$1"
    redis-cli -h "$REDIS_HOST" -p "$REDIS_PORT" SET "$SIGNAL_KEY" "$signal" EX 3600 >/dev/null 2>&1 || {
        echo "Warning: Failed to write signal key to Redis"
        return 1
    }
}

# Function to write completion data
write_completion() {
    local status="$1"
    local message="${2:-}"
    local confidence="${3:-0.85}"

    redis-cli -h "$REDIS_HOST" -p "$REDIS_PORT" \
        HSET "$COMPLETION_KEY" \
        "status" "$status" \
        "message" "$message" \
        "timestamp" "$(date -Iseconds)" \
        "confidence" "$confidence" \
        "agent_id" "$AGENT_ID" \
        "agent_type" "$AGENT_TYPE" >/dev/null 2>&1 || {
        echo "Warning: Failed to write completion data to Redis"
        return 1
    }

    # Set expiration on hash key
    redis-cli -h "$REDIS_HOST" -p "$REDIS_PORT" EXPIRE "$COMPLETION_KEY" 3600 >/dev/null 2>&1
}

# Initialize coordination data
echo "🐳 Docker Agent Initializing"
echo "Agent ID: $AGENT_ID"
echo "Agent Type: $AGENT_TYPE"
echo "Task ID: $TASK_ID"
echo "Redis: $REDIS_HOST:$REDIS_PORT"
echo ""

# Write spawn signal
if write_signal "spawned"; then
    echo "✅ Coordination signal written to Redis"
else
    echo "⚠️  Running without Redis coordination"
fi

# Export agent metadata for child processes
export AGENT_ID
export AGENT_TYPE
export TASK_ID
export REDIS_HOST
export REDIS_PORT

# Function to be called on exit
cleanup() {
    local exit_code=$?
    echo ""
    echo "🐳 Agent Shutting Down (exit code: $exit_code)"

    if [ $exit_code -eq 0 ]; then
        write_completion "complete" "Agent finished successfully" "0.90"
        write_signal "complete"
    else
        write_completion "error" "Agent exited with error code $exit_code" "0.50"
        write_signal "error"
    fi
}

trap cleanup EXIT

# Execute the actual agent command
# The real agent work happens here
exec "$@"
