# Multi-stage Dockerfile for CFN Loop Agent Containers
# Optimized for production use with minimal attack surface

# Stage 1: Builder - Install dependencies and build TypeScript
FROM node:18-alpine AS builder

WORKDIR /app

# Install build dependencies (including py3-setuptools for distutils)
RUN apk add --no-cache git python3 py3-setuptools make g++

# Copy package files
COPY package*.json ./
COPY tsconfig.json ./

# Install all dependencies (including dev dependencies for build)
RUN npm ci

# Copy source code
COPY src/ ./src/

# Build TypeScript
RUN npm run build

# Stage 2: Production - Minimal runtime image
FROM node:18-alpine AS production

WORKDIR /app

# Install runtime dependencies only
RUN apk add --no-cache \
    bash \
    git \
    redis \
    curl \
    ca-certificates

# Copy package files
COPY package*.json ./

# Install production dependencies only
RUN npm ci --production --ignore-scripts

# Copy built artifacts from builder stage
COPY --from=builder /app/dist ./dist

# Copy essential project files
COPY .claude/ ./.claude/
COPY claude-assets/ ./claude-assets/
COPY scripts/ ./scripts/
COPY README.md LICENSE ./

# Create non-root user for security
RUN addgroup -g 1001 -S cfn && \
    adduser -u 1001 -S cfn -G cfn && \
    chown -R cfn:cfn /app

# Create workspace directory for agent execution
RUN mkdir -p /app/workspace && \
    chown -R cfn:cfn /app/workspace

# Switch to non-root user
USER cfn

# Set environment variables
ENV NODE_ENV=production \
    PATH="/app/node_modules/.bin:${PATH}" \
    CFN_CONTAINER_MODE=true

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD node -e "console.log('healthy')" || exit 1

# Default entrypoint for agent execution
ENTRYPOINT ["node", "dist/cli/index.js", "agent"]

# Default CMD (can be overridden)
CMD ["--help"]

# Labels for metadata
LABEL maintainer="CFN Loop Team"
LABEL version="2.15.0"
LABEL description="Claude Flow Novice agent container for CFN Loop orchestration"
LABEL org.opencontainers.image.source="https://github.com/masharri/claude-flow-novice"
