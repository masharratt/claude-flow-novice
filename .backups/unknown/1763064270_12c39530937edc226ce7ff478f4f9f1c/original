# Dockerfile.coordinator
# Intelligent TypeScript Error Coordinator
# Analyzes frontend errors, creates strategic batches, spawns agents with 40GB budget

FROM node:18-alpine

# Install system dependencies
RUN apk add --no-cache \
    bash \
    git \
    jq \
    redis

# Install TypeScript globally (for tsc --noEmit validation)
RUN npm install -g typescript@5.9.3

# Create app directory
WORKDIR /app

# Copy package files first (for layer caching)
COPY docker/coordinator/package*.json ./

# Install Node.js dependencies
# - dockerode: Docker SDK for spawning agents
# - redis: Redis client for coordination
# - @typescript/lib-*: TypeScript compiler API for AST parsing
RUN npm install --production

# Copy coordinator source code
COPY docker/coordinator/src ./src

# Copy utility libraries
COPY docker/coordinator/lib ./lib

# Copy Redis coordination skills (required for agent communication)
COPY .claude/skills/cfn-redis-coordination ./.claude/skills/cfn-redis-coordination

# Copy runtime environment setup script
COPY docker/runtime/cfn-runtime.sh ./docker/runtime/cfn-runtime.sh
RUN chmod +x ./docker/runtime/cfn-runtime.sh

# Environment variables (can be overridden at runtime)
ENV NODE_ENV=production
ENV MEMORY_BUDGET=40g
ENV MAX_ITERATIONS=10
ENV REDIS_HOST=cfn-redis
ENV REDIS_PORT=6379
ENV NETWORK_NAME=cfn-network
ENV AGENT_IMAGE=claude-flow-novice-agent:frontend

# Healthcheck (coordinator should exit when done, so this is mainly for startup)
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD node -e "console.log('Coordinator healthy')" || exit 1

# Entrypoint - sources cfn-runtime.sh for environment standardization
ENTRYPOINT ["/bin/bash", "-c", "source ./docker/runtime/cfn-runtime.sh && exec node src/coordinator.js"]

# Default command (can be overridden)
CMD []

# Labels
LABEL maintainer="Claude Flow Novice"
LABEL description="Intelligent TypeScript Error Coordinator with CFN Loop pattern"
LABEL version="1.0.0"
