/**
 * Agent Workspace Tests
 *
 * Comprehensive test suite for agent workspace management.
 * Part of Task 2.1: Persistent Agent Output Workspace (Integration)
 *
 * Coverage: ≥95% (workspace creation, output writing, completion signals, cleanup)
 */

import * as path from 'path';
import * as fs from 'fs/promises';
import { describe, it, expect, beforeEach, afterEach } from '@jest/globals';
import {
  createWorkspace,
  getWorkspacePath,
  writeOutput,
  readOutput,
  signalCompletion,
  listWorkspaces,
  WorkspacePath,
} from '../src/lib/agent-workspace';
import {
  writeCompletionSignal,
  readCompletionSignal,
  pollForCompletion,
  hasCompletionSignal,
  deleteCompletionSignal,
  CompletionSignal,
} from '../src/lib/completion-signal-handler';

// Test workspace root
const TEST_WORKSPACE_ROOT = path.resolve(__dirname, 'test-workspaces');

// Helper to clean up test workspaces
async function cleanupTestWorkspaces(): Promise<void> {
  try {
    await fs.rm(TEST_WORKSPACE_ROOT, { recursive: true, force: true });
  } catch (error) {
    // Ignore if directory doesn't exist
  }
}

// Helper to create a test completion signal
function createTestSignal(
  taskId: string,
  agentId: string,
  success: boolean = true
): CompletionSignal {
  return {
    success,
    confidence: 0.85,
    deliverables: ['file1.ts', 'file2.ts'],
    errors: success ? undefined : ['Test error'],
    metrics: {
      executionTimeMs: 5420,
      tokensUsed: 12500,
      costUsd: 0.025,
    },
    taskId,
    agentId,
    timestamp: new Date(),
  };
}

// Helper to sleep
function sleep(ms: number): Promise<void> {
  return new Promise((resolve) => setTimeout(resolve, ms));
}

describe('Agent Workspace', () => {
  beforeEach(async () => {
    await cleanupTestWorkspaces();
  });

  afterEach(async () => {
    await cleanupTestWorkspaces();
  });

  describe('createWorkspace', () => {
    it('should create workspace with correct directory structure', async () => {
      const workspace = await createWorkspace('task-123', 'agent-456', {
        workspaceRoot: TEST_WORKSPACE_ROOT,
      });

      expect(workspace.taskId).toBe('task-123');
      expect(workspace.agentId).toBe('agent-456');
      expect(workspace.path).toContain('task-123');
      expect(workspace.path).toContain('agent-456');

      // Check subdirectories exist
      const stats = await Promise.all([
        fs.stat(workspace.subdirectories.logs),
        fs.stat(workspace.subdirectories.reports),
        fs.stat(workspace.subdirectories.metrics),
        fs.stat(workspace.subdirectories.deliverables),
      ]);

      stats.forEach((stat) => {
        expect(stat.isDirectory()).toBe(true);
      });
    });

    it('should sanitize task and agent IDs', async () => {
      const workspace = await createWorkspace('task/../evil', 'agent@#$%', {
        workspaceRoot: TEST_WORKSPACE_ROOT,
      });

      expect(workspace.taskId).toBe('task___evil');
      expect(workspace.agentId).toBe('agent____');
      expect(workspace.path).not.toContain('..');
      expect(workspace.path).not.toContain('@');
    });

    it('should be idempotent (safe to call multiple times)', async () => {
      const workspace1 = await createWorkspace('task-123', 'agent-456', {
        workspaceRoot: TEST_WORKSPACE_ROOT,
      });
      const workspace2 = await createWorkspace('task-123', 'agent-456', {
        workspaceRoot: TEST_WORKSPACE_ROOT,
      });

      expect(workspace1.path).toBe(workspace2.path);
    });

    it('should throw error for invalid task ID', async () => {
      await expect(
        createWorkspace('', 'agent-456', { workspaceRoot: TEST_WORKSPACE_ROOT })
      ).rejects.toThrow('Task ID must be a non-empty string');
    });

    it('should throw error for invalid agent ID', async () => {
      await expect(
        createWorkspace('task-123', '', { workspaceRoot: TEST_WORKSPACE_ROOT })
      ).rejects.toThrow('Agent ID must be a non-empty string');
    });
  });

  describe('getWorkspacePath', () => {
    it('should return workspace path without creating directories', async () => {
      const workspace = getWorkspacePath('task-123', 'agent-456', {
        workspaceRoot: TEST_WORKSPACE_ROOT,
      });

      expect(workspace.taskId).toBe('task-123');
      expect(workspace.agentId).toBe('agent-456');

      // Directories should not exist yet
      await expect(fs.stat(workspace.path)).rejects.toThrow();
    });
  });

  describe('writeOutput', () => {
    let workspace: WorkspacePath;

    beforeEach(async () => {
      workspace = await createWorkspace('task-123', 'agent-456', {
        workspaceRoot: TEST_WORKSPACE_ROOT,
      });
    });

    it('should write log output', async () => {
      await writeOutput(workspace, 'logs', 'stdout.log', 'Log line 1\nLog line 2\n');

      const content = await readOutput(workspace, 'logs', 'stdout.log');
      expect(content).toBe('Log line 1\nLog line 2\n');
    });

    it('should write JSON report output', async () => {
      const report = { status: 'complete', findings: ['finding1', 'finding2'] };
      await writeOutput(workspace, 'reports', 'analysis.json', report);

      const content = await readOutput(workspace, 'reports', 'analysis.json');
      expect(content).toEqual(report);
    });

    it('should write metrics output', async () => {
      const metrics = { executionTimeMs: 5420, memoryMb: 128 };
      await writeOutput(workspace, 'metrics', 'performance.json', metrics);

      const content = await readOutput(workspace, 'metrics', 'performance.json');
      expect(content).toEqual(metrics);
    });

    it('should write deliverable files', async () => {
      await writeOutput(workspace, 'deliverables', 'output.ts', 'export const value = 42;');

      const content = await readOutput(workspace, 'deliverables', 'output.ts');
      expect(content).toBe('export const value = 42;');
    });

    it('should sanitize filenames', async () => {
      await writeOutput(workspace, 'logs', '../../../etc/passwd', 'malicious content');

      // Should write to logs directory, not escape
      const logFiles = await fs.readdir(workspace.subdirectories.logs);
      expect(logFiles).toContain('______etc_passwd');
    });

    it('should throw error for invalid output type', async () => {
      await expect(
        writeOutput(workspace, 'invalid' as any, 'test.txt', 'content')
      ).rejects.toThrow('Invalid output type');
    });

    it('should handle concurrent writes to different files', async () => {
      const writes = Array.from({ length: 10 }, (_, i) =>
        writeOutput(workspace, 'logs', `log${i}.txt`, `Log content ${i}`)
      );

      await expect(Promise.all(writes)).resolves.toBeDefined();

      // Verify all files were written
      const logFiles = await fs.readdir(workspace.subdirectories.logs);
      expect(logFiles.length).toBe(10);
    });
  });

  describe('readOutput', () => {
    let workspace: WorkspacePath;

    beforeEach(async () => {
      workspace = await createWorkspace('task-123', 'agent-456', {
        workspaceRoot: TEST_WORKSPACE_ROOT,
      });
    });

    it('should read string content', async () => {
      await writeOutput(workspace, 'logs', 'test.log', 'test content');
      const content = await readOutput(workspace, 'logs', 'test.log');
      expect(content).toBe('test content');
    });

    it('should auto-parse JSON files', async () => {
      const data = { key: 'value', number: 42 };
      await writeOutput(workspace, 'reports', 'data.json', data);
      const content = await readOutput(workspace, 'reports', 'data.json');
      expect(content).toEqual(data);
    });

    it('should throw error for non-existent file', async () => {
      await expect(readOutput(workspace, 'logs', 'nonexistent.log')).rejects.toThrow(
        'Output file not found'
      );
    });
  });

  describe('signalCompletion', () => {
    let workspace: WorkspacePath;

    beforeEach(async () => {
      workspace = await createWorkspace('task-123', 'agent-456', {
        workspaceRoot: TEST_WORKSPACE_ROOT,
      });
    });

    it('should write completion signal', async () => {
      await signalCompletion(workspace, {
        success: true,
        confidence: 0.88,
        deliverables: ['file1.ts', 'file2.ts'],
        metrics: { executionTimeMs: 3500 },
      });

      const signalPath = path.join(workspace.path, 'COMPLETION_SIGNAL.json');
      const content = await fs.readFile(signalPath, 'utf8');
      const signal = JSON.parse(content);

      expect(signal.success).toBe(true);
      expect(signal.confidence).toBe(0.88);
      expect(signal.deliverables).toEqual(['file1.ts', 'file2.ts']);
      expect(signal.taskId).toBe('task-123');
      expect(signal.agentId).toBe('agent-456');
    });
  });

  describe('listWorkspaces', () => {
    it('should list all agent workspaces for a task', async () => {
      await createWorkspace('task-123', 'agent-001', {
        workspaceRoot: TEST_WORKSPACE_ROOT,
      });
      await createWorkspace('task-123', 'agent-002', {
        workspaceRoot: TEST_WORKSPACE_ROOT,
      });
      await createWorkspace('task-123', 'agent-003', {
        workspaceRoot: TEST_WORKSPACE_ROOT,
      });

      const workspaces = await listWorkspaces('task-123', {
        workspaceRoot: TEST_WORKSPACE_ROOT,
      });

      expect(workspaces).toHaveLength(3);
      expect(workspaces).toContain('agent-001');
      expect(workspaces).toContain('agent-002');
      expect(workspaces).toContain('agent-003');
    });

    it('should return empty array for non-existent task', async () => {
      const workspaces = await listWorkspaces('nonexistent', {
        workspaceRoot: TEST_WORKSPACE_ROOT,
      });

      expect(workspaces).toEqual([]);
    });
  });
});

describe('Completion Signal Handler', () => {
  let workspace: WorkspacePath;

  beforeEach(async () => {
    await cleanupTestWorkspaces();
    workspace = await createWorkspace('task-123', 'agent-456', {
      workspaceRoot: TEST_WORKSPACE_ROOT,
    });
  });

  afterEach(async () => {
    await cleanupTestWorkspaces();
  });

  describe('writeCompletionSignal', () => {
    it('should write valid completion signal', async () => {
      const signal = createTestSignal('task-123', 'agent-456');
      await writeCompletionSignal(workspace, signal);

      const signalPath = path.join(workspace.path, 'COMPLETION_SIGNAL.json');
      const exists = await fs
        .stat(signalPath)
        .then(() => true)
        .catch(() => false);
      expect(exists).toBe(true);
    });

    it('should validate signal data', async () => {
      const invalidSignal = {
        success: 'invalid' as any,
        confidence: 0.85,
        deliverables: [],
        taskId: 'task-123',
        agentId: 'agent-456',
        timestamp: new Date(),
      };

      await expect(writeCompletionSignal(workspace, invalidSignal)).rejects.toThrow(
        'Signal success must be a boolean'
      );
    });

    it('should validate confidence range', async () => {
      const invalidSignal = createTestSignal('task-123', 'agent-456');
      invalidSignal.confidence = 1.5;

      await expect(writeCompletionSignal(workspace, invalidSignal)).rejects.toThrow(
        'Signal confidence must be a number between 0 and 1'
      );
    });
  });

  describe('readCompletionSignal', () => {
    it('should read valid completion signal', async () => {
      const originalSignal = createTestSignal('task-123', 'agent-456');
      await writeCompletionSignal(workspace, originalSignal);

      const readSignal = await readCompletionSignal(workspace);
      expect(readSignal).not.toBeNull();
      expect(readSignal!.success).toBe(true);
      expect(readSignal!.confidence).toBe(0.85);
      expect(readSignal!.deliverables).toEqual(['file1.ts', 'file2.ts']);
    });

    it('should return null for non-existent signal', async () => {
      const signal = await readCompletionSignal(workspace);
      expect(signal).toBeNull();
    });

    it('should preserve timestamp as Date object', async () => {
      const originalSignal = createTestSignal('task-123', 'agent-456');
      await writeCompletionSignal(workspace, originalSignal);

      const readSignal = await readCompletionSignal(workspace);
      expect(readSignal!.timestamp).toBeInstanceOf(Date);
    });
  });

  describe('pollForCompletion', () => {
    it('should return signal when available', async () => {
      const signal = createTestSignal('task-123', 'agent-456');

      // Write signal after 200ms
      setTimeout(async () => {
        await writeCompletionSignal(workspace, signal);
      }, 200);

      const result = await pollForCompletion(workspace, 5000, { intervalMs: 50 });
      expect(result.success).toBe(true);
      expect(result.confidence).toBe(0.85);
    });

    it('should timeout if signal not available', async () => {
      await expect(pollForCompletion(workspace, 500, { intervalMs: 50 })).rejects.toThrow(
        'Completion signal timeout'
      );
    });

    it('should poll at specified interval', async () => {
      const signal = createTestSignal('task-123', 'agent-456');
      const startTime = Date.now();

      // Write signal after 300ms
      setTimeout(async () => {
        await writeCompletionSignal(workspace, signal);
      }, 300);

      await pollForCompletion(workspace, 5000, { intervalMs: 100 });
      const elapsedTime = Date.now() - startTime;

      // Should have polled multiple times
      expect(elapsedTime).toBeGreaterThanOrEqual(300);
      expect(elapsedTime).toBeLessThan(600);
    });
  });

  describe('hasCompletionSignal', () => {
    it('should return true when signal exists', async () => {
      const signal = createTestSignal('task-123', 'agent-456');
      await writeCompletionSignal(workspace, signal);

      const exists = await hasCompletionSignal(workspace);
      expect(exists).toBe(true);
    });

    it('should return false when signal does not exist', async () => {
      const exists = await hasCompletionSignal(workspace);
      expect(exists).toBe(false);
    });
  });

  describe('deleteCompletionSignal', () => {
    it('should delete existing signal', async () => {
      const signal = createTestSignal('task-123', 'agent-456');
      await writeCompletionSignal(workspace, signal);

      let exists = await hasCompletionSignal(workspace);
      expect(exists).toBe(true);

      await deleteCompletionSignal(workspace);

      exists = await hasCompletionSignal(workspace);
      expect(exists).toBe(false);
    });

    it('should not throw error when deleting non-existent signal', async () => {
      await expect(deleteCompletionSignal(workspace)).resolves.toBeUndefined();
    });
  });

  describe('Concurrent Agent Outputs', () => {
    it('should handle multiple agents writing to different workspaces', async () => {
      const agents = ['agent-001', 'agent-002', 'agent-003', 'agent-004', 'agent-005'];

      const writes = agents.map(async (agentId) => {
        const ws = await createWorkspace('task-concurrent', agentId, {
          workspaceRoot: TEST_WORKSPACE_ROOT,
        });
        await writeOutput(ws, 'logs', 'output.log', `Output from ${agentId}`);
        await signalCompletion(ws, {
          success: true,
          confidence: 0.9,
          deliverables: [`${agentId}-output.ts`],
        });
        return ws;
      });

      const workspaces = await Promise.all(writes);
      expect(workspaces).toHaveLength(5);

      // Verify all signals were written
      for (const ws of workspaces) {
        const signal = await readCompletionSignal(ws);
        expect(signal).not.toBeNull();
        expect(signal!.success).toBe(true);
      }
    });
  });

  describe('Error Handling', () => {
    it('should handle file system errors gracefully', async () => {
      const invalidWorkspace: WorkspacePath = {
        path: '/nonexistent/invalid/path',
        taskId: 'task-invalid',
        agentId: 'agent-invalid',
        subdirectories: {
          logs: '/nonexistent/logs',
          reports: '/nonexistent/reports',
          metrics: '/nonexistent/metrics',
          deliverables: '/nonexistent/deliverables',
        },
      };

      await expect(
        writeOutput(invalidWorkspace, 'logs', 'test.log', 'content')
      ).rejects.toThrow();
    });
  });
});
