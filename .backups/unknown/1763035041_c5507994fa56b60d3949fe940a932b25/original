#!/bin/bash
# tests/docker/cleanup/remove-obsolete-tests.sh
# Phase 1 :: Remove obsolete test files per TEST_SUITE_MAINTENANCE_PLAN.md

set -euo pipefail

PROJECT_ROOT=$(git rev-parse --show-toplevel)
source "$PROJECT_ROOT/tests/test-utils.sh" 2>/dev/null || {
    # Fallback if test-utils.sh doesn't exist
    log_step() { echo "[STEP] $*"; }
    log_info() { echo "[INFO] $*"; }
    log_error() { echo "[ERROR] $*" >&2; }
}

# Initialize tracking
REMOVED_COUNT=0
MOVED_COUNT=0
ARCHIVED_COUNT=0
MANIFEST_FILE="$PROJECT_ROOT/tests/docker/cleanup/removal-manifest.txt"

# Ensure manifest directory exists
mkdir -p "$PROJECT_ROOT/tests/docker/cleanup"

log_step "Starting obsolete test cleanup (Phase 1)"
echo "=============================================="

# Initialize manifest
cat > "$MANIFEST_FILE" << 'EOF'
# Test Cleanup Manifest
# Generated: $(date -u +"%Y-%m-%d %H:%M:%S UTC")
# Phase: 1 - Remove Obsolete Tests per TEST_SUITE_MAINTENANCE_PLAN.md

## Summary
- Tests Removed: TBD
- Tests Moved: TBD
- Tests Archived: TBD
- Total Actions: TBD

## Rationale
Remove duplicate, obsolete, or Docker-incompatible tests.
Move CLI/Task mode tests to subdirectories instead of deleting.
Archive ACE tests for potential future integration.

---

EOF

# Helper functions
remove_if_exists() {
    local file="$1"
    local reason="$2"

    if [[ -f "$file" ]]; then
        log_info "Removing: $file"
        echo "REMOVED: $file" >> "$MANIFEST_FILE"
        echo "  Reason: $reason" >> "$MANIFEST_FILE"
        echo "" >> "$MANIFEST_FILE"
        rm "$file"
        ((REMOVED_COUNT++))
        return 0
    else
        log_info "Not found (skipping): $file"
        echo "SKIPPED: $file (not found)" >> "$MANIFEST_FILE"
        echo "" >> "$MANIFEST_FILE"
        return 0
    fi
}

move_if_exists() {
    local file="$1"
    local destination="$2"
    local reason="$3"

    if [[ -f "$file" ]]; then
        mkdir -p "$(dirname "$destination")"
        log_info "Moving: $file → $destination"
        echo "MOVED: $file" >> "$MANIFEST_FILE"
        echo "  To: $destination" >> "$MANIFEST_FILE"
        echo "  Reason: $reason" >> "$MANIFEST_FILE"
        echo "" >> "$MANIFEST_FILE"
        mv "$file" "$destination"
        ((MOVED_COUNT++))
        return 0
    else
        log_info "Not found (skipping): $file"
        echo "SKIPPED: $file (not found)" >> "$MANIFEST_FILE"
        echo "" >> "$MANIFEST_FILE"
        return 0
    fi
}

archive_if_exists() {
    local file="$1"
    local archive_dir="$2"
    local reason="$3"

    if [[ -f "$file" ]]; then
        mkdir -p "$archive_dir"
        local basename=$(basename "$file")
        log_info "Archiving: $file → $archive_dir/$basename"
        echo "ARCHIVED: $file" >> "$MANIFEST_FILE"
        echo "  To: $archive_dir/$basename" >> "$MANIFEST_FILE"
        echo "  Reason: $reason" >> "$MANIFEST_FILE"
        echo "" >> "$MANIFEST_FILE"
        mv "$file" "$archive_dir/$basename"
        ((ARCHIVED_COUNT++))
        return 0
    else
        log_info "Not found (skipping): $file"
        echo "SKIPPED: $file (not found)" >> "$MANIFEST_FILE"
        echo "" >> "$MANIFEST_FILE"
        return 0
    fi
}

# 1. Duplicate Redis Coordination Tests
log_step "1. Removing duplicate Redis coordination tests"
remove_if_exists "$PROJECT_ROOT/tests/docker/run-redis-coordination-tests-fixed.sh" \
    "Superseded by run-redis-coordination-tests.sh"
remove_if_exists "$PROJECT_ROOT/tests/docker/redis-test-simple.sh" \
    "Superseded by run-redis-coordination-tests.sh"

# 2. Mode Detection Tests (MOVE to cli-mode, don't delete)
log_step "2. Moving CLI/Task mode detection tests to tests/cli-mode/"
move_if_exists "$PROJECT_ROOT/tests/cfn-v3/test_mode_detection.sh" \
    "$PROJECT_ROOT/tests/cli-mode/test_mode_detection.sh" \
    "CLI-specific mode detection - main CFN Loop still uses this"
move_if_exists "$PROJECT_ROOT/tests/cfn-v3/test_cli_mode.sh" \
    "$PROJECT_ROOT/tests/cli-mode/test_cli_mode.sh" \
    "CLI-specific mode validation"
move_if_exists "$PROJECT_ROOT/tests/cfn-v3/test_mode_simple.sh" \
    "$PROJECT_ROOT/tests/cli-mode/test_mode_simple.sh" \
    "Simplified CLI mode test"
move_if_exists "$PROJECT_ROOT/tests/integration/test-mode-detection-anti023.sh" \
    "$PROJECT_ROOT/tests/cli-mode/test-mode-detection-anti023.sh" \
    "Anti-pattern #023 mode detection guard"

# 3. Redundant Timeout Tests (keep comprehensive version)
log_step "3. Removing redundant timeout test variants"
remove_if_exists "$PROJECT_ROOT/tests/test-adaptive-timeout-simple.sh" \
    "Superseded by test-adaptive-timeout-system.sh (comprehensive version)"
remove_if_exists "$PROJECT_ROOT/tests/test-adaptive-timeout-integration.sh" \
    "Superseded by test-adaptive-timeout-system.sh (comprehensive version)"
remove_if_exists "$PROJECT_ROOT/tests/test-adaptive-timeout-edge-cases.sh" \
    "Superseded by test-adaptive-timeout-system.sh (comprehensive version)"

# 4. Obsolete Orchestration Fallback Tests
log_step "4. Removing obsolete orchestration fallback tests"
remove_if_exists "$PROJECT_ROOT/tests/cfn-v3-orchestration/orchestration-fallback-test.sh" \
    "Docker coordinator doesn't use WebSocket/fallback mechanisms"
remove_if_exists "$PROJECT_ROOT/tests/cfn-v3-orchestration/websocket-orchestration-fallback-test.sh" \
    "Docker coordinator uses pure Docker + Redis coordination"
remove_if_exists "$PROJECT_ROOT/tests/docker/docker-socket-orchestration-fallback-test.sh" \
    "Docker coordinator doesn't require socket fallback mechanisms"

# 5. Redundant Readonly Conflict Tests
log_step "5. Removing redundant readonly conflict prevention tests"
remove_if_exists "$PROJECT_ROOT/tests/integration/readonly-conflict-prevention-test.sh" \
    "Docker coordinator mounts workspace as rw, no readonly conflicts"
remove_if_exists "$PROJECT_ROOT/tests/docker/websocket-readonly-conflict-prevention-test.sh" \
    "Docker coordinator doesn't use WebSocket coordination"
remove_if_exists "$PROJECT_ROOT/tests/docker/docker-socket-readonly-conflict-prevention-test.sh" \
    "Docker coordinator architecture doesn't have readonly conflicts"

# 6. Task Mode Tests (MOVE to task-mode, don't delete)
log_step "6. Moving Task mode tests to tests/task-mode/"
move_if_exists "$PROJECT_ROOT/tests/cfn-v3/test-task-mode-safety.sh" \
    "$PROJECT_ROOT/tests/task-mode/test-task-mode-safety.sh" \
    "Task mode still used in main CFN Loop (/cfn-loop-task command)"
move_if_exists "$PROJECT_ROOT/tests/cfn-v3/test_task_mode_complete.sh" \
    "$PROJECT_ROOT/tests/task-mode/test_task_mode_complete.sh" \
    "Comprehensive Task mode validation - debugging mode"

# 7. Duplicate Simple/Complete Test Variants
log_step "7. Removing duplicate simple/complete test variants"
remove_if_exists "$PROJECT_ROOT/tests/test_complete.sh" \
    "Superseded by comprehensive test versions"
remove_if_exists "$PROJECT_ROOT/tests/test-cfn-integration-complete.sh" \
    "Superseded by comprehensive test versions"
remove_if_exists "$PROJECT_ROOT/tests/integration/test-graceful-shutdown-simple.sh" \
    "Superseded by test-graceful-shutdown-comprehensive.sh"

# 8. ACE Context Tests (ARCHIVE, don't delete)
log_step "8. Archiving ACE context tests (not integrated with Docker coordinator)"
archive_if_exists "$PROJECT_ROOT/tests/ace-integration/test-ace-context-lookup.sh" \
    "$PROJECT_ROOT/tests/archive/ace-integration" \
    "ACE not integrated with Docker coordinator - archive for potential future use"
archive_if_exists "$PROJECT_ROOT/tests/ace-integration/test_ace_reflection_hook.sh" \
    "$PROJECT_ROOT/tests/archive/ace-integration" \
    "ACE reflection hook - valuable system that may integrate later"

# Update manifest summary
log_step "Updating manifest summary"
sed -i "s/Tests Removed: TBD/Tests Removed: $REMOVED_COUNT/" "$MANIFEST_FILE"
sed -i "s/Tests Moved: TBD/Tests Moved: $MOVED_COUNT/" "$MANIFEST_FILE"
sed -i "s/Tests Archived: TBD/Tests Archived: $ARCHIVED_COUNT/" "$MANIFEST_FILE"
TOTAL_ACTIONS=$((REMOVED_COUNT + MOVED_COUNT + ARCHIVED_COUNT))
sed -i "s/Total Actions: TBD/Total Actions: $TOTAL_ACTIONS/" "$MANIFEST_FILE"
sed -i "s/Generated: \$(date -u +\"%Y-%m-%d %H:%M:%S UTC\")/Generated: $(date -u +"%Y-%m-%d %H:%M:%S UTC")/" "$MANIFEST_FILE"

# Create README for cli-mode directory
log_step "Creating README for CLI mode tests"
cat > "$PROJECT_ROOT/tests/cli-mode/README.md" << 'EOF'
# CLI Mode Tests

Tests specific to CFN Loop CLI mode execution (`/cfn-loop-cli` command).

## Purpose
CLI mode spawns the cfn-v3-coordinator which orchestrates workers via CLI spawning
in the background. These tests validate:
- Mode detection logic
- CLI spawning mechanics
- Background worker coordination
- Cost-optimized execution patterns (95-98% savings vs Task mode)

## Related Documentation
- `CLAUDE.md` lines 167-188 (CLI vs Task mode)
- `.claude/commands/cfn/CFN_LOOP_TASK_MODE.md`
- `planning/docker/SESSION_2025-11-12_FINDINGS.md`

## Execution
These tests validate infrastructure that Task mode still uses.
Docker coordinator is ONE execution path, not THE ONLY path.

## Moved From
Originally in `tests/cfn-v3/` and `tests/integration/`.
Relocated during Phase 1 cleanup per TEST_SUITE_MAINTENANCE_PLAN.md.
EOF

# Create README for task-mode directory
log_step "Creating README for Task mode tests"
cat > "$PROJECT_ROOT/tests/task-mode/README.md" << 'EOF'
# Task Mode Tests

Tests specific to CFN Loop Task mode execution (`/cfn-loop-task` command).

## Purpose
Task mode spawns all agents directly via Task() tool in Main Chat.
Provides "full visibility in Main Chat" and is the default debugging mode.

These tests validate:
- Task() spawning patterns
- Direct agent coordination
- Main Chat visibility
- Debugging workflows

## Related Documentation
- `CLAUDE.md` lines 167-188 (Task vs CLI mode)
- `.claude/commands/cfn/CFN_LOOP_TASK_MODE.md`
- `SESSION_2025-11-12_FINDINGS.md`

## When to Use Task Mode
- Debugging (full visibility)
- Learning (see all agent interactions)
- Short tasks (<5 min)
- Development and testing

## Moved From
Originally in `tests/cfn-v3/`.
Relocated during Phase 1 cleanup per TEST_SUITE_MAINTENANCE_PLAN.md.
EOF

# Create README for archive directory
log_step "Creating README for archive directory"
mkdir -p "$PROJECT_ROOT/tests/archive/ace-integration"
cat > "$PROJECT_ROOT/tests/archive/ace-integration/README.md" << 'EOF'
# Archived ACE Integration Tests

## Status
These tests are archived because ACE (Adaptive Context Engine) is not currently
integrated with the Docker coordinator architecture.

## Purpose
ACE provides context management and lookup capabilities that may be valuable
for future integration. Tests are preserved rather than deleted.

## Contents
- `test-ace-context-lookup.sh` - Context lookup functionality
- `test_ace_reflection_hook.sh` - ACE reflection hook integration

## Restoration
To restore ACE integration:
1. Review current ACE implementation status
2. Update Docker coordinator to support ACE
3. Move tests back to `tests/ace-integration/`
4. Update tests for Docker architecture

## Deletion Policy
Review quarterly. Keep indefinitely as ACE represents significant
context management infrastructure.

## Archived
$(date -u +"%Y-%m-%d %H:%M:%S UTC")
EOF

# Final summary
echo ""
log_step "Cleanup Complete!"
echo "=============================================="
echo "Tests Removed:  $REMOVED_COUNT"
echo "Tests Moved:    $MOVED_COUNT"
echo "Tests Archived: $ARCHIVED_COUNT"
echo "Total Actions:  $TOTAL_ACTIONS"
echo ""
echo "Manifest: $MANIFEST_FILE"
echo ""
echo "New directories created:"
echo "  - tests/cli-mode/     (CLI mode tests)"
echo "  - tests/task-mode/    (Task mode tests)"
echo "  - tests/archive/ace-integration/ (ACE tests)"
echo ""
echo "Review manifest for detailed action log."
