# ============================================================================
# CFN Agent - General Purpose Agent Image
# ============================================================================
# Single image for ALL agent types (react-frontend-engineer, backend-developer,
# reviewer, tester, product-owner, etc.)
#
# Usage:
#   docker run --rm --network mcp-network \
#     -e AGENT_TYPE=react-frontend-engineer \
#     -e TASK_ID=test-123 \
#     -e AGENT_ID=agent-test \
#     -e REDIS_URL=redis://cfn-redis:6379 \
#     -v /workspace:/app/workspace \
#     cfn-agent:latest
# ============================================================================

# Stage 1: Dependencies
FROM node:18-alpine AS deps

WORKDIR /app

# Copy package files
COPY package*.json ./
COPY tsconfig.json ./

# Install all dependencies (including dev for build)
RUN npm ci

# ============================================================================
# Stage 2: Build
FROM node:18-alpine AS builder

WORKDIR /app

# Copy dependencies from deps stage
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/package*.json ./

# Copy source code and build script
COPY src ./src
COPY tsconfig.json ./
COPY .swcrc ./
COPY scripts/build-linux.sh /tmp/build-linux.sh

# Build TypeScript to JavaScript using Linux native build
RUN chmod +x /tmp/build-linux.sh && /tmp/build-linux.sh

# Verify spawn.js was built successfully
RUN test -f dist/cli/spawn.js || (echo "ERROR: dist/cli/spawn.js not found after build!" && ls -la dist/cli/ && exit 1)
RUN echo "Build verification: spawn.js successfully compiled" && ls -lh dist/cli/spawn.js

# ============================================================================
# Stage 3: Production Runtime
FROM node:18-alpine

WORKDIR /app

# Install runtime dependencies and tools
RUN apk add --no-cache \
    bash \
    curl \
    jq \
    git \
    && rm -rf /var/cache/apk/*

# Install global dependencies
RUN npm install -g typescript ts-node

# Copy built artifacts from builder
COPY --from=builder /app/dist ./dist
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/package*.json ./

# Copy CFN configuration and agents
COPY .claude ./.claude

# Create workspace directory
RUN mkdir -p /app/workspace

# Create non-root user for security
RUN addgroup -g 1001 -S cfnagent && \
    adduser -S cfnagent -u 1001 -G cfnagent && \
    chown -R cfnagent:cfnagent /app

# Switch to non-root user
USER cfnagent

# Environment variables (can be overridden at runtime)
ENV NODE_ENV=production
ENV PROJECT_ROOT=/app
ENV WORKSPACE_PATH=/app/workspace

# Default command (can be overridden)
# Usage: node dist/cli/spawn.js --type $AGENT_TYPE --task-id $TASK_ID --agent-id $AGENT_ID
CMD ["node", "dist/cli/spawn.js", "--help"]
