{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "database-handoffs/execution-metrics/v1.0.0",
  "title": "Execution Metrics Schema",
  "description": "Schema for skill execution metrics (Integration Point 1.2)",
  "type": "object",
  "required": ["execution_id", "skill_id", "execution_time_ms", "cost_usd", "tokens_avoided", "status"],
  "properties": {
    "execution_id": {
      "type": "string",
      "description": "Unique execution identifier",
      "pattern": "^exec-[a-z0-9-]+$"
    },
    "skill_id": {
      "type": "string",
      "description": "Skill that was executed",
      "pattern": "^skill-[a-z0-9-]+$"
    },
    "execution_time_ms": {
      "type": "number",
      "description": "Execution time in milliseconds",
      "minimum": 0
    },
    "cost_usd": {
      "type": "number",
      "description": "Cost in USD",
      "minimum": 0
    },
    "tokens_avoided": {
      "type": "integer",
      "description": "Number of tokens avoided by using skill",
      "minimum": 0
    },
    "status": {
      "type": "string",
      "description": "Execution status",
      "enum": ["success", "failure", "timeout", "error"]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "When the execution occurred"
    },
    "error_message": {
      "type": "string",
      "description": "Error message if status is failure or error"
    }
  },
  "additionalProperties": false
}
