# Source files (only distribute built files)
src/

# Exclude source maps from published package
*.map
*.js.map
*.ts.map

# INCLUDE .claude/ DIRECTORY - core functionality
# Exclude only large build artifacts and duplicates
!.claude/
!.claude/**

# Exclude build artifacts
.claude/**/target/
.claude/**/dist/
.claude/**/build/
.claude/**/.ruvector/
.claude/**/index.db
.claude/**/*.sqlite
.claude/**/*.sqlite3

# Exclude duplicate node_modules (already cleaned but keep rule)
.claude/**/node_modules/

# Exclude Rust build artifacts
.claude/skills/cfn-transparency-middleware/target/
.claude/skills/cfn-local-ruvector-accelerator/target/
*.rlib
*.rmeta

# Build artifacts and temp files
*.log
.DS_Store
.env
.env.*
*.env
**/*.env
.claude/api-configs/
.tmp/
tmp/
node_modules/

