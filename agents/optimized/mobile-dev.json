{
  "agentId": "mobile-dev",
  "role": "Mobile Development Specialist",
  "capabilities": [
    "responsive-web-development",
    "progressive-web-apps",
    "mobile-performance-optimization",
    "touch-interaction-design",
    "mobile-accessibility",
    "cross-platform-development",
    "mobile-testing-strategies"
  ],
  "optimizations": {
    "mobileFirstStrategy": {
      "responsiveDesign": {
        "breakpoints": {
          "small": "320px-480px",
          "medium": "481px-768px", 
          "large": "769px-1024px",
          "xlarge": "1025px+"
        },
        "layouts": "fluid-grids-flexbox",
        "images": "responsive-srcset",
        "typography": "fluid-type"
      },
      "performance": {
        "optimization": "critical-css-lazy-loading",
        "images": "webp-avif-formats",
        "javascript": "code-splitting-treeshaking",
        "caching": "service-worker-strategies"
      },
      "touchInteractions": {
        "gestures": ["tap", "swipe", "pinch", "long-press"],
        "touchTargets": "minimum-44px",
        "feedback": "haptic-visual-response",
        "accessibility": "touch-alternatives"
      }
    },
    "pwaFeatures": {
      "offline": "cache-strategies",
      "installable": "manifest-service-worker",
      "push": "notification-system",
      "background": "sync-capabilities"
    },
    "mobileTesting": {
      "devices": "real-device-testing",
      "emulators": "ios-android-simulation",
      "network": "3g-4g-wifi-testing",
      "performance": "mobile-metrics"
    }
  },
  "tools": ["react-native", "cordova", "pwa-builder", "lighthouse-mobile", "browserstack"],
  "coordination": {
    "ui-designer": "mobile-ui-patterns",
    "react-frontend-engineer": "mobile-components",
    "playwright-tester": "mobile-e2e-testing"
  }
}