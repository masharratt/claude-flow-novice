{
  "testingStrategy": {
    "pyramidOptimization": {
      "unitTesting": {
        "percentage": 70,
        "focus": ["business-logic", "pure-functions", "component-behavior"],
        "tools": ["jest", "vitest", "react-testing-library"],
        "patterns": ["london-tdd", "mockist-approach", "behavior-verification"],
        "coverage": ">90%",
        "execution": "fast-feedback"
      },
      "integrationTesting": {
        "percentage": 20,
        "focus": ["component-interaction", "state-management", "api-integration"],
        "tools": ["cypress", "testing-library", "msw"],
        "patterns": ["component-testing", "api-mocking", "state-validation"],
        "coverage": ">80%",
        "execution": "medium-feedback"
      },
      "e2eTesting": {
        "percentage": 10,
        "focus": ["critical-user-journeys", "cross-browser", "mobile-compatibility"],
        "tools": ["playwright", "cypress"],
        "patterns": ["page-object-model", "user-flow-testing", "visual-regression"],
        "coverage": "critical-paths",
        "execution": "slow-feedback"
      }
    },
    "mobileTestingStrategy": {
      "responsive": {
        "breakpoints": ["mobile", "tablet", "desktop"],
        "orientation": ["portrait", "landscape"],
        "viewport": ["small", "medium", "large"]
      },
      "touch": {
        "gestures": ["tap", "swipe", "pinch", "long-press"],
        "multi-touch": "zoom-rotation",
        "accessibility": "touch-alternatives"
      },
      "performance": {
        "metrics": ["FCP", "LCP", "CLS", "FID"],
        "network": ["3g", "4g", "wifi"],
        "battery": "power-consumption"
      },
      "compatibility": {
        "browsers": ["chrome", "safari", "firefox"],
        "devices": ["ios", "android", "tablet"],
        "versions": "latest-2-versions"
      }
    },
    "testingWorkflows": {
      "tddFlow": {
        "red": "write-failing-test",
        "green": "minimal-implementation",
        "refactor": "improve-design",
        "repeat": "continuous-cycle"
      },
      "ciIntegration": {
        "triggers": ["push", "pull-request", "schedule"],
        "parallel": "test-distribution",
        "reporting": "coverage-reports",
        "failure": "immediate-feedback"
      },
      "qualityGates": {
        "coverage": "minimum-thresholds",
        "performance": "lighthouse-scores",
        "accessibility": "axe-compliance",
        "security": "vulnerability-scanning"
      }
    },
    "coordinationPatterns": {
      "unit-tdd": ["tdd-london-swarm", "unit/tdd-london-swarm", "react-frontend-engineer"],
      "component-testing": ["react-frontend-engineer", "interaction-tester", "tester"],
      "e2e-automation": ["playwright-tester", "e2e/playwright-agent", "mobile-dev"],
      "production-validation": ["production-validator", "validation/production-validator", "tester"]
    }
  }
}