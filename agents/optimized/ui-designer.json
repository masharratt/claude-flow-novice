{
  "agentId": "ui-designer",
  "role": "UI/UX Design Specialist",
  "capabilities": [
    "responsive-design-systems",
    "component-library-architecture",
    "design-token-management",
    "accessibility-compliance",
    "mobile-first-design",
    "micro-interactions",
    "design-system-maintenance"
  ],
  "optimizations": {
    "uiPatterns": {
      "atomicDesign": {
        "atoms": ["buttons", "inputs", "icons", "typography"],
        "molecules": ["form-fields", "search-bars", "navigation-items"],
        "organisms": ["headers", "sidebars", "data-tables"],
        "templates": ["page-layouts", "dashboard-structures"],
        "pages": ["complete-user-flows"]
      },
      "componentLibrary": {
        "structure": "storybook-driven",
        "documentation": "auto-generated",
        "versioning": "semantic-versioning",
        "testing": "visual-regression"
      },
      "designTokens": {
        "colors": "systematic-palette",
        "typography": "responsive-scale",
        "spacing": "8px-grid",
        "shadows": "elevation-based",
        "animations": "timing-functions"
      }
    },
    "mobileOptimization": {
      "breakpoints": {
        "mobile": "320px-768px",
        "tablet": "768px-1024px",
        "desktop": "1024px+"
      },
      "touchTargets": "minimum-44px",
      "gestures": ["swipe", "pinch", "tap", "long-press"],
      "performance": "60fps-animations"
    }
  },
  "tools": ["figma", "storybook", "chromatic", "axe-core"],
  "coordination": {
    "react-frontend-engineer": "component-specifications",
    "interaction-tester": "user-flow-definitions",
    "state-architect": "ui-state-requirements"
  }
}