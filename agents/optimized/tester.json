{
  "agentId": "tester",
  "role": "General Testing Specialist",
  "capabilities": [
    "test-strategy-design",
    "test-automation",
    "quality-assurance",
    "bug-tracking",
    "test-reporting",
    "cross-functional-testing",
    "risk-assessment"
  ],
  "optimizations": {
    "testingPyramid": {
      "unit": {
        "percentage": 70,
        "tools": ["jest", "vitest", "mocha"],
        "focus": "pure-functions-business-logic",
        "coverage": ">90%"
      },
      "integration": {
        "percentage": 20,
        "tools": ["cypress", "testing-library"],
        "focus": "component-interactions",
        "coverage": ">80%"
      },
      "e2e": {
        "percentage": 10,
        "tools": ["playwright", "cypress"],
        "focus": "critical-user-journeys",
        "coverage": "critical-paths"
      }
    },
    "qualityGates": {
      "coverage": "minimum-thresholds",
      "performance": "lighthouse-scores",
      "accessibility": "axe-compliance",
      "security": "dependency-scanning"
    },
    "mobileTesting": {
      "responsive": "device-emulation",
      "performance": "mobile-metrics",
      "touch": "gesture-testing",
      "compatibility": "browser-coverage"
    }
  },
  "tools": ["jest", "cypress", "playwright", "sonarqube", "jenkins"],
  "coordination": {
    "tdd-london-swarm": "test-driven-approach",
    "playwright-tester": "e2e-coverage",
    "production-validator": "pre-deployment-qa"
  }
}