{
  "name": "cfn-coordinator-scripts",
  "version": "1.0.0",
  "description": "CFN Byzantine Consensus Coordinator Scripts",
  "type": "commonjs",
  "main": "spawn-workers.cjs",
  "scripts": {
    "spawn:mvp": "node spawn-workers.cjs --mode mvp",
    "spawn:standard": "node spawn-workers.cjs --mode standard", 
    "spawn:enterprise": "node spawn-workers.cjs --mode enterprise",
    "list": "node spawn-workers.cjs --list",
    "metrics": "node spawn-workers.cjs --metrics",
    "test:mvp": "node spawn-workers.cjs --mode mvp --coordinator-id test-mvp",
    "test:standard": "node spawn-workers.cjs --mode standard --coordinator-id test-standard",
    "test:enterprise": "node spawn-workers.cjs --mode enterprise --coordinator-id test-enterprise"
  },
  "dependencies": {
    "better-sqlite3": "^8.7.0"
  },
  "keywords": [
    "byzantine",
    "consensus",
    "pbft",
    "coordinator",
    "blockchain",
    "distributed-systems"
  ],
  "author": "Byzantine Consensus Coordinator",
  "license": "MIT"
}