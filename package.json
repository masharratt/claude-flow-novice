{
  "name": "claude-flow-novice",
  "version": "2.9.1",
  "description": "AI agent orchestration framework with namespace-isolated skills, agents, and CFN Loop validation. Safe installation with ~0.01% collision risk.",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "claude-flow-novice": "dist/cli/index.js",
    "cfn-init": "scripts/init-project.js",
    "cfn-spawn": "dist/cli/spawn.js",
    "cfn-loop": "dist/cli/cfn-loop.js",
    "cfn-swarm": "dist/cli/cfn-swarm.js",
    "cfn-portal": "dist/cli/cfn-portal.js",
    "cfn-context": "dist/cli/cfn-context.js",
    "cfn-metrics": "dist/cli/cfn-metrics.js",
    "cfn-redis": "dist/cli/cfn-redis.js"
  },
  "files": [
    "dist/",
    ".claude/agents/cfn-dev-team/",
    ".claude/skills/cfn-*/",
    ".claude/hooks/cfn-*",
    ".claude/commands/cfn/",
    ".claude/cfn-data/",
    ".claude/cfn-agents-ignore/",
    "scripts/init-project.js",
    "scripts/*.sh",
    "!scripts/test-*.sh",
    "!scripts/*-validation.cjs",
    "!scripts/deployment/",
    "README.md",
    "LICENSE",
    "CFN-CLAUDE.md"
  ],
  "keywords": [
    "ai",
    "agent",
    "orchestration",
    "multi-agent",
    "coordination",
    "redis",
    "cfn-loop",
    "skills",
    "automation",
    "cli",
    "consensus",
    "validation"
  ],
  "author": "Claude Flow Novice Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/claude-flow-novice.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/claude-flow-novice/issues"
  },
  "homepage": "https://github.com/yourusername/claude-flow-novice#readme",
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "npm run clean && npm run build:swc",
    "build:swc": "swc src -d dist --config-file .swcrc --ignore '**/*.test.ts' --ignore '**/*.test.tsx' --ignore '**/*.spec.ts'",
    "clean": "rm -rf dist",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && ./scripts/verify-no-secrets.sh",
    "prepack": "npm run build",
    "postinstall": "node -e \"console.log('\\n✅ claude-flow-novice installed successfully!\\n📚 Get started: npx claude-flow-novice --help\\n🔧 Initialize project: npx cfn-init\\n💡 CFN loops: npx cfn-loop \\\"Task description\\\"\\n')\"",
    "verify-package": "npm pack --dry-run",
    "portal:start": "./scripts/start-portal.sh",
    "portal:stop": "./scripts/stop-portal.sh",
    "portal:restart": "npm run portal:stop && npm run portal:start",
    "portal:status": "./scripts/portal-status.sh",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.67.0",
    "ajv": "^8.17.1",
    "better-sqlite3": "^12.4.1",
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "dotenv": "^17.2.3",
    "glob": "^11.0.3",
    "lodash": "^4.17.21",
    "redis": "^5.8.3",
    "socket.io": "^4.8.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@swc/cli": "^0.1.62",
    "@swc/core": "^1.3.0",
    "@types/ajv": "^0.0.5",
    "@types/glob": "^8.1.0",
    "@types/ioredis": "^4.28.10",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.20",
    "@types/sqlite3": "^3.1.11",
    "@types/uuid": "^10.0.0",
    "@types/yaml": "^1.9.6",
    "jest": "^30.2.0",
    "jest-mock-extended": "^4.0.0",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.56.1",
    "pngjs": "^7.0.0",
    "redis-mock": "^0.56.3",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "tsx": "^4.7.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
