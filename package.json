{
  "name": "claude-flow-novice",
  "version": "2.0.0",
  "description": "AI agent orchestration - Clean v2 architecture",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "claude-flow-novice": "dist/cli/index.js"
  },
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "npm run clean && npm run build:swc",
    "build:swc": "swc src -d dist --config-file .swcrc",
    "clean": "rm -rf dist",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "redis": "^5.8.3",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@swc/cli": "^0.1.62",
    "@swc/core": "^1.3.0",
    "@types/glob": "^8.1.0",
    "@types/ioredis": "^4.28.10",
    "@types/sqlite3": "^3.1.11",
    "@types/uuid": "^10.0.0",
    "@types/yaml": "^1.9.6",
    "jest": "^29.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
