{
  "name": "quick-test",
  "version": "1.0.0",
  "description": "Simple testing utility for quick validation",
  "main": "quick-test.js",
  "bin": {
    "quick-test": "./quick-test.js"
  },
  "scripts": {
    "test": "node quick-test.js",
    "test:watch": "node -e \"require('fs').watchFile('quick-test.js', () => { console.log('\\n🔄 Running tests...'); require('./quick-test.js'); })\""
  },
  "keywords": ["test", "testing", "utility", "simple", "quick"],
  "author": "Quick Test Utility",
  "license": "MIT",
  "engines": {
    "node": ">=12.0.0"
  }
}