# CFN Docker Stabilization Environment Configuration

# ========================================
# Container Resource Limits Configuration
# ========================================

# Task Mode (Default) - Conservative Resource Limits
CFN_TASK_MEMORY_LIMIT=2048
CFN_TASK_CPU_LIMIT=1.0
CFN_TASK_TIMEOUT=300

# CLI Mode - Performance Resource Limits
CFN_CLI_MEMORY_LIMIT=4096
CFN_CLI_CPU_LIMIT=2.0
CFN_CLI_TIMEOUT=600

# Orchestrator - High Resource Limits
CFN_ORCHESTRATOR_MEMORY_LIMIT=8192
CFN_ORCHESTRATOR_CPU_LIMIT=2.5
CFN_ORCHESTRATOR_TIMEOUT=1800

# ========================================
# Telemetry Configuration
# ========================================

# Enable/disable Docker-native telemetry
CFN_TELEMETRY_ENABLED=true
CFN_TELEMETRY_INTERVAL=30
CFN_TELEMETRY_RETENTION_DAYS=7

# Telemetry storage
CFN_TELEMETRY_VOLUME_PATH=./artifacts/telemetry
CFN_TELEMETRY_EXPORT_DIR=./artifacts/telemetry/exports

# Grafana monitoring
CFN_GRAFANA_ENABLED=true
CFN_GRAFANA_PORT=3000
CFN_GRAFANA_ADMIN_PASSWORD=admin

# ========================================
# Container Network Configuration
# ========================================

# Network configuration
CFN_NETWORK_NAME=cfn-network
CFN_NETWORK_SUBNET=172.20.0.0/16

# Redis configuration for CLI mode
CFN_REDIS_MEMORY_LIMIT=1g
CFN_REDIS_MAXMEMORY_POLICY=allkeys-lru

# ========================================
# Security Configuration
# ========================================

# Container user configuration
CFN_USER=1001
CFN_GROUP=1001

# Environment sanitization
CFN_SANITIZE_ENVIRONMENT=true
CFN_CLEAR_SECRETS=true

# Container security
CFN_READONLY_FILESYSTEM=false
CFN_NO_NEW_PRIVILEGES=true

# ========================================
# Health Check Configuration
# ========================================

# Health check intervals
CFN_HEALTH_CHECK_INTERVAL=30
CFN_HEALTH_CHECK_TIMEOUT=5
CFN_HEALTH_CHECK_RETRIES=3

# Health check endpoints
CFN_AGENT_HEALTH_ENDPOINT=http://localhost:3000/health
CFN_ORCHESTRATOR_HEALTH_ENDPOINT=http://localhost:3001/health

# ========================================
# Logging Configuration
# ========================================

# Container logging driver
CFN_LOG_DRIVER=json-file
CFN_LOG_MAX_SIZE=10m
CFN_LOG_MAX_FILES=3

# Log levels
CFN_LOG_LEVEL=info
CFN_DEBUG_MODE=false

# Log storage
CFN_LOG_VOLUME_PATH=./logs
CFN_LOG_ROTATION_ENABLED=true

# ========================================
# Performance Configuration
# ========================================

# Node.js optimization
CFN_NODE_OPTIONS_TASK="--max-old-space-size=2048 --optimize-for-size --max-executable-size=512"
CFN_NODE_OPTIONS_CLI="--max-old-space-size=4096"
CFN_NODE_OPTIONS_ORCHESTRATOR="--max-old-space-size=8192"

# Container restart policies
CFN_RESTART_POLICY=unless-stopped
CFN_RESTART_DELAY=5
CFN_MAX_RESTART_ATTEMPTS=3

# ========================================
# Deployment Configuration
# ========================================

# Deployment mode
CFN_DEPLOYMENT_MODE=production
CFN_AUTO_SCALING=true
CFN_MIN_REPLICAS=1
CFN_MAX_REPLICAS=5

# Scaling configuration
CFN_SCALE_UP_DELAY=30
CFN_SCALE_DOWN_DELAY=60
CFN_SCALE_THRESHOLD_CPU=70
CFN_SCALE_THRESHOLD_MEMORY=85

# ========================================
# Additional Service Resource Limits
# ========================================

# Telemetry Collector
CFN_TELEMETRY_MEMORY_LIMIT=512M
CFN_TELEMETRY_CPU_LIMIT=0.5

# Grafana Dashboard
CFN_GRAFANA_MEMORY_LIMIT=512M
CFN_GRAFANA_CPU_LIMIT=0.5

# Redis CPU (memory limit set above)
CFN_REDIS_CPU_LIMIT=0.3