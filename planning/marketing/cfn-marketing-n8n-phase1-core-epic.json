{
  "epicId": "cfn-marketing-n8n-phase1-core",
  "name": "Phase 1: Core Marketing Infrastructure",
  "description": "Deploy 4 core MCP servers (email, social, analytics, CRM) to enable 26 marketing agents",
  "status": "not_started",
  "owner": "Marketing & Infrastructure Team",
  "estimatedDuration": "4 weeks",
  "weeks": "1-4",
