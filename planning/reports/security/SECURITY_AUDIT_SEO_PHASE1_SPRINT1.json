  "vulnerabilities": [
    {
      "id": "H1",
      "title": "File-Based Cache Permission Vulnerability",
      "severity": "HIGH",
      "category": "Data Storage",
      "status": "OPEN",
      "location": "planning/seo/lib/research-cache.ts:32-48",
      "description": "Cache directory and files created with default permissions allowing world-readable access on Unix systems",
      "risk": "Cached business intelligence (keywords, competitor URLs) exposed to local users; PII leakage if tracking IDs in URLs",
      "cve_reference": "OWASP A05:2021 - Security Misconfiguration",
      "proof_of_concept": "ls ~/.cfn/seo/cache/research/ && cat ~/.cfn/seo/cache/research/*.json",
      "attack_vectors": [
        "Local privilege escalation",
        "Data exfiltration from shared systems",
        "Race condition during concurrent writes"
      ],
      "remediation": {
        "effort_hours": 2,
        "priority": "MUST_FIX_BEFORE_PRODUCTION",
        "steps": [
          "Create cache directory with mode 0o700 (rwx------)",
          "Write cache files with mode 0o600 (rw-------)",
          "Fix permissions on existing cache directories",
          "Test with: stat ~/.cfn/seo/cache/research/"
        ],
        "code_example": "fs.mkdirSync(cacheDir, { recursive: true, mode: 0o700 }); fs.writeFileSync(file, data); fs.chmodSync(file, 0o600);"
      }
    },
    {
      "id": "H2",
      "title": "Rate Limiter Queue Priority Injection",
      "severity": "HIGH",
      "category": "Rate Limiting",
      "status": "OPEN",
      "location": "planning/seo/lib/rate-limiter.ts:99-135",
      "description": "Priority queue accepts invalid priority values without validation; unknown priorities default to 'normal'",
      "risk": "Malicious actors inject non-standard priority values causing queue ordering issues; enables priority-based DoS attacks",
      "cve_reference": "OWASP A04:2021 - Insecure Design",
      "proof_of_concept": "Submit query with options.priority = 'CRITICAL' or numeric value 999",
      "attack_vectors": [
        "Priority spoofing to bypass rate limits",
        "Queue starvation attacks",
        "Resource exhaustion via high-priority queue manipulation"
      ],
      "remediation": {
        "effort_hours": 1.5,
        "priority": "MUST_FIX_BEFORE_PRODUCTION",
        "steps": [
          "Add priority validation to validateQuery() in research-service.ts",
          "Restrict priority to enum: ['low', 'normal', 'high']",
          "Throw INVALID_QUERY error for invalid values",
          "Unit test with: invalid priority values, type coercion attempts"
        ],
        "code_example": "const validPriorities = ['low', 'normal', 'high']; if (!validPriorities.includes(priority)) throw ResearchError(...)"
      }
    },
    {
      "id": "M1",
      "title": "Error Message Information Disclosure",
      "severity": "MEDIUM",
      "category": "API Design",
      "status": "OPEN",
      "location": "Multiple: research-service.ts:69-71, research-cache.ts:147-154, rate-limiter.ts:78-86",
      "description": "Error messages include sensitive information: query strings, cache keys, rate limit configuration, competitor URLs",
      "risk": "Reconnaissance for further attacks; query strings expose business strategy and keywords; enables cache key prediction",
      "cve_reference": "OWASP A09:2021 - Logging and Monitoring Failures",
      "proof_of_concept": "Capture error response containing full query object with targetUrl like 'https://competitor-research.com'",
      "attack_vectors": [
        "Error message scraping from logs/monitoring",
        "Information leakage through stack traces",
        "Cache key structure analysis"
      ],
      "remediation": {
        "effort_hours": 2,
        "priority": "SHOULD_FIX_BEFORE_SPRINT_END",
        "steps": [
          "Create error-sanitizer.ts with redaction function",
          "Omit: query text, targetUrl, cacheKey, full error objects",
          "Keep only: query type, maxResults, priority",
          "Update all error throws to use sanitized details",
          "Unit test error redaction with sensitive data"
        ],
        "code_example": "function sanitizeErrorDetails(details) { return Object.fromEntries(Object.entries(details).filter(([k]) => !['query', 'targetUrl'].includes(k))); }"
      }
    },
    {
      "id": "M2",
      "title": "Race Condition in Cache Eviction",
      "severity": "MEDIUM",
      "category": "Concurrency",
      "status": "OPEN",
      "location": "planning/seo/lib/research-cache.ts:195-240",
      "description": "Time-of-check-to-time-of-use (TOCTOU) race condition between cache size check and eviction with concurrent requests",
      "risk": "Cache can exceed size limit if multiple requests pass size check before eviction completes; repeated evictions cause CPU spike",
      "cve_reference": "OWASP A04:2021 - Insecure Design",
      "proof_of_concept": "Submit 100+ large concurrent queries; observe cache exceeding max size before eviction completes",
      "attack_vectors": [
        "Memory exhaustion via queue buildup",
        "CPU DoS from repeated eviction cycles",
        "Cache thrashing reducing hit rate"
      ],
      "remediation": {
        "effort_hours": 1.5,
        "priority": "SHOULD_FIX_BEFORE_SPRINT_END",
        "steps": [
          "Increase eviction threshold safety margin to 0.95",
          "Evict more aggressively to 70% capacity target",
          "Add error handling for corrupted cache files",
          "Avoid repeated evictions with conservative thresholds",
          "Load test with 100+ concurrent requests"
        ],
        "code_example": "const threshold = maxCacheSize * 0.95; if (size > threshold) evictTo(maxCacheSize * 0.7);"
      }
    },
    {
      "id": "L1",
      "title": "Missing Cache Key Namespace",
      "severity": "LOW",
      "category": "Data Isolation",
      "status": "OPEN",
      "location": "planning/seo/lib/research-cache.ts:54-67",
      "description": "Cache keys don't include service version or name; enables collisions across service versions and instances",
      "risk": "Version mismatch: old cache format served to new code; service isolation issues in shared backends",
      "cve_reference": "Best Practice - Cache Key Design",
      "proof_of_concept": "Service v1.0 and v2.0 both use key 'a3f7c2e1...' for same query with different formats",
      "attack_vectors": [
        "Cache poisoning via format mismatch",
        "Cross-version incompatibility",
        "Shared backend conflicts"
      ],
      "remediation": {
        "effort_hours": 0.5,
        "priority": "NICE_TO_HAVE",
        "steps": [
          "Add SERVICE_VERSION and SERVICE_NAME to cache key",
          "Include in keyData: { version, service, query, ... }",
          "Verify backwards compatibility if upgrading",
          "Document cache key format"
        ],
        "code_example": "const keyData = { version: '1.0', service: 'seo-research', query: ..., options: ... }; generateCacheKey(keyData)"
      }
    }
  ],
