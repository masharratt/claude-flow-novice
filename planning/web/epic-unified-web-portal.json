{
  "epic": {
    "id": "epic-unified-web-portal",
    "name": "Unified Web Portal Consolidation",
    "version": "1.0.0",
    "description": "Consolidate 8 fragmented web portals into a single, unified, modular web portal for Claude Flow Novice with real-time agent monitoring, control, and visualization",
    "business_value": "Reduce 714MB to ~300MB, eliminate 45% code duplication, provide consistent UX, enable 2-3x faster feature development",
    "stakeholders": ["development-team", "end-users", "devops"],
    "priority": "high",
    "estimated_duration": "8-11 weeks",
    "target_release": "v3.0.0"
  },
  "current_state_analysis": {
    "existing_portals": 8,
    "total_files": 209,
    "total_size": "714MB",
    "code_duplication": "45%",
    "websocket_implementations": 5,
    "agent_visualization_duplicates": 4,
    "key_issues": [
      "670MB node_modules in src/web/frontend bloating main package",
      "5 separate WebSocket implementations with inconsistent APIs",
      "4 duplicate agent hierarchy visualizations",
      "3 separate Express servers (ports 3000, 3001, 8080)",
      "No shared component library - copy/paste development",
      "MCP integration scattered across 3 portals",
      "Inconsistent real-time data protocols",
      "No unified authentication/authorization"
    ]
  },
  "target_architecture": {
    "structure": "monorepo-workspace",
    "package_layout": {
      "packages/web-portal": {
        "type": "standalone-package",
        "optional": true,
        "install": "npm install @claude-flow/web-portal",
        "structure": [
          "src/",
          "  client/ - React frontend",
          "  server/ - Express backend",
          "  shared/ - Shared types & utils",
          "  components/ - Reusable React components",
          "  hooks/ - Custom React hooks",
          "  services/ - API & WebSocket clients"
        ]
      },
      "packages/web-components": {
        "type": "shared-library",
        "purpose": "Reusable React components for dashboards",
        "exports": [
          "AgentHierarchyTree",
          "StatusMonitor",
          "PerformanceCharts",
          "EventTimeline",
          "ResourceGauges",
          "InterventionPanel"
        ]
      }
    },
    "backend": {
      "type": "express-server",
      "port": 3000,
      "features": [
        "REST API endpoints",
        "WebSocket server (unified Socket.IO)",
        "Authentication middleware",
        "Rate limiting",
        "Compression",
        "Security headers (helmet)",
        "CORS configuration"
      ],
      "api_routes": [
        "GET /api/hierarchy - Agent hierarchy",
        "GET /api/status - Agent statuses",
        "GET /api/metrics - Performance metrics",
        "GET /api/events - Event stream",
        "GET /api/resources - Resource usage",
        "POST /api/intervention - Human intervention",
        "GET /api/health - Health check"
      ],
      "websocket_events": [
        "agent:update - Agent status changes",
        "hierarchy:change - Hierarchy updates",
        "metrics:update - Performance metrics",
        "event:stream - Real-time events",
        "error:notify - Error notifications"
      ]
    },
    "frontend": {
      "type": "react-spa",
      "framework": "React 18+",
      "ui_library": "Material-UI v5",
      "state_management": "Zustand",
      "routing": "React Router v6",
      "charts": "Recharts",
      "code_editor": "Monaco Editor",
      "features": [
        "Real-time agent monitoring",
        "Interactive hierarchy visualization",
        "Performance metrics dashboard",
        "Event timeline with filters",
        "Human intervention controls",
        "CFN Loop progress tracking",
        "Fleet management (1000+ agents)",
        "Resource monitoring",
        "Multi-swarm support",
        "Dark/light theme toggle"
      ],
      "views": [
        "/dashboard - Main overview",
        "/agents - Agent management",
        "/hierarchy - Hierarchy tree",
        "/performance - Performance metrics",
        "/events - Event timeline",
        "/fleet - Fleet management",
        "/cfn-loop - CFN Loop monitoring",
        "/intervention - Human controls",
        "/settings - Configuration"
      ]
    },
    "integration": {
      "transparency_system": "src/coordination/shared/transparency/",
      "swarm_coordinator": "src/swarm/",
      "event_bus": "src/eventbus/",
      "redis_coordination": "src/redis/",
      "sqlite_memory": "src/sqlite/"
    }
  },
