{
  "name": "@claude-flow-novice/web-portal",
  "version": "3.0.0",
  "description": "Unified web portal for Claude Flow Novice - consolidates 8 portals into single React SPA with Express backend",
  "private": true,
  "type": "module",
  "main": "./dist/server/index.js",
  "types": "./dist/server/index.d.ts",
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite --port 3001",
    "dev:server": "tsx watch src/server/index.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "swc src/server -d dist/server --config-file .swcrc",
    "build:types": "tsc --emitDeclarationOnly",
    "preview": "vite preview",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist build .vite"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "@mui/material": "^6.1.7",
    "@mui/icons-material": "^6.1.7",
    "@mui/x-charts": "^7.22.2",
    "@mui/x-data-grid": "^7.22.2",
    "@emotion/react": "^11.13.5",
    "@emotion/styled": "^11.13.5",
    "zustand": "^5.0.1",
    "recharts": "^2.14.1",
    "chart.js": "^4.4.7",
    "react-hook-form": "^7.54.0",
    "@hookform/resolvers": "^3.9.1",
    "yup": "^1.5.0",
    "monaco-editor": "^0.52.2",
    "@monaco-editor/react": "^4.6.0",
    "axios": "^1.7.9",
    "socket.io-client": "^4.8.1",
    "date-fns": "^4.1.0",
    "lodash": "^4.17.21",
    "react-hot-toast": "^2.4.1",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-web-links": "^0.9.0",
    "express": "^4.21.1",
    "socket.io": "^4.8.1",
    "cors": "^2.8.5",
    "helmet": "^8.1.0",
    "express-rate-limit": "^8.1.0",
    "compression": "^1.7.4",
    "jsonwebtoken": "^9.0.2",
    "bcrypt": "^6.0.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/node": "^22.9.1",
    "@types/express": "^5.0.0",
    "@types/lodash": "^4.17.13",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "eslint": "^9.15.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "prettier": "^3.3.3",
    "@swc/cli": "^0.7.8",
    "@swc/core": "^1.13.20",
    "vitest": "^2.1.5",
    "@vitest/ui": "^2.1.5",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "playwright": "^1.49.0",
    "vite": "^6.0.3",
    "@vitejs/plugin-react-swc": "^4.0.1",
    "tsx": "^4.20.6"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "claude-flow",
    "web-portal",
    "react",
    "typescript",
    "websocket",
    "real-time",
    "dashboard",
    "monitoring"
  ],
  "author": "Claude Flow Novice Team",
  "license": "MIT"
}
