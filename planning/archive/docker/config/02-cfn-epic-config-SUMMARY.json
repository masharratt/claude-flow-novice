      "owner": "Infrastructure Team",
      "status": "open"
    },
    {
      "id": "RISK-002",
      "severity": "medium",
      "probability": "medium",
      "description": "PostgreSQL migration causes ACE system downtime",
      "mitigation": "Dual-write (SQLite + PostgreSQL) during transition",
      "owner": "Database Team",
      "status": "open"
    },
    {
      "id": "RISK-003",
      "severity": "low",
      "probability": "low",
      "description": "Coordinator overhead reduces cost savings",
