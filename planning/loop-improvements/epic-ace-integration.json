{
  "epic_id": "EPIC-ACE-001",
  "name": "ACE System Integration - Self-Improving CFN Loops",
  "version": "1.0.0",
  "status": "READY_FOR_PLANNING",
  "priority": "P1",
  "owner": "System Architecture Team",
  "estimated_duration_weeks": 5,
  "created_at": "2025-10-29T22:00:00Z",
  "updated_at": "2025-10-29T22:00:00Z",

  "executive_summary": {
    "description": "Integrate ACE (Adaptive Context Extension) system into CFN Loop workflow to enable automatic learning from sprint execution, context reuse across sprints, and continuous system improvement.",
    "business_value": [
      "20% faster iterations through pattern reuse",
      "Fewer repeated mistakes via anti-pattern warnings",
      "Institutional knowledge accumulation",
      "Proactive systemic improvements via pattern detection"
    ],
    "technical_value": [
      "Automatic reflection extraction",
      "Context lookup with relevance scoring",
      "Historical context injection for agents",
      "Cross-sprint pattern detection"
    ]
  },

  "scope": {
    "in_scope": [
      "Loop 5 post-sprint reflection (automatic)",
      "Loop 0 context lookup (similar past sprints)",
      "Loop 3 context injection (historical lessons)",
      "Anti-pattern extraction from failures",
      "Edge case detection and storage",
      "Pattern detection (recurring issues)",
      "SQLite storage with metadata",
      "Redis caching for hot contexts",
      "ACE dashboard command",
      "CLI and Task mode support"
    ],
    "out_of_scope": [
      "Migration of existing CLAUDE.md lessons",
      "Web portal UI for ACE system",
      "Cross-project context sharing",
      "Machine learning for pattern detection",
      "Real-time context injection during agent execution"
    ]
  },

  "success_criteria": {
    "quantitative": [
      {
        "metric": "Context reuse rate",
        "target": "≥70%",
        "description": "Percentage of sprints using historical context"
      },
      {
        "metric": "First-iteration success rate",
        "target": "+20%",
        "description": "Improvement in single-iteration completion"
      },
      {
        "metric": "Query performance",
        "target": "<100ms",
        "description": "Context lookup time with 1000+ reflections"
      },
      {
        "metric": "Reflection coverage",
        "target": "≥95%",
        "description": "Percentage of sprints with post-reflection"
      },
      {
        "metric": "Cache hit rate",
        "target": "≥60%",
        "description": "Redis caching effectiveness"
      },
      {
        "metric": "Pattern detection",
        "target": "≥3 issues",
        "description": "Systemic issues found in first month"
      }
    ],
    "qualitative": [
      "Product Owner approves reflection quality",
      "Agents confirm context usefulness (survey 4/5+)",
      "No context pollution reported",
      "Anti-patterns prevent repeated mistakes",
      "Pattern reports lead to concrete improvements"
    ]
  },

  "dependencies": {
    "prerequisites": [
      {
        "name": "ACE system skill",
        "version": "v1.0.0",
        "status": "operational",
        "location": ".claude/skills/cfn-ace-system/"
      },
      {
        "name": "CFN Loop orchestrator",
        "status": "modular architecture",
        "location": ".claude/skills/cfn-loop-orchestration/"
      },
      {
        "name": "SQLite memory adapter",
        "status": "operational"
      },
      {
        "name": "Redis coordination",
        "status": "operational"
      }
    ],
    "external_dependencies": []
  },

  "phases": [
    {
      "phase_number": 1,
      "name": "Core Integration",
      "duration_days": 5,
      "goal": "Basic reflection, lookup, injection working in CFN Loop",
      "story": "As a developer, I want CFN Loops to automatically learn from past sprints so I don't repeat mistakes.",
      "deliverables": [
        {
          "id": "1.1",
          "name": "Loop 5 Reflection Hook",
          "file": ".claude/skills/cfn-loop-orchestration/orchestrate.sh",
          "description": "Add post-PROCEED reflection invocation",
          "tasks": [
            "Detect PROCEED decision from Product Owner",
            "Launch reflection in background (non-blocking)",
            "Pass task_id, swarm_id, agent list, confidence scores",
            "Log to .artifacts/logs/ace-reflection-{TASK_ID}.log",
            "Error handling: reflection failure doesn't block commit"
          ],
          "acceptance_criteria": [
            "Reflection launches after PROCEED decision",
            "Background process doesn't block git commit",
            "Reflection completes within 30 seconds",
            "Errors logged but don't crash orchestrator"
          ],
          "test": "tests/ace-integration/01-loop5-reflection.test.sh"
        },
        {
          "id": "1.2",
          "name": "Context Lookup Helper",
          "file": ".claude/skills/cfn-loop-orchestration/helpers/context-lookup.sh",
          "description": "Query similar past sprints before Loop 3",
          "tasks": [
            "Extract keywords from task description (regex)",
            "Classify domain (frontend, backend, security, devops)",
            "Call invoke-context-query.sh with metadata",
            "Store results in Redis: cfn_loop:{TASK_ID}:historical_context",
            "TTL: 1 hour"
          ],
          "acceptance_criteria": [
            "Extracts ≥3 keywords from task description",
            "Domain classifier 80% accuracy",
            "Query returns top 5 similar contexts",
            "Similarity threshold: 0.70",
            "Redis storage successful"
          ],
          "test": "tests/ace-integration/02-context-lookup.test.sh"
        },
        {
          "id": "1.3",
          "name": "Context Injection Helper",
          "file": ".claude/skills/cfn-loop-orchestration/helpers/context-injection.sh",
          "description": "Inject historical context into agent spawns",
          "tasks": [
            "Retrieve historical context from Redis",
            "Filter lessons by agent type",
            "Format as markdown (strategies, anti-patterns, edge cases)",
            "Merge with original task context",
            "Limit: 3 lessons per category"
          ],
          "acceptance_criteria": [
            "Agent-specific filtering works",
            "Markdown formatting clear and readable",
            "Max 3 strategies, 3 anti-patterns, 3 edge cases",
            "Total injected context < 2000 chars",
            "Enriched context JSON valid"
          ],
          "test": "tests/ace-integration/03-context-injection.test.sh"
        },
        {
          "id": "1.4",
          "name": "Update Agent Spawning",
          "file": ".claude/skills/cfn-loop-orchestration/helpers/spawn-agents.sh",
          "description": "Call context-injection before each agent spawn",
          "tasks": [
            "Loop through Loop 3 agents",
            "Call context-injection.sh for each",
            "Pass enriched context to agent-spawn CLI",
            "Log injected context for debugging"
          ],
          "acceptance_criteria": [
            "All Loop 3 agents receive enriched context",
            "Graceful fallback if injection fails",
            "Injection overhead < 200ms per agent",
            "Logs show injected context summary"
          ],
          "test": "tests/ace-integration/04-agent-spawning.test.sh"
        },
        {
          "id": "1.5",
          "name": "End-to-End Integration Test",
          "file": "tests/ace-integration/05-e2e-basic-flow.test.sh",
          "description": "Verify complete learning cycle",
          "test_scenario": [
            "Sprint N: Implement JWT auth (no ACE, record metrics)",
            "Verify reflection stored in SQLite",
            "Sprint N+1: Implement OAuth (ACE-enabled)",
            "Verify context lookup finds JWT sprint",
            "Verify agents receive historical context",
            "Assert: Sprint N+1 iterations ≤ Sprint N"
          ],
          "acceptance_criteria": [
            "Sprint N reflection exists in context_reflections table",
            "Sprint N+1 query returns Sprint N (similarity > 0.70)",
            "Sprint N+1 agents receive Historical Context section",
            "Sprint N+1 completes in ≤ Sprint N iterations"
          ]
        }
      ],
      "success_metrics": [
        "All 5 tests passing",
        "Integration test shows learning (fewer iterations)",
        "No performance regression (orchestrator time +5% max)",
        "Reflection coverage: 100% of PROCEED decisions"
      ]
    },
    {
      "phase_number": 2,
      "name": "Metadata Enhancement",
      "duration_days": 5,
      "goal": "Automatic tagging, relevance scoring, fast queries",
      "story": "As a system, I want to automatically extract metadata so context queries are accurate and fast.",
      "deliverables": [
        {
          "id": "2.1",
          "name": "Automatic Tag Extraction",
          "file": ".claude/skills/cfn-ace-system/extract-tags.sh",
          "description": "Extract tags from sprint execution",
          "algorithm": "keywords = extract_keywords(taskDescription); domains = infer_domains(files, keywords); agentTags = agentTypes.map(lowercase); tags = unique([...keywords, ...domains, ...agentTags])",
          "acceptance_criteria": [
            "Extracts 5-15 tags per sprint",
            "Domain classification 90% accuracy",
            "Tags include: keywords, domain, agents, file paths",
            "Deduplication works correctly"
          ],
          "test": "tests/ace-integration/06-tag-extraction.test.sh"
        },
        {
          "id": "2.2",
          "name": "Relevance Scoring Algorithm",
          "file": ".claude/skills/cfn-ace-system/score-relevance.sh",
          "description": "Multi-factor similarity scoring",
          "formula": "relevance = 0.30 * keyword_similarity + 0.25 * agent_overlap + 0.20 * domain_match + 0.15 * recency_score + 0.10 * success_rate",
          "acceptance_criteria": [
            "Score range: 0.0 - 1.0",
            "Recent contexts score higher (same keywords)",
            "High success rate boosts score",
            "Domain mismatch reduces score significantly"
          ],
          "test": "tests/ace-integration/07-relevance-scoring.test.sh"
        },
        {
          "id": "2.3",
          "name": "SQLite Indexes",
          "file": ".claude/skills/cfn-ace-system/init-indexes.sql",
          "description": "Optimize query performance",
          "indexes": [
            "json_extract(metadata, '$.tags')",
            "json_extract(metadata, '$.domain')",
            "confidence",
            "created_at"
          ],
          "acceptance_criteria": [
            "Query time < 100ms with 1000+ reflections",
            "EXPLAIN QUERY PLAN shows index usage",
            "No full table scans for common queries"
          ],
          "test": "tests/ace-integration/08-query-performance.test.sh"
        },
        {
          "id": "2.4",
          "name": "Domain Classifier Integration",
          "file": ".claude/skills/cfn-task-classifier/classify-task.sh",
          "description": "Add domain output to task classifier",
          "acceptance_criteria": [
            "Task classifier outputs domain field",
            "Domain used in context lookup",
            "Frontend tasks get frontend contexts",
            "Cross-domain tasks get blended results"
          ],
          "test": "tests/ace-integration/09-domain-classifier.test.sh"
        }
      ],
      "success_metrics": [
        "Tag extraction accuracy ≥ 90%",
        "Relevance scoring correlates with manual ranking (Spearman's ρ > 0.8)",
        "Query performance < 100ms at scale (1000 reflections)",
        "Cache miss queries < 150ms"
      ]
    },
    {
      "phase_number": 3,
      "name": "Anti-Patterns & Edge Cases",
      "duration_days": 5,
      "goal": "Learn from failures, capture edge cases",
      "story": "As an agent, I want to know what NOT to do so I avoid past mistakes.",
      "deliverables": [
        {
          "id": "3.1",
          "name": "Anti-Pattern Detection",
          "file": ".claude/skills/cfn-ace-system/invoke-context-reflect.sh",
          "description": "Extract anti-patterns from low-confidence outcomes",
          "detection_logic": {
            "critical": "confidence < 0.50",
            "warning": "confidence < 0.70",
            "tags": ["severity", "failure_reason", "sprint_reference"]
          },
          "acceptance_criteria": [
            "Low-confidence sprints generate anti-patterns",
            "ITERATE feedback parsed correctly",
            "Severity assigned based on confidence",
            "Anti-patterns include sprint reference"
          ],
          "test": "tests/ace-integration/10-anti-pattern-extraction.test.sh"
        },
        {
          "id": "3.2",
          "name": "Negative Context Formatter",
          "file": ".claude/skills/cfn-loop-orchestration/helpers/context-injection.sh",
          "description": "Format anti-patterns for agent context",
          "format_features": [
            "Warning symbols (⚠️, 🚫)",
            "Failure severity indication",
            "Failed sprint ID reference",
            "Solution if available"
          ],
          "acceptance_criteria": [
            "Anti-patterns visually distinct from strategies",
            "Severity clearly indicated",
            "Sprint references linkable",
            "Solutions included when available"
          ],
          "test": "tests/ace-integration/11-negative-context-format.test.sh"
        },
        {
          "id": "3.3",
          "name": "Edge Case Extraction",
          "file": ".claude/skills/cfn-ace-system/invoke-context-reflect.sh",
          "description": "Detect edge cases from iteration feedback",
          "patterns": [
            "race condition",
            "edge case",
            "corner case",
            "unexpected behavior",
            "concurrency issue"
          ],
          "acceptance_criteria": [
            "Edge cases detected from feedback",
            "Solutions captured if iteration succeeded",
            "Edge cases appear in context injection",
            "Deduplication prevents repeated edge cases"
          ],
          "test": "tests/ace-integration/12-edge-case-extraction.test.sh"
        }
      ],
      "success_metrics": [
        "Anti-pattern extraction rate: 80% of failed sprints",
        "Edge case detection: ≥1 per 5 sprints",
        "Agents report anti-pattern warnings prevented mistakes (survey)",
        "Repeated failures decrease by 30% month-over-month"
      ]
    },
    {
      "phase_number": 4,
      "name": "Pattern Detection",
      "duration_days": 5,
      "goal": "Cross-sprint analysis, systemic improvements",
      "story": "As a Product Owner, I want to identify recurring issues so we can fix root causes.",
      "deliverables": [
        {
          "id": "4.1",
          "name": "Pattern Analyzer Script",
          "file": ".claude/skills/cfn-ace-system/analyze-patterns.sh",
          "description": "Weekly analysis of recurring issues",
          "query_logic": {
            "time_window": "30 days",
            "group_by": ["failure_reason", "domain"],
            "threshold": "≥3 occurrences",
            "metrics": ["occurrences", "avg_iterations", "affected_sprints"]
          },
          "acceptance_criteria": [
            "Detects recurring issues (≥3 occurrences)",
            "Groups by domain (frontend separate from backend)",
            "Calculates impact (iterations, sprints affected)",
            "Generates concrete recommendations"
          ],
          "test": "tests/ace-integration/13-pattern-detection.test.sh"
        },
        {
          "id": "4.2",
          "name": "Systemic Improvements Report",
          "file": "docs/SYSTEMIC_IMPROVEMENTS.md",
          "description": "Generate actionable report",
          "report_sections": [
            "Critical recurring issues (prioritized by impact)",
            "Affected sprints with details",
            "Concrete recommendations (create skill, update agent, etc.)",
            "ROI estimates for each recommendation"
          ],
          "acceptance_criteria": [
            "Report generated weekly",
            "Issues prioritized by impact",
            "Recommendations specific and actionable",
            "ROI estimates included"
          ],
          "test": "tests/ace-integration/14-improvement-report.test.sh"
        },
        {
          "id": "4.3",
          "name": "Weekly Cron Job",
          "file": "System crontab",
          "description": "Automate pattern analysis",
          "schedule": "0 9 * * 1",
          "actions": [
            "Run analyze-patterns.sh",
            "Generate SYSTEMIC_IMPROVEMENTS.md",
            "Email Product Owner with summary",
            "Archive old reports"
          ],
          "acceptance_criteria": [
            "Cron job executes successfully",
            "Report generated in correct location",
            "Email sent with summary",
            "Old reports archived"
          ],
          "test": "tests/ace-integration/15-cron-job.test.sh"
        },
        {
          "id": "4.4",
          "name": "Recommendation Tracker",
          "file": "docs/SYSTEMIC_IMPROVEMENTS_TRACKER.md",
          "description": "Track implementation of recommendations",
          "fields": [
            "recommendation_id",
            "status (pending, in_progress, completed, wont_fix)",
            "estimated_roi",
            "actual_roi (post-implementation)",
            "implementation_date"
          ],
          "acceptance_criteria": [
            "Tracker updated with each report",
            "Status trackable over time",
            "ROI measured post-implementation",
            "Product Owner reviews monthly"
          ]
        }
      ],
      "success_metrics": [
        "Pattern detection finds ≥3 systemic issues in first month",
        "50% of recommendations implemented within 60 days",
        "Implemented recommendations show 15%+ improvement",
        "Product Owner satisfaction: 4/5+ (survey)"
      ]
    },
    {
      "phase_number": 5,
      "name": "Optimization & Monitoring",
      "duration_days": 5,
      "goal": "Performance tuning, observability, production readiness",
      "story": "As a system administrator, I want ACE system to be fast, reliable, and observable.",
      "deliverables": [
        {
          "id": "5.1",
          "name": "Redis Caching Layer",
          "file": ".claude/skills/cfn-ace-system/invoke-context-query.sh",
          "description": "Cache hot contexts for fast retrieval",
          "cache_strategy": {
            "key_format": "ace:context:{md5(keywords:domain:agents)}",
            "ttl": "1 hour (3600 seconds)",
            "invalidation": "on new reflection curated",
            "metrics": ["cache_hits", "cache_misses"]
          },
          "acceptance_criteria": [
            "Cache hit rate ≥ 60% after 1 week",
            "Cache invalidation works correctly",
            "Cached queries < 10ms",
            "Cache miss queries < 100ms"
          ],
          "test": "tests/ace-integration/16-redis-caching.test.sh"
        },
        {
          "id": "5.2",
          "name": "Telemetry Hooks",
          "file": "Multiple ACE skill files",
          "description": "Add timing metrics to all operations",
          "metrics": [
            {
              "operation": "reflect",
              "measure": "reflection_time_ms"
            },
            {
              "operation": "query",
              "measure": "query_time_ms"
            },
            {
              "operation": "inject",
              "measure": "injection_time_ms"
            },
            {
              "operation": "curate",
              "measure": "curation_time_ms"
            }
          ],
          "storage": {
            "table": "ace_telemetry",
            "fields": ["operation", "duration_ms", "task_id", "success", "error_message", "timestamp"]
          },
          "acceptance_criteria": [
            "All ACE operations instrumented",
            "Telemetry overhead < 5ms",
            "Success/failure tracked",
            "Errors logged with stack trace"
          ],
          "test": "tests/ace-integration/17-telemetry.test.sh"
        },
        {
          "id": "5.3",
          "name": "ACE Dashboard Command",
          "file": ".claude/commands/cfn/ace-dashboard.md",
          "description": "Create dashboard for ACE system",
          "dashboard_sections": [
            "Statistics (last 30 days): reflections, curated lessons, storage",
            "Performance metrics: cache hit rate, query times",
            "Most reused lessons with success rates",
            "Recurring issues from pattern detection",
            "Learning trends: context reuse, iteration improvements"
          ],
          "acceptance_criteria": [
            "Dashboard renders in terminal (ASCII art)",
            "All metrics accurate",
            "Performance against targets shown",
            "Trends calculated correctly"
          ],
          "test": "tests/ace-integration/18-dashboard.test.sh"
        },
        {
          "id": "5.4",
          "name": "Performance Tuning",
          "description": "Optimize for production scale",
          "optimizations": [
            {
              "area": "SQLite",
              "tasks": [
                "Analyze query plans (EXPLAIN QUERY PLAN)",
                "Optimize indexes (covering indexes)",
                "Vacuum database weekly",
                "Enable WAL mode for concurrency"
              ]
            },
            {
              "area": "Queries",
              "tasks": [
                "Batch reflection storage",
                "Limit result sets (max 100 contexts)",
                "Use prepared statements",
                "Connection pooling"
              ]
            }
          ],
          "acceptance_criteria": [
            "Query time < 100ms at 10,000 reflections",
            "No performance regression under load",
            "Memory usage < 50MB for ACE operations",
            "Storage growth < 10MB/month"
          ],
          "test": "tests/ace-integration/19-performance-scale.test.sh"
        },
        {
          "id": "5.5",
          "name": "Production Deployment Checklist",
          "file": "docs/ACE_DEPLOYMENT.md",
          "checklist": [
            "All Phase 1-5 tests passing",
            "Performance benchmarks met",
            "Configuration validated",
            "Backup strategy for SQLite",
            "Rollback procedure tested",
            "Documentation complete",
            "Product Owner approval",
            "Stakeholder training completed"
          ]
        }
      ],
      "success_metrics": [
        "Cache hit rate ≥ 60%",
        "All operation times within targets",
        "Dashboard accurate and useful",
        "No production incidents in first week",
        "Product Owner approves for general availability"
      ]
    }
  ],

  "configuration": {
    "file": ".claude/config/ace-integration.json",
    "schema": {
      "ace_integration": {
        "enabled": true,
        "reflection": {
          "trigger": "proceed_decision",
          "mode": "background",
          "auto_curate": true,
          "min_confidence": 0.70,
          "scrub_secrets": true,
          "timeout_seconds": 60
        },
        "context_lookup": {
          "enabled": true,
          "similarity_threshold": 0.70,
          "max_results": 5,
          "recency_weight": 0.15,
          "cache_ttl": 3600,
          "query_timeout_ms": 200
        },
        "context_injection": {
          "enabled": true,
          "max_lessons_per_category": 3,
          "include_anti_patterns": true,
          "include_edge_cases": true,
          "max_context_size": 2000
        },
        "storage": {
          "ttl_days": 90,
          "max_reflections": 1000,
          "compression": true,
          "cleanup_cron": "0 2 * * 0"
        },
        "pattern_detection": {
          "enabled": true,
          "window_days": 30,
          "min_occurrences": 3,
          "cron": "0 9 * * 1",
          "notify_email": "product-owner@company.com"
        },
        "telemetry": {
          "enabled": true,
          "retention_days": 30
        }
      }
    }
  },

