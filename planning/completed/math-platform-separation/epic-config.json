{
  "epic": {
    "id": "MATH-001",
    "name": "Math Intelligence Platform Separation",
    "description": "Extract math-focused components into standalone math-intelligence-platform project, following SEO separation pattern. Create independent project that depends on CFN for orchestration while containing math-specific agents, skills, Trigger.dev tasks, and RuVector collections.",
    "status": "planned",
    "priority": "high",
    "startDate": "2025-12-04",
    "targetDate": "2026-01-15",
    "owner": "Architecture Team",
    "stakeholders": ["Product", "Engineering", "Math Domain Experts"],
    "references": {
      "separationPlan": "planning/MATH_PROJECT_SEPARATION_PLAN.md",
      "seoMigrationCommit": "8737157a6",
      "cfnVersion": "2.18.1"
    }
  },
  "objectives": [
    "Create standalone math-intelligence-platform with zero CFN modifications",
    "Implement 8 specialized math agents for domain expertise",
    "Build 6+ math computation skills (equation-solver, proof-assistant, etc.)",
    "Integrate with shared Trigger.dev v4 infrastructure",
    "Create math-specific RuVector collections for semantic search",
    "Maintain unidirectional dependency (Math → CFN, never CFN → Math)",
    "Achieve complete separation like SEO project (0 CFN references after setup)"
  ],
  "successCriteria": [
    {
      "criterion": "Zero CFN modifications required",
      "measurement": "Git diff shows 0 changed files in claude-flow-novice/",
      "threshold": "0 files"
    },
    {
      "criterion": "Full CFN Loop support",
      "measurement": "Execute /cfn-loop-cli 'solve equation' successfully",
      "threshold": "100% success rate"
    },
    {
      "criterion": "Agent spawning via CFN",
      "measurement": "Math agents spawn using cfn-agent-lifecycle",
      "threshold": "All 8 agents functional"
    },
    {
      "criterion": "Trigger.dev task execution",
      "measurement": "Math tasks execute on shared infrastructure",
      "threshold": "3+ tasks deployed and functional"
    },
    {
      "criterion": "RuVector semantic search",
      "measurement": "Query math collections successfully",
      "threshold": "3 collections with >100 items each"
    },
    {
      "criterion": "Environment variable reuse",
      "measurement": "All CFN env vars work in math project",
      "threshold": "100% compatibility"
    },
    {
      "criterion": "Clean separation",
      "measurement": "No production code dependencies between projects",
      "threshold": "0 bidirectional imports"
    }
  ],
