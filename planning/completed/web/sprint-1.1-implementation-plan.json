{
  "sprint": "1.1",
  "name": "Monorepo Setup & Workspace Configuration",
  "epic": "epic-unified-web-portal",
  "duration": "3-4 days",
  "overview": {
    "objective": "Establish monorepo foundation with npm workspaces for unified web portal consolidation",
    "scope": "Create workspace structure, deduplicate dependencies from 8 portals, setup SWC build pipeline",
    "current_portals": {
      "total": 8,
      "size": "714MB",
      "locations": [
        "src/web/frontend (671MB) - Transparency Portal with React",
        "src/web/dashboard - Web dashboard components",
        "src/dashboard (204KB) - Fleet Dashboard components",
        "src/ui/console - Console UI",
        "src/ui/web-ui - Web UI components",
        "monitor/dashboard (9.3MB) - Premium monitoring dashboard",
        ".claude-flow/dashboard - Analytics dashboard",
        "Phase 4 dashboard (referenced in planning)"
      ]
    },
    "target_structure": {
      "total_packages": 2,
      "size_target": "300MB",
      "reduction": "58%"
    }
  },
  "tasks": [
    {
      "id": "task-1.1.1",
      "title": "Create Workspace Structure",
      "priority": "critical",
      "estimated_effort": "1 day",
      "dependencies": [],
      "implementation": {
        "directory_structure": {
          "root_workspace": {
            "path": "packages/",
            "purpose": "Top-level npm workspaces directory",
            "packages": [
              "web-portal",
              "web-components"
            ]
          },
          "web_portal_package": {
            "path": "packages/web-portal/",
            "purpose": "Main unified web portal SPA - consolidates all 8 portal UIs",
            "structure": {
              "src/": {
                "purpose": "All source code organized by domain",
                "subdirectories": {
                  "client/": {
                    "purpose": "Frontend React application",
                    "subdirectories": {
                      "app/": "Root App component, providers, routing setup",
                      "views/": "9 main view components (Dashboard, Transparency, Swarm, EventBus, Analytics, Settings, AgentHierarchy, Performance, Logs)",
                      "layouts/": "Layout components (MainLayout, AuthLayout, ErrorBoundary)",
                      "hooks/": "Custom React hooks (useWebSocket, useAuth, useTheme, useStore)",
                      "utils/": "Client utilities (formatting, validation, helpers)",
                      "styles/": "Global styles, theme definitions, CSS modules",
                      "assets/": "Static assets (images, icons, fonts)"
                    }
                  },
                  "server/": {
                    "purpose": "Express backend server consolidating 3 servers",
                    "subdirectories": {
                      "api/": "REST API endpoints (7 routes: /agents, /metrics, /swarms, /events, /transparency, /auth, /config)",
                      "middleware/": "Express middleware (auth, validation, error handling, rate limiting)",
                      "services/": "Business logic services (TransparencyService, SwarmService, EventBusService, MetricsService)",
                      "websocket/": "Socket.IO server implementation",
                      "config/": "Server configuration files"
                    }
                  },
                  "shared/": {
                    "purpose": "Code shared between client and server",
                    "subdirectories": {
                      "types/": "TypeScript interfaces and types",
                      "constants/": "Shared constants (API endpoints, event types, config)",
                      "validators/": "Shared validation schemas (Zod schemas)",
                      "utils/": "Shared utility functions"
                    }
                  },
                  "integrations/": {
                    "purpose": "Integration layer with core systems",
                    "subdirectories": {
                      "transparency/": "Transparency system integration",
                      "swarm/": "Swarm coordination integration",
                      "eventbus/": "EventBus integration",
                      "redis/": "Redis client and utilities"
                    }
                  }
                }
              },
              "public/": {
                "purpose": "Static files served by React app",
                "files": [
                  "index.html",
                  "favicon.ico",
                  "manifest.json",
                  "robots.txt"
                ]
              },
              "config/": {
                "purpose": "Build and configuration files",
                "files": [
                  "webpack.config.js",
                  "jest.config.js",
                  ".env.example"
                ]
              },
              "tests/": {
                "purpose": "Test files organized by type",
                "subdirectories": {
                  "unit/": "Unit tests for components, services, utilities",
                  "integration/": "Integration tests for API endpoints, WebSocket",
                  "e2e/": "End-to-end tests with Playwright"
                }
              }
            }
          },
          "web_components_package": {
            "path": "packages/web-components/",
            "purpose": "Shared React component library - extracted from 8 portals",
            "structure": {
              "src/": {
                "purpose": "Component library source code",
                "subdirectories": {
                  "components/": {
                    "purpose": "8 unified components",
                    "components": [
                      "AgentHierarchyVisualization/ - Consolidates 4 duplicate visualizations",
                      "MetricsChart/ - Real-time metrics with Recharts",
                      "SwarmStatus/ - Swarm state visualization",
                      "EventBusMonitor/ - EventBus activity monitor",
                      "TransparencyPanel/ - Transparency system UI",
                      "PerformanceGraph/ - Performance metrics display",
                      "LogViewer/ - Log streaming component",
                      "AuthenticationForm/ - Login/auth UI"
                    ]
                  },
                  "hooks/": "Shared React hooks for components",
                  "utils/": "Component utilities and helpers",
                  "types/": "Component prop types and interfaces",
                  "styles/": "Component-specific styles"
                }
              },
              "dist/": {
                "purpose": "Compiled component library",
                "generated": true
              }
            }
          }
        },
        "file_templates": {
          "root_package_json": {
            "path": "package.json",
            "purpose": "Root workspace configuration",
            "template": {
              "name": "claude-flow-novice-web",
              "version": "3.0.0",
              "private": true,
              "workspaces": [
                "packages/*"
              ],
              "scripts": {
                "dev": "npm run dev --workspace=web-portal",
                "build": "npm run build --workspaces",
                "test": "npm run test --workspaces",
                "lint": "npm run lint --workspaces"
              }
            }
          },
          "web_portal_package_json": {
            "path": "packages/web-portal/package.json",
            "purpose": "Main portal package configuration"
          },
          "web_components_package_json": {
            "path": "packages/web-components/package.json",
            "purpose": "Component library package configuration"
          },
          "portal_tsconfig": {
            "path": "packages/web-portal/tsconfig.json",
            "purpose": "TypeScript configuration for web portal"
          },
          "components_tsconfig": {
            "path": "packages/web-components/tsconfig.json",
            "purpose": "TypeScript configuration for components"
          },
          "portal_readme": {
            "path": "packages/web-portal/README.md",
            "purpose": "Portal documentation and usage guide"
          },
          "components_readme": {
            "path": "packages/web-components/README.md",
            "purpose": "Component library documentation"
          }
        },
        "naming_conventions": {
          "files": {
            "components": "PascalCase (AgentHierarchyVisualization.tsx)",
            "utilities": "camelCase (formatMetrics.ts)",
            "types": "kebab-case (agent-types.ts)",
            "tests": "ComponentName.test.tsx or utility.test.ts"
          },
          "directories": {
            "pattern": "kebab-case",
            "examples": [
              "agent-hierarchy",
              "metrics-chart",
              "event-bus-monitor"
            ]
          },
          "imports": {
            "workspace": "@web-portal/* and @web-components/*",
            "internal": "Relative paths with explicit .js extension"
          }
        },
        "migration_steps": [
          {
            "step": 1,
            "action": "Create packages/ directory structure",
            "commands": [
              "mkdir -p packages/web-portal/src/{client,server,shared,integrations}",
              "mkdir -p packages/web-portal/src/client/{app,views,layouts,hooks,utils,styles,assets}",
              "mkdir -p packages/web-portal/src/server/{api,middleware,services,websocket,config}",
              "mkdir -p packages/web-portal/src/shared/{types,constants,validators,utils}",
              "mkdir -p packages/web-portal/src/integrations/{transparency,swarm,eventbus,redis}",
              "mkdir -p packages/web-portal/{public,config,tests}",
              "mkdir -p packages/web-components/src/{components,hooks,utils,types,styles}"
            ]
          },
          {
            "step": 2,
            "action": "Initialize package.json files",
            "commands": [
              "npm init -w packages/web-portal",
              "npm init -w packages/web-components"
            ]
          },
          {
            "step": 3,
            "action": "Create README.md files for documentation",
            "files": [
              "packages/web-portal/README.md",
              "packages/web-components/README.md"
            ]
          },
          {
            "step": 4,
            "action": "Setup .gitkeep files for empty directories",
            "note": "Ensure directory structure is preserved in git"
          }
        ]
      },
      "acceptance_criteria": [
        "packages/ directory exists with web-portal and web-components subdirectories",
        "All subdirectories created with proper naming conventions",
        "package.json files exist in root and both packages",
        "README.md files exist with placeholder content",
        "Directory structure matches specification exactly",
        "No files in src/ directories yet (migration happens in Sprint 1.2)"
      ],
      "validation_commands": [
        "tree packages/ -L 3",
        "npm ls --workspaces",
        "test -f packages/web-portal/package.json",
        "test -f packages/web-components/package.json"
      ]
    },
    {
