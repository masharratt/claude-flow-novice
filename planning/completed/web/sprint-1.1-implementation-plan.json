    {
      "id": "task-1.1.3",
      "title": "Setup Build Pipeline",
      "priority": "high",
      "estimated_effort": "1 day",
      "dependencies": [
        "task-1.1.1",
        "task-1.1.2"
      ],
      "implementation": {
        "typescript_config": {
          "base_tsconfig": {
            "path": "tsconfig.base.json",
            "purpose": "Shared TypeScript configuration for all packages",
            "config": {
              "compilerOptions": {
                "target": "ES2022",
                "module": "ESNext",
                "moduleResolution": "Bundler",
                "lib": [
                  "ES2022",
                  "DOM",
                  "DOM.Iterable"
                ],
                "jsx": "react-jsx",
                "strict": true,
                "esModuleInterop": true,
                "skipLibCheck": true,
                "forceConsistentCasingInFileNames": true,
                "resolveJsonModule": true,
                "isolatedModules": true,
                "declaration": true,
                "declarationMap": true,
                "sourceMap": true,
                "noUnusedLocals": true,
                "noUnusedParameters": true,
                "noImplicitReturns": true,
                "noFallthroughCasesInSwitch": true,
                "allowSyntheticDefaultImports": true,
                "baseUrl": ".",
                "paths": {
                  "@web-portal/*": [
                    "packages/web-portal/src/*"
                  ],
                  "@web-components/*": [
                    "packages/web-components/src/*"
                  ]
                }
              },
              "exclude": [
                "node_modules",
                "dist",
                "build",
                "**/*.test.ts",
                "**/*.test.tsx",
                "**/*.spec.ts",
                "**/*.spec.tsx"
              ]
            }
          },
          "portal_tsconfig": {
            "path": "packages/web-portal/tsconfig.json",
            "purpose": "TypeScript config for web portal (client + server)",
            "config": {
              "extends": "../../tsconfig.base.json",
              "compilerOptions": {
                "outDir": "./dist",
                "rootDir": "./src",
                "composite": true,
                "types": [
                  "node",
                  "vite/client"
                ]
              },
              "include": [
                "src/**/*"
              ],
              "references": [
                {
                  "path": "../web-components"
                }
              ]
            }
          },
          "components_tsconfig": {
            "path": "packages/web-components/tsconfig.json",
            "purpose": "TypeScript config for component library",
            "config": {
              "extends": "../../tsconfig.base.json",
              "compilerOptions": {
                "outDir": "./dist",
                "rootDir": "./src",
                "composite": true,
                "declaration": true,
                "emitDeclarationOnly": false
              },
              "include": [
                "src/**/*"
              ]
            }
          }
        },
        "swc_config": {
          "portal_swcrc": {
            "path": "packages/web-portal/.swcrc",
            "purpose": "SWC compilation config for portal server-side code",
            "config": {
              "jsc": {
                "target": "es2022",
                "parser": {
                  "syntax": "typescript",
                  "tsx": true,
                  "decorators": true,
                  "dynamicImport": true
                },
                "transform": {
                  "react": {
                    "runtime": "automatic",
                    "development": false,
                    "refresh": false
                  }
                },
                "keepClassNames": true,
                "loose": false
              },
              "module": {
                "type": "es6",
                "strict": true,
                "strictMode": true,
                "noInterop": false
              },
              "minify": false,
              "sourceMaps": true,
              "inlineSourcesContent": false
            }
          },
          "components_swcrc": {
            "path": "packages/web-components/.swcrc",
            "purpose": "SWC compilation config for component library",
            "config": {
              "jsc": {
                "target": "es2022",
                "parser": {
                  "syntax": "typescript",
                  "tsx": true
                },
                "transform": {
                  "react": {
                    "runtime": "automatic"
                  }
                }
              },
              "module": {
                "type": "es6"
              },
              "minify": false,
              "sourceMaps": true
            }
          }
        },
        "build_scripts": {
          "root_package_scripts": {
            "path": "package.json",
            "scripts": {
              "dev": "npm run dev --workspace=web-portal",
              "dev:all": "concurrently \"npm run dev:portal\" \"npm run dev:components\"",
              "dev:portal": "npm run dev --workspace=web-portal",
              "dev:components": "npm run dev --workspace=web-components",
              "build": "turbo run build",
              "build:portal": "npm run build --workspace=web-portal",
              "build:components": "npm run build --workspace=web-components",
              "test": "turbo run test",
              "test:watch": "turbo run test:watch",
              "lint": "turbo run lint",
              "lint:fix": "turbo run lint:fix",
              "type-check": "turbo run type-check",
              "clean": "turbo run clean && rm -rf node_modules/.cache"
            }
          },
          "portal_package_scripts": {
            "path": "packages/web-portal/package.json",
            "scripts": {
              "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
              "dev:client": "vite --port 3001",
              "dev:server": "tsx watch src/server/index.ts",
              "build": "npm run build:client && npm run build:server",
              "build:client": "vite build",
              "build:server": "swc src/server -d dist/server --config-file .swcrc",
              "build:types": "tsc --emitDeclarationOnly",
              "preview": "vite preview",
              "start": "node dist/server/index.js",
              "test": "vitest run",
              "test:watch": "vitest",
              "test:ui": "vitest --ui",
              "test:e2e": "playwright test",
              "lint": "eslint src --ext .ts,.tsx",
              "lint:fix": "eslint src --ext .ts,.tsx --fix",
              "type-check": "tsc --noEmit",
              "clean": "rm -rf dist build .vite"
            }
          },
          "components_package_scripts": {
            "path": "packages/web-components/package.json",
            "scripts": {
              "dev": "npm run storybook",
              "build": "npm run build:lib && npm run build:types",
              "build:lib": "swc src -d dist --config-file .swcrc",
              "build:types": "tsc --emitDeclarationOnly",
              "build:watch": "swc src -d dist --watch --config-file .swcrc",
              "test": "vitest run",
              "test:watch": "vitest",
              "lint": "eslint src --ext .ts,.tsx",
              "lint:fix": "eslint src --ext .ts,.tsx --fix",
              "type-check": "tsc --noEmit",
              "storybook": "storybook dev -p 6006",
              "build-storybook": "storybook build",
              "clean": "rm -rf dist storybook-static"
            }
          }
        },
        "vite_config": {
          "path": "packages/web-portal/vite.config.ts",
          "purpose": "Vite configuration for React SPA",
          "config": {
            "import": [
              "import { defineConfig } from 'vite'",
              "import react from '@vitejs/plugin-react-swc'",
              "import path from 'path'"
            ],
            "defineConfig": {
              "plugins": [
                "react()"
              ],
              "resolve": {
                "alias": {
                  "@": "path.resolve(__dirname, './src/client')",
                  "@shared": "path.resolve(__dirname, './src/shared')",
                  "@components": "path.resolve(__dirname, '../web-components/src')"
                }
              },
              "server": {
                "port": 3001,
                "proxy": {
                  "/api": {
                    "target": "http://localhost:3000",
                    "changeOrigin": true
                  },
                  "/socket.io": {
                    "target": "http://localhost:3000",
                    "ws": true
                  }
                }
              },
              "build": {
                "outDir": "dist/client",
                "sourcemap": true,
                "rollupOptions": {
                  "output": {
                    "manualChunks": {
                      "vendor": [
                        "react",
                        "react-dom",
                        "react-router-dom"
                      ],
                      "mui": [
                        "@mui/material",
                        "@mui/icons-material"
                      ],
                      "charts": [
                        "recharts",
                        "chart.js"
                      ]
                    }
                  }
                }
              },
              "optimizeDeps": {
                "include": [
                  "react",
                  "react-dom",
                  "@mui/material",
                  "recharts"
                ]
              }
            }
          }
        },
        "turbo_config": {
          "path": "turbo.json",
          "purpose": "Turbo monorepo build orchestration",
          "config": {
            "$schema": "https://turbo.build/schema.json",
            "pipeline": {
              "build": {
                "dependsOn": [
                  "^build"
                ],
                "outputs": [
                  "dist/**",
                  "build/**"
                ]
              },
              "test": {
                "dependsOn": [
                  "build"
                ],
                "outputs": [
                  "coverage/**"
                ]
              },
              "lint": {
                "outputs": []
              },
              "type-check": {
                "outputs": []
              },
              "dev": {
                "cache": false,
                "persistent": true
              }
            }
          }
        },
        "migration_steps": [
          {
            "step": 1,
            "action": "Create base TypeScript configuration",
            "file": "tsconfig.base.json",
            "validation": "tsc --showConfig"
          },
          {
            "step": 2,
            "action": "Create package-specific tsconfig.json files",
            "files": [
              "packages/web-portal/tsconfig.json",
              "packages/web-components/tsconfig.json"
            ],
            "validation": "tsc --noEmit in each package"
          },
          {
            "step": 3,
            "action": "Create SWC configuration files",
            "files": [
              "packages/web-portal/.swcrc",
              "packages/web-components/.swcrc"
            ]
          },
          {
            "step": 4,
            "action": "Create Vite configuration for web-portal",
            "file": "packages/web-portal/vite.config.ts"
          },
          {
            "step": 5,
            "action": "Create Turbo configuration for monorepo",
            "file": "turbo.json"
          },
          {
            "step": 6,
            "action": "Update package.json scripts in all packages",
            "files": [
              "package.json",
              "packages/web-portal/package.json",
              "packages/web-components/package.json"
            ]
          },
          {
            "step": 7,
            "action": "Install build tools",
            "commands": [
              "npm install -D turbo concurrently --workspace-root",
              "npm install -D vite @vitejs/plugin-react-swc --workspace=web-portal",
              "npm install -D @swc/cli @swc/core --workspaces"
            ]
          },
          {
            "step": 8,
            "action": "Test build pipeline",
            "commands": [
              "npm run type-check",
              "npm run build:components",
              "npm run build:portal"
            ]
          }
        ]
      },
      "acceptance_criteria": [
        "All TypeScript configurations compile without errors",
        "SWC successfully compiles server-side code",
        "Vite builds React SPA under 2MB gzipped",
        "Turbo orchestrates builds in correct order",
        "Watch mode works for development",
        "Source maps generated for debugging",
        "Build completes in under 30 seconds",
        "Type checking passes for all packages",
        "No circular dependencies in build graph"
      ],
      "validation_commands": [
        "npm run type-check",
        "npm run build",
        "du -sh packages/web-portal/dist/client",
        "ls -lh packages/web-portal/dist/client/**/*.map",
        "time npm run build",
        "npm run lint"
      ]
    }
  ],
