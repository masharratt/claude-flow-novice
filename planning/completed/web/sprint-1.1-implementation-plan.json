        "migration_steps": [
          {
            "step": 1,
            "action": "Audit all portal package.json files",
            "commands": [
              "cat src/web/frontend/package.json",
              "cat src/dashboard/package.json",
              "cat package.json"
            ]
          },
          {
            "step": 2,
            "action": "Create unified package.json for web-portal",
            "output": "packages/web-portal/package.json"
          },
