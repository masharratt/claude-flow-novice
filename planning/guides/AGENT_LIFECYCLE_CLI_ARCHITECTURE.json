{
  "document_metadata": {
    "title": "Agent Lifecycle CLI Commands Architecture",
    "version": "1.0.0",
    "created": "2025-10-11",
    "status": "Design Complete - Ready for Implementation",
    "confidence": 0.92,
    "architect": "system-architect-agent",
    "design_phase": "Phase 4 - CLI Tool Implementation"
  },

  "executive_summary": {
    "objective": "Enable agents to execute their lifecycle hooks through CLI commands with SQLite persistence, ACL enforcement, and CFN Loop integration",
    "approach": "Extend existing CLI architecture with new agent-lifecycle parent command containing 5 subcommands (spawn, complete, update, list, inspect)",
    "key_benefits": [
      "Agents can execute documented lifecycle patterns via Bash tool",
      "SQLite persistence provides audit trail and cross-session recovery",
      "ACL enforcement prevents unauthorized data access",
      "CFN Loop confidence reporting becomes operational",
      "Existing schema in src/sqlite/schema.sql and src/lifecycle/memory-schema.ts can be reused"
    ],
    "implementation_complexity": "Medium",
    "estimated_effort": "12-16 hours"
  },

  "command_structure": {
    "parent_command": "agent-lifecycle",
    "registration_location": "src/cli/commands/agent-lifecycle.ts",
    "cli_integration": "src/cli/commands/index.ts (setupCommands function)",
    "subcommands": [
      {
        "name": "spawn",
        "description": "Register agent in SQLite on spawn with ACL level",
        "usage": "claude-flow-novice agent-lifecycle spawn --id <id> --type <type> --acl-level <level>",
        "parameters": {
          "required": [
            { "flag": "--id", "type": "string", "description": "Unique agent ID (format: agent-type-N)" },
            { "flag": "--type", "type": "string", "description": "Agent type (coder, reviewer, architect, etc.)" }
          ],
          "optional": [
            { "flag": "--acl-level", "type": "integer", "default": 1, "description": "ACL level (1-6, default: 1 for implementers)" },
            { "flag": "--swarm-id", "type": "string", "description": "Swarm ID for coordination" },
            { "flag": "--capabilities", "type": "json", "description": "JSON array of capabilities" },
            { "flag": "--metadata", "type": "json", "description": "JSON metadata" }
          ]
        },
        "output": {
          "success": { "format": "json", "fields": ["agent_id", "type", "acl_level", "spawned_at"] },
          "error": { "format": "json", "fields": ["error", "code", "details"] }
        },
        "exit_codes": { "success": 0, "validation_error": 1, "database_error": 2 }
      },
      {
        "name": "complete",
        "description": "Mark agent as completed and store confidence score",
        "usage": "claude-flow-novice agent-lifecycle complete --id <id> --confidence <score>",
        "parameters": {
          "required": [
            { "flag": "--id", "type": "string", "description": "Agent ID to complete" },
            { "flag": "--confidence", "type": "float", "description": "Confidence score (0.0-1.0)" }
          ],
          "optional": [
            { "flag": "--files", "type": "json", "description": "JSON array of modified files" },
            { "flag": "--reasoning", "type": "string", "description": "Explanation of confidence score" },
            { "flag": "--blockers", "type": "json", "description": "JSON array of blockers encountered" }
          ]
        },
        "output": {
          "success": { "format": "json", "fields": ["agent_id", "confidence", "status", "completed_at", "duration_ms"] },
          "error": { "format": "json", "fields": ["error", "code", "details"] }
        },
        "exit_codes": { "success": 0, "agent_not_found": 1, "invalid_confidence": 2, "database_error": 3 }
      },
      {
        "name": "update",
        "description": "Update agent status during execution",
        "usage": "claude-flow-novice agent-lifecycle update --id <id> --status <status>",
        "parameters": {
          "required": [
            { "flag": "--id", "type": "string", "description": "Agent ID to update" },
            { "flag": "--status", "type": "string", "description": "New status (active, in_progress, idle, suspended)" }
          ],
          "optional": [
            { "flag": "--progress", "type": "integer", "description": "Progress percentage (0-100)" },
            { "flag": "--metadata", "type": "json", "description": "JSON metadata to merge" }
          ]
        },
        "output": {
          "success": { "format": "json", "fields": ["agent_id", "status", "updated_at"] },
          "error": { "format": "json", "fields": ["error", "code", "details"] }
        },
        "exit_codes": { "success": 0, "agent_not_found": 1, "invalid_status": 2, "database_error": 3 }
      },
      {
        "name": "list",
        "description": "List agents with filtering and formatting options",
        "usage": "claude-flow-novice agent-lifecycle list [options]",
        "parameters": {
          "optional": [
            { "flag": "--status", "type": "string", "description": "Filter by status" },
            { "flag": "--type", "type": "string", "description": "Filter by agent type" },
            { "flag": "--swarm-id", "type": "string", "description": "Filter by swarm ID" },
            { "flag": "--format", "type": "string", "default": "table", "description": "Output format (table, json)" },
            { "flag": "--limit", "type": "integer", "description": "Limit number of results" }
          ]
        },
        "output": {
          "table": {
            "columns": ["ID", "Type", "Status", "ACL", "Spawned", "Updated", "Confidence"]
          },
          "json": {
            "format": "array",
            "item_fields": ["id", "type", "status", "acl_level", "spawned_at", "updated_at", "confidence"]
          }
        },
        "exit_codes": { "success": 0, "database_error": 1 }
      },
      {
        "name": "inspect",
        "description": "Detailed inspection of agent lifecycle",
        "usage": "claude-flow-novice agent-lifecycle inspect <agent-id>",
        "parameters": {
          "required": [
            { "argument": "agent-id", "type": "string", "description": "Agent ID to inspect" }
          ],
          "optional": [
            { "flag": "--format", "type": "string", "default": "pretty", "description": "Output format (pretty, json)" },
            { "flag": "--include-history", "type": "boolean", "default": false, "description": "Include state history" },
            { "flag": "--include-metrics", "type": "boolean", "default": false, "description": "Include performance metrics" }
          ]
        },
        "output": {
          "pretty": {
            "sections": ["Agent Info", "Current State", "Performance Metrics", "State History (if requested)"]
          },
          "json": {
            "fields": ["agent", "lifecycle_record", "state_history", "metrics"]
          }
        },
        "exit_codes": { "success": 0, "agent_not_found": 1, "database_error": 2 }
      }
    ]
  },

  "database_integration": {
    "schema_location": "src/sqlite/schema.sql",
    "primary_table": "agents",
    "lifecycle_tables": [
      "agent_lifecycle_records (src/lifecycle/memory-schema.ts)",
      "agent_state_history (src/lifecycle/memory-schema.ts)",
      "audit_log (src/sqlite/schema.sql)"
    ],
    "schema_reuse": {
      "agents_table": {
        "path": "src/sqlite/schema.sql",
        "lines": "14-31",
        "columns_used": ["id", "name", "type", "status", "swarm_id", "capabilities", "metadata", "acl_level", "created_at", "updated_at"]
      },
      "agent_lifecycle_records": {
        "path": "src/lifecycle/memory-schema.ts",
        "lines": "29-47",
        "columns_used": ["agent_id", "session_id", "current_state", "previous_state", "created_at", "updated_at", "metadata_json", "performance_json"]
      },
      "audit_log": {
        "path": "src/sqlite/schema.sql",
        "lines": "196-216",
        "columns_used": ["id", "entity_id", "entity_type", "action", "changed_by", "swarm_id", "acl_level", "created_at"]
      }
    },
    "no_migrations_required": "Existing schema supports all required operations",
    "acl_enforcement": {
      "levels": {
        "1": "Private (agent-scoped data - implementers)",
        "2": "Team (shared within team)",
        "3": "Swarm (shared across swarm - validators, coordinators)",
        "4": "Project (strategic decisions - product owner)",
        "5": "Public (system-wide)",
        "6": "System (infrastructure)"
      },
      "validation": "Check acl_level in agents table matches agent type conventions"
    }
  },

  "implementation_details": {
    "file_locations": {
      "command_implementation": "src/cli/commands/agent-lifecycle.ts",
      "registration": "src/cli/commands/index.ts",
      "types": "src/types/agent-lifecycle-cli-types.ts",
      "database_operations": "src/core/agent-lifecycle-operations.ts"
    },
    "dependencies": {
      "internal": [
        "better-sqlite3 (existing)",
        "src/lifecycle/memory-schema.ts (SQLiteLifecycleMemoryManager)",
        "src/core/persistence.ts (PersistenceManager)",
        "src/core/logger.js"
      ],
      "external": [
        "commander (existing CLI framework)",
        "cli-table3 (existing for table output)",
        "chalk (existing for colors)"
      ]
    },
    "integration_strategy": {
      "pattern": "Follow recovery-status.ts pattern",
      "steps": [
        "1. Create AgentLifecycleCommands class with handler methods",
        "2. Use SQLiteLifecycleMemoryManager for database operations",
        "3. Export registerAgentLifecycleCommands function",
        "4. Register in src/cli/commands/index.ts setupCommands",
        "5. Add to CLI help system"
      ]
    },
    "error_handling": {
      "database_errors": {
        "SQLITE_BUSY": "Retry with exponential backoff (100ms, 200ms, 400ms)",
        "SQLITE_LOCKED": "Wait for lock release with timeout",
        "SQLITE_CONSTRAINT": "Return validation error with details"
      },
      "validation_errors": {
        "invalid_agent_id": "Format: agent-type-N (e.g., coder-1)",
        "invalid_confidence": "Must be 0.0-1.0 inclusive",
        "invalid_acl_level": "Must be 1-6 inclusive",
        "invalid_status": "Must be: active, in_progress, idle, suspended, completed, terminated"
      },
      "not_found_errors": {
        "agent_not_found": "Return descriptive error with agent ID",
        "swarm_not_found": "Return warning, allow operation to continue"
      },
      "graceful_degradation": {
        "sqlite_unavailable": "Log error, suggest manual SQLite check",
        "no_fallback": "SQLite is critical for lifecycle, no Redis fallback"
      }
    }
  },

  "cfn_loop_integration": {
    "loop_3_confidence_reporting": {
      "command": "claude-flow-novice agent-lifecycle complete --id <id> --confidence <score> --files <json> --reasoning <text>",
      "storage": {
        "table": "agents (status, updated_at)",
        "memory_key": "cfn/phase-{phaseId}/loop3/agent-{agentId}",
        "acl_level": 1,
        "ttl": 2592000
      },
      "gate_criteria": {
        "pass": "confidence >= 0.75",
        "fail": "confidence < 0.75",
        "action_on_pass": "Proceed to Loop 2 validation",
        "action_on_fail": "Retry Loop 3 with targeted improvements"
      }
    },
    "loop_2_validation": {
      "command": "claude-flow-novice agent-lifecycle list --swarm-id <swarmId> --format json",
      "usage": "Validators query Loop 3 agent confidence scores",
      "consensus_calculation": "Average confidence across all Loop 3 agents",
      "acl_level": 3
    },
    "loop_4_product_owner": {
      "command": "claude-flow-novice agent-lifecycle inspect <agentId> --include-history --format json",
      "usage": "Product owner reads full lifecycle data for GOAP decision",
      "acl_level": 4
    }
  },

