# Node modules (will be installed in container)
node_modules/
npm-debug.log
yarn-error.log

# Build artifacts (will be built in container)
# dist/ - COMMENTED OUT: Using prebuilt dist/ directory in production image
*.tsbuildinfo

# Development files
.git/
.github/
.vscode/
.idea/

# Test files
tests/
*.test.ts
*.test.js
*.spec.ts
*.spec.js
__tests__/

# Documentation
docs/

# Exclude markdown files EXCEPT essential ones
# NOTE: Wildcard MUST come BEFORE negations in Docker
*.md
!README.md
!CLAUDE.md
!.claude/**/*.md
!claude-assets/**/*.md

# License file (explicitly include)
!LICENSE

# Environment files
.env
.env.local
.env.*.local

# Logs
logs/
*.log
.logs/

# Temporary files
tmp/
temp/
*.tmp
.artifacts/
.backups/
.screenshots/

# CI/CD
.github/
.circleci/
.travis.yml

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Coverage
coverage/
.nyc_output/

# Misc
.swarm/
.playwright-mcp/
