# Production Dockerignore - Optimized for minimal context

# Version Control (472MB)
.git
.gitignore
.gitattributes

# Dependencies - will be installed in container (247MB)
node_modules
npm-debug.log
yarn-error.log

# Build artifacts
dist
build
*.tsbuildinfo

# Testing
coverage
.nyc_output
tests
test
*.test.js
*.spec.js
*.test.ts
*.spec.ts

# Documentation
docs
*.md
!README.md

# Development files
.vscode
.idea
*.swp
*.swo
*~

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary files
tmp
temp
.tmp
.backups

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Environment files
.env
.env.local
.env.*.local

# Docker files (not needed in build context)
Dockerfile*
docker-compose*

# CI/CD
.github
.gitlab-ci.yml
.travis.yml
.circleci

# Analysis and reports
analysis
.artifacts
planning

# Legacy and archived directories (2.2GB)
legacy
web-portal
packages
agents
shellcheck-v0.8.0
shellcheck.tar.xz
*.tgz

# Monitoring
monitoring

# Config files not needed
.editorconfig
.eslintrc*
.prettierrc*
jest.config.js

# Large media files
*.mp4
*.mov
*.avi
*.zip
*.tar.gz
*.rar

# Essential files to include (negations)
!package.json
!package-lock.json
!.claude
!claude-assets
!scripts
!config
!src