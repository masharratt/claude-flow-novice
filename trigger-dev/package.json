{
  "name": "cfn-loop-trigger-dev",
  "version": "1.0.0",
  "description": "trigger.dev workflow for CFN Loop orchestration",
  "main": "src/v3/worker.ts",
  "type": "module",
  "trigger.dev": {
    "endpointId": "cfn-loop-workflow"
  },
  "bin": {
    "cfn-trigger": "./dist/cli/index.js"
  },
  "scripts": {
    "dev": "npx trigger.dev dev",
    "deploy": "trigger.dev deploy",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "build": "tsc",
    "build:watch": "tsc --watch"
  },
  "dependencies": {
    "@trigger.dev/sdk": "^3.0.0",
    "commander": "^12.0.0",
    "ioredis": "^5.8.2",
    "prom-client": "^15.1.3",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "dotenv": "^17.2.3",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.6.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
