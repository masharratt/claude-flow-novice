# Claude Flow Novice - Production Environment Template
# Version: 4.0.0
#
# SECURITY CRITICAL:
# - This is a TEMPLATE file. DO NOT commit real secrets to version control.
# - Copy this file to .env: cp .env.example .env
# - Generate strong passwords using: openssl rand -base64 32
# - NEVER share or commit your .env file
# - Use git-secrets or pre-commit hooks to prevent credential leaks
# - Rotate credentials every 90 days in production
#
# Password Generation:
# Generate strong credentials with this command:
#   openssl rand -base64 32  # Creates 43-character secure password

# =============================================================================
# NODE ENVIRONMENT
# =============================================================================
NODE_ENV=production

# ============================================================================
# Docker Multi-Worktree Configuration
# ============================================================================
# These variables enable running multiple worktrees with Docker Compose
# simultaneously without port/container/volume conflicts.
#
# Usage: ./scripts/docker/run-in-worktree.sh up -d
#
# The wrapper script will auto-detect your branch and configure these
# automatically. You can override them here if needed.

# Project name (auto-generated from branch name if not set)
# Format: cfn-<sanitized-branch-name>
# CFN_WORKTREE_PROJECT_NAME=cfn-my-feature

# Port offset (auto-calculated from branch name hash if not set)
# Range: 0-99 (multiplied by 100 for actual offset)
# Main/master branches always get offset 0
# CFN_WORKTREE_PORT_OFFSET=10

# ============================================================================
# Docker Service Discovery (Multi-Worktree)
# ============================================================================
# Services are accessed by name within Docker networks, NOT by container names
#
# Service names resolve automatically within Docker networks:
# - redis (not cfn-redis or cfn-redis-1)
# - postgres (not cfn-postgres or cfn-postgres-1)
# - orchestrator (not cfn-orchestrator or cfn-orchestrator-1)
#
# Connection examples:
# redis-cli -h redis -p 6379
# psql -h postgres -U postgres
# curl http://orchestrator:3001/health
#
# Container names are auto-prefixed with project name:
# ${COMPOSE_PROJECT_NAME}_service_1
#
# This approach enables:
# - Zero-configuration service discovery
# - Automatic failover support
# - Multi-worktree isolation
# - Dynamic IP management within Docker networks

# =============================================================================
# CRITICAL: SECURITY CREDENTIALS (Generate Strong Values)
# =============================================================================

# Anthropic Claude API Key
# Get from: https://console.anthropic.com/account/keys
# Format: sk-ant-v1-...
ANTHROPIC_API_KEY=sk-ant-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# PostgreSQL Root Password
# CRITICAL: Generate with: openssl rand -base64 32
POSTGRES_ROOT_PASSWORD=CHANGE_ME_GENERATE_STRONG_PASSWORD_MIN_32_CHARS

# PostgreSQL User Password
# CRITICAL: Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_STRONG_PASSWORD_MIN_32_CHARS
POSTGRES_USER=cfn_app_user
POSTGRES_DB=cfn_production

# Redis Password
# CRITICAL: Generate with: openssl rand -base64 32
REDIS_PASSWORD=CHANGE_ME_GENERATE_STRONG_PASSWORD_MIN_32_CHARS

# Grafana Admin Password
# CRITICAL: Generate with: openssl rand -base64 32
GRAFANA_PASSWORD=CHANGE_ME_GENERATE_STRONG_PASSWORD_MIN_32_CHARS
GRAFANA_USER=admin

# JWT Signing Secret
# CRITICAL: Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_GENERATE_STRONG_JWT_SECRET_MIN_64_CHARS

# Session Secret
# CRITICAL: Generate with: openssl rand -base64 64
SESSION_SECRET=CHANGE_ME_GENERATE_STRONG_SESSION_SECRET_MIN_64_CHARS

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL Connection
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
REDIS_DB=0
REDIS_PREFIX=cfn:prod:

# SQLite Database (local)
SQLITE_DB_PATH=./data/memory.db
SQLITE_WAL_ENABLED=true

# ============================================================================
# Port Mappings (Development - docker-compose.yml)
# ============================================================================
# Base ports + offset for worktree isolation
# Default values shown (main branch, offset=0)

# Redis coordination service
CFN_REDIS_PORT=6379

# PostgreSQL database
CFN_POSTGRES_PORT=5432

# ============================================================================
# Port Mappings (Production - docker-compose.production.yml)
# ============================================================================

# Orchestrator health/metrics endpoint
CFN_ORCHESTRATOR_PORT=3001

# Redis coordinator
CFN_REDIS_COORDINATOR_PORT=6380

# Prometheus monitoring
CFN_PROMETHEUS_PORT=9091

# Grafana visualization
CFN_GRAFANA_PORT=3001

# Redis exporter
CFN_REDIS_EXPORTER_PORT=9121

# Nginx reverse proxy
CFN_NGINX_HTTP_PORT=80
CFN_NGINX_HTTPS_PORT=443

# Loki log aggregation
CFN_LOKI_PORT=3100

# MCP Servers
CFN_MCP_PLAYWRIGHT_PORT=8081
CFN_MCP_REDIS_TOOLS_PORT=8082
CFN_MCP_N8N_PORT=8083
CFN_MCP_SECURITY_SCANNER_PORT=8084

# ============================================================================
# Port Allocation Strategy (for multiple worktrees)
# ============================================================================
# Each worktree gets a 100-port block based on branch name hash:
#
# Branch: main/master
#   Offset: 0
#   Redis: 6379, Postgres: 5432, Orchestrator: 3001, etc.
#
# Branch: feature-auth
#   Offset: ~42 (example hash result)
#   Redis: 6421 (6379+42), Postgres: 5474 (5432+42), etc.
#
# Branch: bugfix-validation
#   Offset: ~78 (example hash result)
#   Redis: 6457 (6379+78), Postgres: 5510 (5432+78), etc.
#
# This ensures different worktrees never conflict on ports.

# =============================================================================
# API KEYS & TOKENS (Z.ai, Kimi, OpenRouter, etc)
# =============================================================================

# Z.ai Configuration (Cost-optimized worker provider)
ZAI_API_KEY=CHANGE_ME_YOUR_ZAI_API_KEY
Z_AI_API_KEY=CHANGE_ME_YOUR_ZAI_API_KEY
Z_AI_BASE_URL=https://api.z.ai/v1

# Alternative AI Providers (optional)
KIMI_API_KEY=CHANGE_ME_YOUR_KIMI_API_KEY
OPENROUTER_API_KEY=CHANGE_ME_YOUR_OPENROUTER_API_KEY
XAI_API_KEY=CHANGE_ME_YOUR_XAI_API_KEY

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Server Configuration
PORT=3000
HOST=0.0.0.0
CORS_ORIGINS=https://your-production-domain.com,https://www.your-production-domain.com

# Logging
LOG_LEVEL=info
ENABLE_REQUEST_LOGGING=true
LOG_FILE_PATH=./logs/server.log

# Features
ENABLE_SECURITY_HEADERS=true
ENABLE_RATE_LIMIT=true
ENABLE_COMPRESSION=true
ENABLE_CACHING=true

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# DOCKER CONFIGURATION
# =============================================================================

DOCKER_INTERNAL_REDIS=redis:6379
DOCKER_INTERNAL_DB=postgres:5432
CFN_NETWORK_NAME=cfn-network
CFN_MODE=production

# Which compose file to use (can be overridden by -f flag)
COMPOSE_FILE=docker-compose.yml

# For production:
# COMPOSE_FILE=docker-compose.production.yml

# =============================================================================
# MONITORING & OBSERVABILITY (Optional)
# =============================================================================

ENABLE_MONITORING=false
MONITORING_URL=

# Datadog (optional)
DATADOG_API_KEY=

# New Relic (optional)
NEW_RELIC_LICENSE_KEY=

# =============================================================================
# BUILD & DEPLOYMENT METADATA
# =============================================================================

APP_VERSION=4.0.0
BUILD_DATE=
VCS_REF=
DEPLOYMENT_REGION=us-west-2

# Resource limits
MAX_AGENTS=10
AGENT_TIMEOUT=300000
MEMORY_LIMIT=1g
CPU_LIMIT=0.5
WORKER_POOL_SIZE=5
AGENT_REPLICAS=3

# ============================================================================
# Example Usage Scenarios
# ============================================================================
#
# Scenario 1: Single worktree (traditional)
# ------------------------------------------
# docker-compose up -d
# (Uses default ports from CFN_* variables above)
#
# Scenario 2: Multiple worktrees (isolated)
# ------------------------------------------
# # In worktree 1 (main branch):
# ./scripts/docker/run-in-worktree.sh up -d
# # Ports: Redis=6379, Postgres=5432, etc.
#
# # In worktree 2 (feature-auth branch):
# ./scripts/docker/run-in-worktree.sh up -d
# # Ports: Redis=6421, Postgres=5474, etc. (auto-calculated offset)
#
# # In worktree 3 (bugfix-validation branch):
# ./scripts/docker/run-in-worktree.sh up -d
# # Ports: Redis=6457, Postgres=5510, etc. (auto-calculated offset)
#
# All three run simultaneously without conflicts!
#
# Scenario 3: Custom port offset
# -------------------------------
# CFN_WORKTREE_PORT_OFFSET=20 ./scripts/docker/run-in-worktree.sh up -d
# # Forces specific offset regardless of branch
#
# Scenario 4: Custom project name
# --------------------------------
# CFN_WORKTREE_PROJECT_NAME=my-test ./scripts/docker/run-in-worktree.sh up -d
# # Uses custom project name instead of branch-based name

# =============================================================================
# SECURITY BEST PRACTICES
# =============================================================================
#
# 1. PASSWORD GENERATION (Do this for each credential):
#    openssl rand -base64 32
#
# 2. ROTATION SCHEDULE:
#    - API Keys: Every 90 days
#    - Database passwords: Every 6 months
#    - JWT/Session secrets: Every 12 months
#
# 3. STORAGE:
#    - Store in secure vault (AWS Secrets Manager, HashiCorp Vault, etc)
#    - Never hardcode secrets in source code
#    - Use .env files locally, environment variables in production
#
# 4. AUDIT:
#    - Enable credential audit logging
#    - Monitor for unauthorized access attempts
#    - Use git-secrets pre-commit hook
#
# 5. DEPLOYMENT:
#    - Use CI/CD secrets management (GitHub Secrets, GitLab CI/CD Variables)
#    - Deploy with minimal permissions (least privilege principle)
#    - Implement network segmentation for sensitive services
#
# See: docs/CREDENTIAL_MANAGEMENT.md for complete guide
