# Claude Flow Novice - Environment Configuration

# ============================================================================
# Core Configuration
# ============================================================================

# Anthropic API Key (required for agent execution)
ANTHROPIC_API_KEY=your_api_key_here

# Custom Provider Routing (Z.ai, Kimi, OpenRouter, Anthropic)
CFN_CUSTOM_ROUTING=false

# Skills Database (Phase 5: Skills Database Integration)
# Enable database-driven skill loading for agents
CFN_SKILLS_DATABASE=false
CFN_SKILLS_DB_PATH=./.claude/skills-database/skills.db

# ============================================================================
# Redis Configuration (CFN Loop Coordination)
# ============================================================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================================================
# Database Configuration
# ============================================================================

# PostgreSQL (Phase 4 Workflow Codification)
CFN_DB_HOST=localhost
CFN_DB_PORT=5432
CFN_DB_NAME=cfn_workflow
CFN_DB_USER=cfn_user
CFN_DB_PASSWORD=

# ============================================================================
# Docker Configuration
# ============================================================================

DOCKER_AGENT=false
WORKSPACE_ROOT=/workspace

# ============================================================================
# Feature Flags
# ============================================================================

# ACE System (Adaptive Context Extraction)
CFN_ACE_ENABLED=false

# Cost Savings Mode (CLI vs Task spawning)
CFN_COST_SAVINGS=false

# Agent Lifecycle Tracking
CFN_LIFECYCLE_TRACKING=false

# ============================================================================
# Performance & Monitoring
# ============================================================================

# Skill Loading Performance
SKILL_CACHE_MAX_SIZE=100
SKILL_CACHE_TTL=60000

# Agent Spawn Timeout (ms)
AGENT_SPAWN_TIMEOUT=300000

# ============================================================================
# Development & Debugging
# ============================================================================

NODE_ENV=development
DEBUG=false
LOG_LEVEL=info
