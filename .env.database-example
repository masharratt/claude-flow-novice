# Database Authentication Configuration
#
# IMPORTANT: Generate strong passwords using the password generator utility
# Example: node -e "const {generatePassword} = require('./src/lib/password-generator'); console.log(generatePassword());"
#
# SECURITY REQUIREMENTS:
# - Minimum 32 characters
# - Mix of uppercase, lowercase, digits, and special characters
# - No environment variable special characters ($ ` " ')
#
# Copy this file to .env and update with actual secure passwords

# Redis Authentication
# Used for agent coordination and caching
# Pattern: redis://:password@localhost:6379
REDIS_PASSWORD=YourGeneratedRedisPasswordHere32CharsMin

# PostgreSQL Authentication
# Used for task history, metrics, and state persistence
# Pattern: postgresql://cfn_user:password@localhost:5432/cfn_loop
# Minimum length: 32 characters
POSTGRES_PASSWORD=YourGeneratedPostgresPasswordHere32Chars

# Optional: Complete connection strings (if not using individual components)
# REDIS_CONNECTION_STRING=redis://:password@redis:6379
# POSTGRES_CONNECTION_STRING=postgresql://cfn_user:password@postgres:5432/cfn_loop
