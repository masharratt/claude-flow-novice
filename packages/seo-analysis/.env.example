# Firecrawl API Configuration
# Sign up at https://www.firecrawl.dev to get your API key
FIRECRAWL_API_KEY=[REDACTED]

# Optional: Firecrawl API endpoint (defaults to production)
FIRECRAWL_API_URL=https://api.firecrawl.dev

# SEO Analysis Configuration
# Maximum URLs to crawl per domain (rate limit consideration)
MAX_URLS_PER_DOMAIN=100

# Request timeout in milliseconds
REQUEST_TIMEOUT=30000

# Retry configuration
MAX_RETRIES=3
RETRY_DELAY_MS=1000

# Optional: Proxy configuration
HTTP_PROXY=
HTTPS_PROXY=

# Optional: Custom headers for requests
CUSTOM_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# Logging
LOG_LEVEL=info
