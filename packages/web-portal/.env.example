# Claude Flow Novice - Web Portal Environment Configuration
# Copy this file to .env and .env.production and fill in your values

# =============================================================================
# NODE ENVIRONMENT
# =============================================================================
NODE_ENV=development

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
# Port for Express server
PORT=3000

# Host binding (0.0.0.0 for Docker, localhost for local dev)
HOST=localhost

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3001,http://localhost:3000

# =============================================================================
# VITE CLIENT CONFIGURATION
# =============================================================================
# Client port for Vite dev server
VITE_PORT=3001

# API base URL for client
VITE_API_URL=http://localhost:3000/api

# WebSocket URL for client
VITE_WS_URL=ws://localhost:3000

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================
# Secret for JWT token signing (MUST change in production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# JWT token expiration (e.g., 1h, 24h, 7d)
JWT_EXPIRES_IN=24h

# Session secret (MUST change in production)
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# Bcrypt salt rounds (10-12 recommended for production)
BCRYPT_ROUNDS=10

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
# Redis connection URL
REDIS_URL=redis://localhost:6379

# Redis password (if authentication enabled)
REDIS_PASSWORD=

# Redis database number (0-15)
REDIS_DB=0

# Redis key prefix for namespacing
REDIS_PREFIX=cfn:

# =============================================================================
# CLAUDE API CONFIGURATION
# =============================================================================
# Anthropic Claude API key
ANTHROPIC_API_KEY=

# Alternative Claude API key
CLAUDE_API_KEY=

# Claude model to use
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# =============================================================================
# Z.AI API CONFIGURATION
# =============================================================================
# Z.ai API key for agent orchestration
ZAI_API_KEY=

# Alternative Z.ai key
Z_AI_API_KEY=

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# SQLite database path for memory and state
SQLITE_DB_PATH=./data/memory.db

# Enable SQLite WAL mode for better concurrency
SQLITE_WAL_ENABLED=true

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Enable request logging
ENABLE_REQUEST_LOGGING=true

# Log file path (optional, logs to console if not set)
LOG_FILE_PATH=./logs/server.log

# =============================================================================
# RATE LIMITING
# =============================================================================
# Enable rate limiting
ENABLE_RATE_LIMIT=true

# Rate limit window in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW=900000

# Maximum requests per window
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# SECURITY HEADERS (Helmet.js)
# =============================================================================
# Enable security headers
ENABLE_SECURITY_HEADERS=true

# Content Security Policy directives (JSON string)
CSP_DIRECTIVES=

# =============================================================================
# PERFORMANCE CONFIGURATION
# =============================================================================
# Enable compression middleware
ENABLE_COMPRESSION=true

# Enable response caching
ENABLE_CACHING=true

# Cache TTL in seconds
CACHE_TTL=3600

# =============================================================================
# MONITORING & OBSERVABILITY
# =============================================================================
# Enable application monitoring
ENABLE_MONITORING=false

# Monitoring service URL
MONITORING_URL=

# Metrics export interval (ms)
METRICS_INTERVAL=60000

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Enable SDK integration
ENABLE_SDK_INTEGRATION=true

# SDK integration mode (parallel, full)
SDK_INTEGRATION_MODE=parallel

# Enable SDK caching for cost reduction
ENABLE_SDK_CACHING=true

# Enable context editing for token reduction
ENABLE_CONTEXT_EDITING=true

# Enable self-validation
ENABLE_SELF_VALIDATION=true

# =============================================================================
# SDK CONFIGURATION
# =============================================================================
# SDK confidence threshold (0.0-1.0)
SDK_CONFIDENCE_THRESHOLD=0.75

# SDK maximum retries
SDK_MAX_RETRIES=3

# SDK minimum coverage percentage
SDK_MINIMUM_COVERAGE=80

# Enable SDK debug logging
SDK_DEBUG=false

# SDK log level (debug, info, warn, error)
SDK_LOG_LEVEL=info

# Enable SDK performance monitoring
ENABLE_SDK_MONITORING=true

# =============================================================================
# DOCKER CONFIGURATION (Production)
# =============================================================================
# Docker internal networking
# DOCKER_INTERNAL_REDIS=redis:6379
# DOCKER_INTERNAL_DB=postgres:5432

# Health check endpoint path
HEALTH_CHECK_PATH=/health

# =============================================================================
# NPM CONFIGURATION (For publishing/CI)
# =============================================================================
# NPM API key for package publishing
# NPM_API_KEY=

# =============================================================================
# BUILD CONFIGURATION
# =============================================================================
# Build date (auto-populated in CI/CD)
# BUILD_DATE=

# VCS reference (git commit SHA, auto-populated in CI/CD)
# VCS_REF=

# Application version
APP_VERSION=3.0.0
