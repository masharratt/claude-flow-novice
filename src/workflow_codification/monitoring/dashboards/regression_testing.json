{
  "dashboard": {
    "title": "Regression Testing Metrics",
    "description": "Regression test execution and quality metrics",
    "tags": [
      "workflow-codification",
      "regression-testing"
    ],
    "timezone": "browser",
    "panels": [
      {
        "title": "Pass Rate by Skill",
        "type": "graph",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "workflow_codification_regression_test_pass_rate"
          }
        ]
      },
      {
        "title": "Test Execution Count (24h)",
        "type": "stat",
        "gridPos": {
          "x": 12,
          "y": 0,
          "w": 4,
          "h": 8
        },
        "targets": [
          {
            "expr": "sum(increase(workflow_codification_regression_tests_total[24h]))"
          }
        ]
      },
      {
        "title": "Tests Generated (24h)",
        "type": "stat",
        "gridPos": {
          "x": 16,
          "y": 0,
          "w": 4,
          "h": 8
        },
        "targets": [
          {
            "expr": "sum(increase(workflow_codification_regression_tests_generated_total[24h]))"
          }
        ]
      },
      {
        "title": "Execution Duration Distribution",
        "type": "graph",
        "gridPos": {
          "x": 0,
          "y": 8,
          "w": 10,
          "h": 8
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, workflow_codification_regression_test_duration_seconds)"
          }
        ]
      },
      {
        "title": "Pass/Fail Ratio",
        "type": "piechart",
        "gridPos": {
          "x": 10,
          "y": 8,
          "w": 10,
          "h": 8
        },
        "targets": [
          {
            "expr": "sum by (result) (workflow_codification_regression_tests_total)"
          }
        ]
      }
    ],
    "refresh": "15s",
    "version": 1
  }
}
