{
  "dashboard": {
    "title": "Skill Composition Tracking",
    "description": "Composite skill execution and workflow metrics",
    "tags": [
      "workflow-codification",
      "skill-composition"
    ],
    "timezone": "browser",
    "panels": [
      {
        "title": "Composite Execution Status",
        "type": "graph",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "sum by (status) (rate(workflow_codification_composite_executions_total[5m]))"
          }
        ]
      },
      {
        "title": "Error Rate",
        "type": "gauge",
        "gridPos": {
          "x": 12,
          "y": 0,
          "w": 8,
          "h": 8
        },
        "targets": [
          {
            "expr": "sum(rate(workflow_codification_composite_executions_total{status=\"failed\"}[5m])) / sum(rate(workflow_codification_composite_executions_total[5m]))"
          }
        ]
      },
      {
        "title": "Execution Duration by Mode",
        "type": "graph",
        "gridPos": {
          "x": 0,
          "y": 8,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, workflow_codification_composite_execution_duration_seconds)"
          }
        ]
      },
      {
        "title": "Composite Skills Created (24h)",
        "type": "stat",
        "gridPos": {
          "x": 12,
          "y": 8,
          "w": 4,
          "h": 8
        },
        "targets": [
          {
            "expr": "increase(workflow_codification_composite_skills_created_total[24h])"
          }
        ]
      },
      {
        "title": "Total Executions (24h)",
        "type": "stat",
        "gridPos": {
          "x": 16,
          "y": 8,
          "w": 4,
          "h": 8
        },
        "targets": [
          {
            "expr": "sum(increase(workflow_codification_composite_executions_total[24h]))"
          }
        ]
      }
    ],
    "refresh": "15s",
    "version": 1
  }
}
