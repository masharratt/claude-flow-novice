{
  "dashboard": {
    "title": "Pattern Recommender Analytics",
    "description": "Pattern recommendation generation and acceptance metrics",
    "tags": [
      "workflow-codification",
      "pattern-recommender"
    ],
    "timezone": "browser",
    "panels": [
      {
        "title": "Recommendations by Strength Level",
        "type": "graph",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "sum by (strength_level) (rate(workflow_codification_pattern_recommendations_total[5m]))"
          }
        ]
      },
      {
        "title": "Acceptance Rate by Strength",
        "type": "gauge",
        "gridPos": {
          "x": 12,
          "y": 0,
          "w": 8,
          "h": 8
        },
        "targets": [
          {
            "expr": "workflow_codification_pattern_recommendation_acceptance_rate"
          }
        ]
      },
      {
        "title": "Total Recommendations (24h)",
        "type": "stat",
        "gridPos": {
          "x": 0,
          "y": 8,
          "w": 5,
          "h": 8
        },
        "targets": [
          {
            "expr": "sum(increase(workflow_codification_pattern_recommendations_total[24h]))"
          }
        ]
      },
      {
        "title": "Deployed Recommendations (24h)",
        "type": "stat",
        "gridPos": {
          "x": 5,
          "y": 8,
          "w": 5,
          "h": 8
        },
        "targets": [
          {
            "expr": "sum(increase(workflow_codification_pattern_recommendations_deployed_total[24h]))"
          }
        ]
      },
      {
        "title": "Average Projected Savings (USD)",
        "type": "stat",
        "gridPos": {
          "x": 10,
          "y": 8,
          "w": 5,
          "h": 8
        },
        "targets": [
          {
            "expr": "avg(workflow_codification_pattern_recommendations_savings_usd)"
          }
        ]
      },
      {
        "title": "Total Projected Savings (USD)",
        "type": "stat",
        "gridPos": {
          "x": 15,
          "y": 8,
          "w": 5,
          "h": 8
        },
        "targets": [
          {
            "expr": "sum(workflow_codification_pattern_recommendations_savings_usd)"
          }
        ]
      }
    ],
    "refresh": "15s",
    "version": 1
  }
}
