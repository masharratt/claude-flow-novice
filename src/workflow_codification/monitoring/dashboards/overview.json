{
  "dashboard": {
    "title": "Workflow Codification Overview",
    "description": "System-wide monitoring for Workflow Codification Enhancement v2",
    "tags": [
      "workflow-codification",
      "overview"
    ],
    "timezone": "browser",
    "panels": [
      {
        "title": "Average Health Score",
        "type": "graph",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 8,
          "h": 8
        },
        "targets": [
          {
            "expr": "avg(workflow_codification_health_score) by (health_level)"
          }
        ]
      },
      {
        "title": "Circuit Breaker States",
        "type": "stat",
        "gridPos": {
          "x": 8,
          "y": 0,
          "w": 4,
          "h": 8
        },
        "targets": [
          {
            "expr": "sum(workflow_codification_circuit_breaker_state == 2)"
          }
        ]
      },
      {
        "title": "Regression Test Pass Rate",
        "type": "gauge",
        "gridPos": {
          "x": 12,
          "y": 0,
          "w": 4,
          "h": 8
        },
        "targets": [
          {
            "expr": "avg(workflow_codification_regression_test_pass_rate)"
          }
        ]
      },
      {
        "title": "Pattern Recommendations (24h)",
        "type": "stat",
        "gridPos": {
          "x": 16,
          "y": 0,
          "w": 4,
          "h": 8
        },
        "targets": [
          {
            "expr": "sum(increase(workflow_codification_pattern_recommendations_total[24h]))"
          }
        ]
      },
      {
        "title": "Composite Execution Duration (P95)",
        "type": "graph",
        "gridPos": {
          "x": 0,
          "y": 8,
          "w": 10,
          "h": 8
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, workflow_codification_composite_execution_duration_seconds)"
          }
        ]
      },
      {
        "title": "Traces Created (Rate)",
        "type": "graph",
        "gridPos": {
          "x": 10,
          "y": 8,
          "w": 10,
          "h": 8
        },
        "targets": [
          {
            "expr": "rate(workflow_codification_traces_created_total[5m])"
          }
        ]
      }
    ],
    "refresh": "15s",
    "version": 1
  }
}
