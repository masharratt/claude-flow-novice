# Hybrid AI Infrastructure Environment Variables
# Version: 2.0.0 - Production Ready
#
# SECURITY: This is a TEMPLATE file. DO NOT commit real secrets.
# - Copy this file to .env
# - Generate strong passwords using: openssl rand -base64 32
# - NEVER share or commit your .env file
# - Use git-secrets or pre-commit hooks to prevent accidental commits

# ============================================================
# REQUIRED: API Keys (No Defaults - Must Set Before Deploy)
# ============================================================

# Anthropic Claude Max API (Coordinators)
# Generate at: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=sk-ant-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# PostgreSQL Database
# CRITICAL: Generate a strong password using: openssl rand -base64 32
POSTGRES_USER=cfn_app_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_RANDOM_PASSWORD_32_CHARS_MIN

# Grafana Dashboard
# CRITICAL: Generate a strong password using: openssl rand -base64 32
GRAFANA_PASSWORD=CHANGE_ME_STRONG_RANDOM_PASSWORD_32_CHARS_MIN
GRAFANA_USER=admin

# ============================================================
# OPTIONAL: Z.ai Worker Configuration
# ============================================================

# Z.ai API Configuration (Workers use this for cost optimization)
Z_AI_API_TOKEN=your_z_ai_api_token_here
Z_AI_BASE_URL=https://api.z.ai/v1

# ============================================================
# Container Configuration
# ============================================================

# Coordinator Image (Override for custom builds)
COORDINATOR_IMAGE=claude-max:latest

# Environment Mode
NODE_ENV=production
LOG_LEVEL=info

# Deployment Region
DEPLOYMENT_REGION=us-west-2
ENV_MODE=hybrid

# ============================================================
# Monitoring & Observability (Optional)
# ============================================================

# Grafana
GRAFANA_URL=http://localhost:3000

# External Monitoring Services (Optional)
DATADOG_API_KEY=optional_datadog_api_key
NEW_RELIC_LICENSE_KEY=optional_new_relic_license_key

# ============================================================
# Redis Configuration (Optional - Uses Defaults)
# ============================================================

# Redis connection (uses service discovery by default)
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD=optional_secure_redis_password

# ============================================================
# Resource Limits (Override Defaults if Needed)
# ============================================================

# Coordinator Resources (per container)
# CPU_LIMIT=2.0
# MEMORY_LIMIT=4G

# Infrastructure Resources
# REDIS_MEMORY_LIMIT=512M
# POSTGRES_MEMORY_LIMIT=1G
# ============================================================
# BACKUP ENCRYPTION (CVSS 7.2 Mitigation - High Priority)
# ============================================================

# Enable encryption for all backup operations
BACKUP_ENCRYPTION_ENABLED=true

# Master encryption key (32-byte hex)
# IMPORTANT: Keep this secret and secure - never commit to repository
# Generate with: openssl rand -hex 32
# Storage: Use AWS Secrets Manager, HashiCorp Vault, or similar
# Default length: 64 hexadecimal characters (32 bytes)
# Example: a3f7b2c9e1d4f6a8b3c5d7e9f1a3b5c7d9e1f3a5b7c9d1e3f5a7b9c1d3e5
BACKUP_ENCRYPTION_KEY=your_32_byte_hex_key_here_64_chars_total

# Key version for rotation tracking (optional)
# Use this to implement key rotation without downtime
# Increment when rotating: v1 → v2 → v3
# Default: v1
# BACKUP_ENCRYPTION_KEY_VERSION=v1

# ============================================================
# BACKUP ENCRYPTION SECURITY NOTES
# ============================================================
# Algorithm: AES-256-GCM with HMAC-SHA256 integrity
# - Unique IV per backup (prevents pattern attacks)
# - GCM authentication tag (prevents tampering)
# - Key stored securely in Secrets Manager (NOT in .env)
# - Supports key rotation without backup downtime
# - Backward compatible with unencrypted backups
# - See: docs/BACKUP_ENCRYPTION.md for detailed guide
