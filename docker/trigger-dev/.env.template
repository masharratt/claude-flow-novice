# trigger.dev Self-Hosted Infrastructure Configuration

# ============================================================================
# Node Environment
# ============================================================================
# Set to 'development' for local development, 'production' for deployment
NODE_ENV=development

# ============================================================================
# PostgreSQL Database Configuration
# ============================================================================
# Database credentials for PostgreSQL 15 container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=trigger
POSTGRES_PORT=5432

# ============================================================================
# Redis Configuration
# ============================================================================
# Redis service address (service name for Docker networking)
REDIS_PORT=6379

# ============================================================================
# MinIO Object Storage Configuration
# ============================================================================
# MinIO credentials for object storage (equivalent to S3)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your_secure_minio_password_here
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ============================================================================
# ClickHouse Analytics Configuration
# ============================================================================
# ClickHouse database for time-series event data and analytics
CLICKHOUSE_DB=trigger
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your_secure_clickhouse_password_here
CLICKHOUSE_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# ============================================================================
# Trigger.dev Application Configuration
# ============================================================================

# Secret key for signing and encryption operations
# Generate with: openssl rand -base64 32
TRIGGER_SECRET_KEY=your_secure_trigger_secret_key_here

# Authentication secret for secure session management
# Generate with: openssl rand -base64 32
AUTH_SECRET=your_secure_auth_secret_here

# Encryption key for sensitive data at rest
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=your_secure_encryption_key_here

# Magic link authentication secret for passwordless login
# Generate with: openssl rand -base64 32
MAGIC_LINK_SECRET=your_secure_magic_link_secret_here

# JWT secret for API token signing
# Generate with: openssl rand -base64 32
JWT_SECRET=your_secure_jwt_secret_here

# ============================================================================
# Domain Configuration
# ============================================================================
# API domain (where API requests are sent)
API_DOMAIN=http://localhost:3000

# App domain (where users access the web interface)
APP_DOMAIN=http://localhost:3040

# ============================================================================
# Port Configuration
# ============================================================================
# Web application port (exposed as WEBAPP_PORT:3000 in docker-compose)
WEBAPP_PORT=3040

# ============================================================================
# Worker Configuration
# ============================================================================
# Unique identifier for this worker instance (use for multiple workers)
WORKER_ID=trigger-worker-1

# ============================================================================
# Secret Generation Instructions
# ============================================================================
# Run these commands to generate secure secrets:
#
# Linux/macOS:
#   openssl rand -base64 32
#
# Or use Python:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Or use Node.js:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
