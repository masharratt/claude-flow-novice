{
  "retention_policy": {
    "version": "1.0.0",
    "created_at": "2025-11-28T00:00:00Z",
    "policy_name": "RuVector Standard Retention",
    "description": "7-day retention policy with daily rotation strategy"
  },
  "retention": {
    "daily_backups": {
      "keep_days": 7,
      "description": "Keep 7 days of daily backups"
    },
    "rotation_strategy": "daily",
    "auto_cleanup": true,
    "cleanup_on_backup": true
  },
  "rules": [
    {
      "id": "rule_daily_rotation",
      "name": "Daily Rotation",
      "description": "Rotate daily backups, keeping last 7 days",
      "pattern": "ruvector.db.backup-*",
      "older_than_days": 7,
      "action": "delete"
    },
    {
      "id": "rule_pre_migration_cleanup",
      "name": "Pre-Migration Backup Cleanup",
      "description": "Clean up pre-migration backups after 30 days",
      "pattern": "ruvector.db.pre-migration-*",
      "older_than_days": 30,
      "action": "delete"
    }
  ],
  "schedule": {
    "backup_frequency": "daily",
    "backup_time": "00:00",
    "timezone": "UTC",
    "description": "Daily automated backup at midnight UTC"
  },
  "verification": {
    "enabled": true,
    "checksum_validation": true,
    "size_validation": true,
    "description": "Verify backup integrity with checksums and size validation"
  },
  "storage": {
    "backup_directory": "docker/trigger-dev/data/backups",
    "migration_directory": "docker/trigger-dev/data/migration",
    "log_directory": "docker/trigger-dev/data/backups",
    "max_concurrent_backups": 1
  },
  "docker_isolation": {
    "enabled": true,
    "compose_project_aware": true,
    "description": "Each Docker compose project maintains isolated backups using COMPOSE_PROJECT_NAME"
  },
  "metadata": {
    "tracking": true,
    "metadata_suffix": ".metadata",
    "fields": [
      "backup_timestamp",
      "source_db",
      "checksum",
      "file_size",
      "retention_days",
      "compose_project"
    ]
  }
}
