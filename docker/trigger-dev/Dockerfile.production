# Production-Hardened RuVector Docker Image
#
# This Dockerfile creates a secure, optimized RuVector image for production deployment.
#
# Security Features:
#   - Alpine Linux base (minimal attack surface)
#   - Non-root user execution (no privilege escalation)
#   - Multi-stage build (reduced image size)
#   - Read-only filesystem support
#   - Health checks enabled
#   - Security scanning pass required
#
# Performance Features:
#   - Layer caching optimized
#   - Minimal dependencies included
#   - Node.js slim variant
#   - Efficient startup
#   - Resource limits respected
#
# Build Requirements:
#   - Must build from Linux native storage (not Windows mount)
#   - Use: ./.claude/skills/docker-build/build.sh
#   - Do NOT use: docker build on Windows paths (755s overhead)
#
# Usage:
#   docker build -f docker/trigger-dev/Dockerfile.production \
#     -t ruvector:prod --build-arg NODE_ENV=production .
#
#   docker run -d \
#     --name ruvector-prod \
#     --user ruvector:ruvector \
#     --read-only \
#     --tmpfs /tmp \
#     --tmpfs /app/data \
#     -e NODE_ENV=production \
#     -v ruvector-data:/app/data \
#     -p 3000:3000 \
#     ruvector:prod

# Stage 1: Build dependencies
FROM node:20-alpine AS builder

WORKDIR /build

# Install build dependencies only (removed at end of stage)
RUN apk add --no-cache \
    python3 \
    make \
    g++ \
    ca-certificates

# Copy package files
COPY package*.json ./

# Install dependencies with security audit
RUN npm ci --omit=dev && \
    npm audit --production --audit-level=moderate && \
    npm cache clean --force

# Stage 2: Production runtime
FROM node:20-alpine

# Security: Set container user
ARG RUVECTOR_UID=1000
ARG RUVECTOR_GID=1000

RUN addgroup -g ${RUVECTOR_GID} -S ruvector && \
    adduser -u ${RUVECTOR_UID} -S ruvector -G ruvector

WORKDIR /app

# Copy build artifacts from builder stage
COPY --from=builder --chown=ruvector:ruvector /build/node_modules ./node_modules
COPY --from=builder --chown=ruvector:ruvector /build/package*.json ./

# Copy application source
COPY --chown=ruvector:ruvector . .

# Create data directories with restrictive permissions
RUN mkdir -p /app/data/backups /app/data/migration && \
    chmod -R 750 /app/data && \
    chmod -R 755 /app/data/backups

# Set environment variables
ENV NODE_ENV=production
ENV PORT=3000
ENV LOG_LEVEL=info
ENV RUVECTOR_DB_PATH=/app/data/ruvector.db

# Security: Install dumb-init for proper signal handling
RUN apk add --no-cache dumb-init

# Health check configuration
# Checks if RuVector is responding on health endpoint
# Interval: 30 seconds, Timeout: 10 seconds, Start: 15 seconds, Retries: 3
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD node -e "require('http').get('http://localhost:3000/health', (r) => {if (r.statusCode !== 200) throw new Error(r.statusCode)})" || exit 1

# Data persistence volume
# Mount at runtime for data durability across restarts
VOLUME ["/app/data"]

# Expose application port
EXPOSE 3000

# Security: Switch to non-root user
USER ruvector:ruvector

# Use dumb-init to handle signals properly
# Prevents zombie processes and ensures graceful shutdown
ENTRYPOINT ["/sbin/dumb-init", "--"]

# Start application
CMD ["npm", "run", "start"]

# Labels for container metadata
LABEL maintainer="DevOps Team"
LABEL version="1.0"
LABEL description="Production-hardened RuVector image with security hardening, health checks, and optimized layers"
LABEL security.scan="required"
LABEL build.storage="linux-native"
