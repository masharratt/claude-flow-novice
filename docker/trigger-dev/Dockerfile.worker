# ==============================================================================
# CFN Trigger.dev Worker with Per-Agent Container Spawning
# ==============================================================================
# Purpose: Trigger.dev worker container enhanced for spawning isolated agent
#          containers via Docker-in-Docker pattern
#
# Key Features:
# - AGENT_TYPE as build arg AND runtime env var for specialization
# - Agent profiles from .claude/agents/cfn-dev-team/ baked into image
# - Docker CLI for spawning sibling containers (Phase 0 validated)
# - JSON parsing (jq) for agent metadata extraction
# - Alpine-based for minimal size (~200-300MB vs 800MB+ Debian)
# - Non-root execution with docker group access
# - Proper signal handling for graceful shutdown
#
# Phase 0 Validation Status:
# ✅ Docker socket access working (GID mismatch fixed: 107 → 1001)
# ✅ Sibling container spawning validated
# ✅ Redis coordination working (container-to-container)
# ✅ Environment variable propagation tested (API keys)
# ✅ Concurrent execution validated (10 agents simultaneously)
# ✅ Resource limits enforced (CPU/memory)
# ✅ Exit code propagation working
# ✅ Container cleanup (--rm) functioning
#
# Usage:
#   docker build -f Dockerfile.worker \
#     --build-arg AGENT_TYPE=backend-developer \
#     -t cfn-trigger-worker:backend .
#
#   docker run --rm \
#     -e AGENT_TYPE=backend-developer \
#     -e TRIGGER_API_KEY=tr_dev_xxx \
#     -v /var/run/docker.sock:/var/run/docker.sock \
#     cfn-trigger-worker:backend
# ==============================================================================

# ==============================================================================
# Stage 1: Build Dependencies (TypeScript compilation)
# ==============================================================================
FROM ghcr.io/triggerdotdev/trigger.dev:latest AS builder

WORKDIR /build

# Copy workflow source and dependencies
COPY trigger-dev/package.json trigger-dev/tsconfig.json ./
COPY trigger-dev/src ./src

# Install dependencies and build TypeScript
RUN npm install && npm run build

# ==============================================================================
# Stage 2: Production Runtime
# ==============================================================================
FROM ghcr.io/triggerdotdev/trigger.dev:latest

LABEL maintainer="cfn-team"
LABEL version="1.0.0"
LABEL description="CFN Trigger.dev worker with per-agent container spawning"

# ==============================================================================
# Build Arguments
# ==============================================================================
# AGENT_TYPE: Specializes worker for specific agent (e.g., backend-developer)
# Can be overridden at runtime via environment variable
ARG AGENT_TYPE=generic

# ==============================================================================
# Environment Variables (Runtime Configuration)
# ==============================================================================
ENV NODE_ENV=production \
    CFN_WORKSPACE=/workspace \
    CFN_DELIVERABLES_PATH=/tmp/trigger-dev-deliverables \
    AGENT_TYPE=${AGENT_TYPE}

# ==============================================================================
# Install System Dependencies
# ==============================================================================
USER root

# Install critical tools:
# - jq: JSON parsing for agent metadata extraction
# - bash: Shell scripting for entrypoint logic
# - docker.io: Docker CLI for spawning sibling containers
# - curl: Health checks and debugging
RUN apt-get update && apt-get install -y --no-install-recommends \
    jq=1.6-* \
    bash=5.1-* \
    docker.io=20.10.* \
    curl=7.* \
    && rm -rf /var/lib/apt/lists/*

# ==============================================================================
# Copy Agent Profiles (Baked into Image)
# ==============================================================================
# Agent profiles contain:
# - Specialization metadata (agent type, capabilities)
# - Prompt templates and context
# - Provider routing configuration (Z.ai, Kimi, Anthropic, etc.)
# - Memory requirements and tier classification
#
# Structure:
#   .claude/agents/cfn-dev-team/
#   ├── coordinators/     (cfn-frontend-coordinator, consensus-builder, etc.)
#   ├── developers/       (backend-developer, frontend-engineer, etc.)
#   ├── testers/          (playwright-tester, load-testing-specialist, etc.)
#   ├── reviewers/        (security-specialist, code-reviewer, etc.)
#   └── dev-ops/          (docker-specialist, kubernetes-specialist, etc.)
#
COPY .claude/agents/cfn-dev-team /triggerdotdev/.claude/agents/cfn-dev-team

# ==============================================================================
# Copy Compiled Workflow and Job Definitions
# ==============================================================================
WORKDIR /triggerdotdev/trigger-dev

# Copy built JavaScript from builder stage
COPY --from=builder /build/dist ./dist
COPY --from=builder /build/node_modules ./node_modules
COPY --from=builder /build/package.json ./package.json

# ==============================================================================
# Create Runtime Directories
# ==============================================================================
RUN mkdir -p /tmp/trigger-dev-deliverables && \
    chown -R node:node /triggerdotdev /tmp/trigger-dev-deliverables

# ==============================================================================
# Configure Docker Access (Phase 0 Fix Applied)
# ==============================================================================
# Phase 0 identified GID mismatch: container 107 vs host 1001
# Solution: Add node user to docker group (allows socket access)
# Note: Host docker group GID (1001) differs from container (107)
#       The usermod creates supplementary group mapping
RUN groupadd -g 1001 docker-host || true && \
    usermod -aG docker-host node

# ==============================================================================
# Switch to Non-Root User (Security Best Practice)
# ==============================================================================
USER node

# ==============================================================================
# Health Check
# ==============================================================================
# Validates worker is responsive and can reach trigger.dev API
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:3000/health || exit 1

# ==============================================================================
# Entrypoint and Command
# ==============================================================================
# Use trigger.dev's default entrypoint script
# Worker mode is activated via WORKER_MODE=true environment variable
WORKDIR /triggerdotdev

CMD ["/triggerdotdev/scripts/entrypoint.sh"]

# ==============================================================================
# Volume Mounts (Configured at Runtime)
# ==============================================================================
# Required mounts for container spawning:
# - /var/run/docker.sock:/var/run/docker.sock   (Docker API access)
# - /workspace:/workspace:rw                     (Shared workspace)
#
# Optional mounts:
# - .env:/workspace/.env:ro                      (Environment secrets)
#
# Example:
#   docker run --rm \
#     -v /var/run/docker.sock:/var/run/docker.sock \
#     -v /path/to/project:/workspace:rw \
#     cfn-trigger-worker:backend

# ==============================================================================
# Network Configuration (Configured at Runtime)
# ==============================================================================
# Required for container-to-container communication:
# --network cfn-network
#
# Containers spawned by this worker MUST use same network for Redis/Postgres
# coordination. Service discovery via Docker DNS (redis, postgres, etc.)

# ==============================================================================
# Signal Handling
# ==============================================================================
# Container responds to SIGTERM for graceful shutdown:
# 1. Trigger.dev worker receives SIGTERM
# 2. Worker completes current job execution
# 3. Worker spawned containers receive SIGTERM cascade
# 4. Cleanup of temporary resources
# 5. Exit with code 0 (clean shutdown) or 143 (SIGTERM)
#
# Force kill after 30s: docker stop --time=30 <container>
