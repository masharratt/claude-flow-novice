# Dockerfile.frontend - React Frontend Engineer Agent
# IMPORTANT: Build from Linux native storage for 96% faster builds (755s -> 20s)
# Use: ./.claude/skills/docker-build/build.sh --dockerfile docker/agents/Dockerfile.frontend --tag cfn-agent-frontend:latest

# Stage 1: Playwright base with browser dependencies
FROM mcr.microsoft.com/playwright:v1.40.1-focal AS playwright-base

# Stage 2: Dependencies
FROM node:20-slim AS deps
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    git \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install frontend toolchain
RUN npm install -g \
    vite@5.0.8 \
    @playwright/test@1.40.1 && \
    npm cache clean --force

# Stage 3: Runtime
FROM node:20-slim

WORKDIR /workspace

# Install runtime dependencies for Playwright
RUN apt-get update && apt-get install -y \
    git \
    ca-certificates \
    curl \
    # Chromium dependencies
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libdbus-1-3 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2 \
    libatspi2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Copy tools from deps stage
COPY --from=deps /usr/local/lib/node_modules /usr/local/lib/node_modules
COPY --from=deps /usr/local/bin /usr/local/bin

# Copy Playwright browsers from playwright-base
COPY --from=playwright-base /ms-playwright /ms-playwright

# Create non-root user
RUN groupadd -g 1000 cfn-agent && \
    useradd -u 1000 -g cfn-agent -s /bin/bash -m cfn-agent

# Install common frontend dependencies
RUN npm install -g \
    @types/node@20.10.5 \
    @types/react@18.2.45 \
    tsx@4.7.0 && \
    npm cache clean --force

# Create common directories
RUN mkdir -p /workspace/.npm-cache /workspace/.vite && \
    chown -R cfn-agent:cfn-agent /workspace /ms-playwright

# Labels for MDAP tier mapping
LABEL cfn.agent.type="react-frontend-engineer" \
      cfn.memory.min="512m" \
      cfn.memory.max="800m" \
      cfn.mdap.tier="2" \
      cfn.description="React frontend engineer agent with Playwright testing" \
      cfn.tools="vite,playwright,chromium,git,npm,react"

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD node --version && npx playwright --version || exit 1

# Switch to non-root user
USER cfn-agent

# Environment variables
ENV NODE_ENV=production \
    PATH="/usr/local/bin:$PATH" \
    WORKSPACE_PATH="/workspace" \
    NPM_CONFIG_CACHE="/workspace/.npm-cache" \
    PLAYWRIGHT_BROWSERS_PATH="/ms-playwright"

# Entrypoint accepts Claude CLI commands
# Example: docker run cfn-agent-frontend claude "Create React component with Playwright tests"
ENTRYPOINT ["/bin/bash", "-c"]
CMD ["echo 'CFN Frontend Agent Ready. Pass Claude CLI commands via docker run.'"]
