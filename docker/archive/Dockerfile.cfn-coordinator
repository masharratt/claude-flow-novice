# Dockerfile.cfn-coordinator
# CFN Docker V3 Coordinator - Invokes coordinator agent which plans and spawns workers

FROM node:18-alpine

# Install system dependencies (including Python for better-sqlite3)
RUN apk add --no-cache \
    bash \
    git \
    jq \
    curl \
    docker-cli \
    redis \
    python3 \
    py3-setuptools \
    make \
    g++

# Create non-root user
RUN addgroup -g 1001 -S cfn && \
    adduser -S cfn -u 1001 -G cfn

# Set working directory
WORKDIR /app

# Copy package files and install dependencies only (coordinator doesn't need full CLI)
COPY package*.json ./
RUN npm ci --only=production --ignore-scripts && npm cache clean --force

# Copy coordinator entrypoint script (external file with LF line endings)
COPY docker/coordinator-entrypoint.sh /app/coordinator-entrypoint.sh
RUN chmod +x /app/coordinator-entrypoint.sh

# Switch to non-root user
USER cfn

# Environment variables
ENV NODE_ENV=production
ENV CFN_DOCKER_CONTAINER=true
ENV CFN_DOCKER_MODE=true
ENV CFN_MODE=coordinator

# Health check
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD pgrep -f coordinator-entrypoint || exit 1

# Use coordinator entrypoint
ENTRYPOINT ["/app/coordinator-entrypoint.sh"]

# Labels
LABEL maintainer="Claude Flow Novice"
LABEL description="CFN Docker V3 Coordinator - Invokes agent with planning phase"
LABEL version="3.0.0"
LABEL architecture="docker-in-docker"
LABEL planning="atomic-task-decomposition"
