# CFN Orchestrator - Docker-Native Coordination
FROM node:18-alpine

# Install system dependencies
RUN apk add --no-cache \
    bash \
    curl \
    jq \
    redis-tools \
    && rm -rf /var/cache/apk

# Create non-root user
RUN addgroup -g 1001 -S cfn && \
    adduser -S cfn -u 1001 -G cfn

# Set working directory
WORKDIR /app

# Copy package files
COPY package*.json ./
RUN npm ci --only=production && npm cache clean --force

# Install CLI globally
RUN npm install -g .

# Copy runtime environment setup script
COPY docker/runtime/cfn-runtime.sh ./docker/runtime/cfn-runtime.sh
RUN chmod +x ./docker/runtime/cfn-runtime.sh

# Create orchestrator entrypoint
RUN cat > /app/orchestrator-entrypoint.sh << 'EOF'
#!/bin/bash

# Source CFN runtime environment setup for standardized configuration
source /app/docker/runtime/cfn-runtime.sh

# Source container mode detection if available
if [ -f /app/container-mode-detection.sh ]; then
    source /app/container-mode-detection.sh
fi

# Set orchestrator-specific Node.js options
export NODE_OPTIONS="--max-old-space-size=8192"
export CFN_MODE=orchestrator
export CFN_DOCKER_CONTAINER=true

# Ensure Redis connectivity
echo "Checking Redis connection to $CFN_REDIS_HOST:$CFN_REDIS_PORT..."
if ! redis-cli -h "$CFN_REDIS_HOST" -p "$CFN_REDIS_PORT" ping > /dev/null 2>&1; then
    echo "Redis connection failed"
    exit 1
fi

echo "Redis connected successfully"

# Execute orchestrator
exec npx claude-flow-novice orchestrator "$@"
EOF

RUN chmod +x /app/orchestrator-entrypoint.sh

# Switch to non-root user
USER cfn

# Environment variables for orchestrator
ENV NODE_ENV=production
ENV CFN_DOCKER_CONTAINER=true
ENV CFN_MODE=orchestrator

# Use orchestrator entrypoint
ENTRYPOINT ["/app/orchestrator-entrypoint.sh"]

# Default command
CMD ["--help"]