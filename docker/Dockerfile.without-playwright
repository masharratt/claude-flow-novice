# Docker Image without Playwright for Backend Agents
# Optimized for API, database, and backend development tasks

FROM node:20-alpine AS base

# Install runtime dependencies (no browser tools)
RUN apk add --no-cache \
    bash \
    redis \
    curl \
    procps \
    postgresql-client \
    mysql-client \
    && rm -rf /var/cache/apk/*

WORKDIR /app

# Copy memory monitoring script
COPY docker/scripts/monitor-wrapper.sh /app/monitor-wrapper.sh
RUN chmod +x /app/monitor-wrapper.sh

# Copy package files
COPY package*.json ./

# Install production dependencies
RUN npm ci --only=production

# Copy application source
COPY . .

# Build TypeScript
RUN npm run build || echo "Build skipped (dist/ already exists)"

# Create non-root user
RUN addgroup -g 1001 -S cfnuser && \
    adduser -S cfnuser -u 1001 -G cfnuser

# Setup directories with permissions
RUN mkdir -p /app/logs /app/metrics /app/workspace && \
    chown -R cfnuser:cfnuser /app && \
    chmod -R 755 /app/.claude && \
    chmod 1777 /tmp

USER cfnuser

# Backend-specific environment variables
ENV NODE_ENV=production \
    ZAI_API_KEY="" \
    ZAI_BASE_URL="https://api.z.ai/api/anthropic" \
    CLAUDE_API_PROVIDER="zai" \
    REDIS_HOST=host.docker.internal \
    REDIS_PORT=6379 \
    MEMORY_MONITORING=true \
    MEMORY_REPORT_INTERVAL=30 \
    MEMORY_ALERT_THRESHOLD=75 \
    MEMORY_LIMIT=1024 \
    DATABASE_URL="" \
    API_BASE_URL=""

# Health check focused on backend tools
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s \
  CMD /app/monitor-wrapper.sh health-check || exit 1

# Default command with memory monitoring
CMD ["/app/monitor-wrapper.sh", "start-agent"]

# Labels
LABEL maintainer="Claude Flow Novice Team" \
      version="1.0.0-backend" \
      description="Docker container for CFN backend agents (no Playwright)" \
      features="database,api,redis,memory-monitoring" \
      memory-limit="1GB" \
      agent-types="backend-developer,database-architect,api-gateway-specialist,devops"